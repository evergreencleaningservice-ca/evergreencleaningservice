{
  "name": "evergreencleaningservice",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "PUBLIC_ANALYTICS=1 astro build && npm run redirects",
    "build:preview": "astro build && npm run redirects && node scripts/noindex.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy:preview": "npm run build:preview && wrangler deploy && node scripts/purge.mjs",
    "deploy": "npm run build && wrangler deploy",
    "redirects": "node --experimental-strip-types scripts/redirects.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "wrangler": "^4.134.0"
  }
}
