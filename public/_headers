# Noindex by HOSTNAME, never by path.
#
# One build is served on every address — staging and production are the same
# Worker and the same files — so the only honest place to decide "is this
# staging?" is the hostname the request arrived on. Each rule below names a
# non-production host outright. There is deliberately no `/*` rule: a path-only
# rule matches every host, and on this Worker that includes the live site.
#
# Production (www. and the apex) is never named here and never matched, so
# attaching or detaching a Custom Domain cannot change what either address
# says to a crawler. tests/build/indexability.test.ts and
# scripts/launch-check.mjs both refuse a noindex rule that is not scoped to one
# of these hosts.
#
# robots.txt stays allow-all on every host. `Disallow: /` would stop the crawl,
# so this header would never be read.

https://stage.evergreencleaningservice.ca/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-cache

# workers.dev and its version-preview URLs (`<version>-<worker>.<account>`).
# Cloudflare's own documented pattern; a placeholder never spans a dot, so this
# cannot match a *.evergreencleaningservice.ca host.
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex, nofollow, noarchive

# Long-lived caching for files whose names change when their content does.
#
# Astro fingerprints everything under /_astro/ (e.g. global.BoPM8NAr.css), so
# a changed file is always a new URL and the old one can be kept forever.
# Without this rule Workers static assets answer `max-age=0, must-revalidate`
# and every repeat visit re-validates every stylesheet and script.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The three self-hosted font files are NOT fingerprinted, so they get a month
# rather than a year: long enough to matter on repeat visits, short enough
# that `npm run fonts:fetch` replacing a file is picked up without a rename.
/fonts/*
  Cache-Control: public, max-age=2592000

# The floating video (src/components/LeadVideo.astro). Not fingerprinted, so a
# month like the fonts; it was max-age=0 and revalidated on every page view.
/video/*
  Cache-Control: public, max-age=2592000

# Security headers on every response, every host (SEO audit H1, 2026-10-29).
# No noindex here, so this does not break the hostname rule at the top.
#
#   HSTS             a year, WITHOUT includeSubDomains or preload: not every
#                    subdomain of this domain has been confirmed HTTPS-only,
#                    and both of those are hard to take back.
#   Frame options    SAMEORIGIN, and frame-ancestors in the CSP for browsers
#                    that read that instead.
#   Permissions      only the powerful features the site never uses. The
#                    ads-measurement features Google Ads relies on are left
#                    alone on purpose.
#   CSP              REPORT-ONLY. It blocks nothing; violations go to
#                    /api/csp-report and the Worker log (src/lib/csp-report.ts).
#                    The allowlist is what the live pages were recorded
#                    loading on 2026-10-29: GTM, Google Ads and DoubleClick,
#                    reCAPTCHA, Cloudflare Insights, the image host, and
#                    Turnstile and GA4 ahead of their use. 'unsafe-inline' and
#                    'unsafe-eval' stay until GTM's custom tags are audited
#                    (H2): the site is static, so there is no nonce to issue.
#                    After two clean weeks, rename the header to enforce it.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=(), serial=(), bluetooth=(), hid=()
  Reporting-Endpoints: csp="/api/csp-report"
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com https://googleads.g.doubleclick.net https://www.googleadservices.com https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://www.gstatic.com; img-src 'self' data: blob: https://img.evergreencleaningservice.ca https://www.google.com https://www.google.ca https://www.gstatic.com https://googleads.g.doubleclick.net https://ad.doubleclick.net https://www.googletagmanager.com https://i.ytimg.com; font-src 'self' https://fonts.gstatic.com; media-src 'self' https://img.evergreencleaningservice.ca; connect-src 'self' https://www.google.com https://www.google.ca https://www.googleadservices.com https://ad.doubleclick.net https://googleads.g.doubleclick.net https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://cloudflareinsights.com https://static.cloudflareinsights.com; frame-src https://www.google.com https://www.googletagmanager.com https://td.doubleclick.net https://www.youtube.com https://www.youtube-nocookie.com https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; report-uri /api/csp-report; report-to csp
