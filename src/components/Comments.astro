---
/**
 * The post comment form, matching the original's field set.
 *
 * None of the archived posts carried an actual comment thread — every one has
 * the area and an empty list — so this is the form only. If threads existed on
 * the live site after the 2023 capture, they are in the client's WordPress
 * database and would need importing.
 *
 * NOW WIRED UP, AND GUARDED. It posted to `action="#"` for the whole port:
 * a visitor typed a comment, the page reloaded, and the comment was gone —
 * silently, on all 38 posts. It now posts to `/api/submit-post`, behind the
 * same honeypot and the same invisible Turnstile check the lead forms use.
 * The captcha and the storage arrived together on purpose: a captcha in front
 * of a form that discards its input protects nothing.
 *
 * NOT A CONVERSION. `SubmissionRuntime` passes `conversion: false`, so a
 * comment never pushes `lead_form_submission`. Someone reading the blog is not
 * a sales enquiry, and counting them as one would corrupt the single number
 * the client's ad spend is judged on.
 *
 * NOT PUBLISHED BY BEING SUBMITTED. Every row lands `pending`, and this site
 * renders no comment threads, so nothing a stranger types can appear on a page
 * before a person has looked at it. The moderation surface is still to be
 * built; the state is in the schema from the first row rather than retrofitted
 * later. See migrations/0005_submissions.sql.
 */
import SpamGuard from './SpamGuard.astro';

interface Props {
  /** The post's public slug, so a comment files against the right article. */
  slug: string;
}

const { slug } = Astro.props;
---

<div id="comments" class="comments-area">
  <div id="respond" class="comment-respond">
    <h3 id="reply-title" class="comment-reply-title">
      Leave a Reply <small
        ><a rel="nofollow" id="cancel-comment-reply-link" href="#respond" style="display:none;"
          >Cancel reply</a
        ></small
      >
    </h3>

  <form
    class="comment-form"
    method="post"
    action="#"
    aria-labelledby="reply-title"
    data-post-kind="comment"
    data-post-slug={slug}
  >
    <p class="comment-notes">
      <span id="email-notes">Your email address will not be published.</span>{' '}
      <span class="required-field-message"
        >Required fields are marked <span class="req" aria-hidden="true">*</span></span
      >
    </p>

    <div class="field">
      <label for="comment">Comment <span class="req" aria-hidden="true">*</span></label>
      <textarea id="comment" name="comment" rows="6" required></textarea>
    </div>

    <div class="row row-2">
      <div class="field">
        <label for="comment-author">Name <span class="req" aria-hidden="true">*</span></label>
        <input type="text" id="comment-author" name="author" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="comment-email">Email <span class="req" aria-hidden="true">*</span></label>
        <input
          type="email"
          id="comment-email"
          name="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          required
        />
      </div>
    </div>

    <div class="field">
      <label for="comment-url">Website</label>
      <input type="url" id="comment-url" name="url" autocomplete="url" spellcheck="false" />
    </div>

    <div class="field field-consent">
      <input type="checkbox" id="comment-cookies" name="wp-comment-cookies-consent" value="yes" />
      <label for="comment-cookies">
        Save my name, email, and website in this browser for the next time I comment.
      </label>
    </div>

    {/* Honeypot. The original comment form had none — WordPress relied on
        Akismet, which does not come with a static build. A real person never
        sees this field, so anything in it is a bot. */}
    <div class="form-hp wpf-hp" aria-hidden="true">
      <label for="comment-hp">Leave this field empty</label>
      <input type="text" id="comment-hp" name="company-website" tabindex="-1" autocomplete="off" />
    </div>

    <SpamGuard />

    {/* A <button>, where the original had <input type="submit">. The shared
        pipeline disables the submit control and shows "Sending…" while the
        request is in flight, and it finds that control as
        `button[type=submit]`. Same classes, same label, same rendering. */}
    <button class="btn btn-primary submit" name="submit" type="submit">Post Comment</button>
  </form>
  </div>
</div>

<style>
  .comments-area {
    margin-top: 40px;
    padding-top: 30px;
    border-top: 1px solid var(--rule);
  }

  .comment-reply-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 0 0 10px;
  }

  .comment-notes,
  .form-note {
    font-size: 14px;
    color: var(--ink);
    margin: 0 0 14px;
  }

  .req {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .field {
    margin-bottom: 14px;
  }

  .field label {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-heading);
    margin-bottom: 4px;
  }

  .row {
    display: grid;
    gap: 0 14px;
  }

  @media (min-width: 560px) {
    .row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  input[type='text'],
  input[type='email'],
  input[type='url'],
  textarea {
    width: 100%;
    max-width: 100%;
    font: inherit;
    font-size: 15px;
    color: inherit;
    background: #fff;
    padding: 9px 11px;
    border: 1px solid #cdd2d7;
    border-radius: var(--radius);
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .field-consent {
    display: flex;
    align-items: flex-start;
    gap: 9px;
  }

  .field-consent input {
    width: auto;
    flex: none;
    margin-top: 3px;
  }

  .field-consent label {
    margin: 0;
    font-weight: 400;
    font-size: 14px;
    color: var(--ink);
  }

  /* The honeypot, hidden the way the other forms hide theirs. Astro scopes
     styles per component, so this rule has to live here — the identical one
     in ContactForm and on /reviews/ does not reach this markup.

     NOT `display: none` and not `hidden`: a bot that reads either skips the
     field, which is the one thing that must not happen. Taken out of the
     layout and out of the accessibility tree instead, so a person never sees
     it and a screen reader never announces it. */
  .wpf-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
