---
/**
 * The site footer, matching the original's two widget columns.
 *
 * The original is a Google review button on the left and the service-area menu
 * on the right, then a single copyright line. Contact details and social links
 * are NOT in the footer — they live in the homepage contact section, which is
 * where the original puts them.
 *
 * The service-area entries are a WordPress nav menu whose items all point at
 * "#", i.e. they are labels rather than links. They are rendered as plain list
 * items here: a link that goes nowhere is worse for a keyboard or screen-reader
 * user than text that never claimed to be one.
 */
import { footerAreas, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer" id="colophon">
  <div class="container footer-widgets">
    <div class="footer-col footer-col-review">
      <a href="https://g.page/r/CW9cqxQ9_IfYEBM/review" rel="noopener noreferrer" target="_blank">
        <img
          src="/images/Google-Review-Link.png"
          alt="Leave Evergreen Office Cleaning a Google review"
          width="247"
          height="122"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>

    <div class="footer-col footer-col-areas">
      <h2 class="screen-reader-text">Service areas</h2>
      <ul class="footer-areas">
        {footerAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </div>

  <div class="site-info">
    <div class="container">
      <p>
        Copyright &copy; {year} {site.name} ~ <a href="/privacy/">Privacy Policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--footer-bg);
    color: var(--footer-ink);
    font-size: 14px;
  }

  .footer-widgets {
    display: grid;
    gap: 30px;
    padding-top: 4.375rem;
    padding-bottom: 2.1875rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .footer-widgets {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .footer-col-review img {
    margin: 0 auto;
    width: 247px;
    height: auto;
    max-width: 100%;
  }

  .footer-areas {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .footer-areas li {
    margin-bottom: 7px;
    line-height: 1.6;
  }

  .site-footer a {
    color: var(--brand-hover);
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer a:focus-visible {
    outline: 2px solid var(--brand-hover);
    outline-offset: 2px;
  }

  .site-info {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 18px 0;
    text-align: center;
  }

  .site-info p {
    margin: 0;
  }
</style>
