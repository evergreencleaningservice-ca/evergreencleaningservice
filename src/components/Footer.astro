---
import { footerAreas, site, social } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <h2 class="footer-heading">Service Areas</h2>
      <ul class="footer-areas">
        {footerAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>

    <div class="footer-col">
      <h2 class="footer-heading">{site.name}</h2>
      <p class="footer-contact">
        <a href={site.phoneHref}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
      <a class="btn btn-primary" href="/request-a-quote/">Request a Quote</a>
    </div>

    <div class="footer-col">
      <h2 class="footer-heading">Follow us on Social Media</h2>
      <ul class="footer-social">
        {
          social.map((item) => (
            <li>
              <a href={item.href} rel="noopener noreferrer" target="_blank">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container">
      <p>
        Copyright &copy; {year} {site.name} ~ <a href="/privacy/">Privacy Policy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--surface-dark);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.9rem;
  }

  .footer-inner {
    display: grid;
    gap: 36px;
    padding: 60px 16px 40px;
  }

  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .footer-heading {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #fff;
    margin: 0 0 16px;
  }

  .footer-areas,
  .footer-social {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-areas li,
  .footer-social li {
    margin-bottom: 7px;
  }

  .site-footer a {
    color: var(--brand-hover);
  }

  .site-footer a:hover {
    color: #fff;
  }

  .footer-contact {
    margin-bottom: 18px;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding: 18px 0;
    text-align: center;
    font-size: 0.82rem;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
