---
import { nav, site } from '../data/site';

const { pathname } = Astro.url;
const isCurrent = (href?: string) =>
  !!href && href !== '/' && pathname.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="site-logo" href="/">
      <img src={site.logo} alt="Evergreen Cleaning Service Toronto logo" width="360" height="100" />
      <span class="screen-reader-text">{site.name}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
      <span class="menu-toggle-bar"></span>
      <span class="screen-reader-text">Menu</span>
    </button>

    <nav class="site-nav" aria-label="Primary">
      <ul class="onepress-menu" id="primary-menu">
        {
          nav.map((item) => (
            <li class={item.children ? 'has-children' : ''}>
              {item.href ? (
                <a
                  href={item.href}
                  aria-current={
                    item.href === '/' ? (pathname === '/' ? 'page' : undefined)
                    : isCurrent(item.href) ? 'page'
                    : undefined
                  }
                >
                  {item.label}
                </a>
              ) : (
                <button type="button" class="submenu-toggle" aria-expanded="false">
                  {item.label}
                </button>
              )}
              {item.children && (
                <ul class="sub-menu">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={isCurrent(child.href) ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    background: #fff;
    z-index: 1000;
    box-shadow: var(--shadow-header);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .site-logo img {
    height: 72px;
    width: auto;
    padding: 8px 0;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    width: 40px;
    height: 40px;
    position: relative;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle-bar,
  .menu-toggle-bar::before,
  .menu-toggle-bar::after {
    position: absolute;
    left: 8px;
    width: 24px;
    height: 2px;
    background: var(--brand);
    content: '';
    transition: transform 0.2s ease;
  }

  .menu-toggle-bar {
    top: 19px;
  }
  .menu-toggle-bar::before {
    top: -7px;
    left: 0;
  }
  .menu-toggle-bar::after {
    top: 7px;
    left: 0;
  }

  .onepress-menu {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .onepress-menu > li {
    position: relative;
  }

  .onepress-menu > li > a,
  .submenu-toggle {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--brand);
    padding: 26px 10px;
    background: none;
    border: 0;
    cursor: pointer;
    line-height: 1.3;
  }

  .onepress-menu > li > a:hover,
  .onepress-menu > li > a[aria-current='page'],
  .submenu-toggle:hover {
    color: var(--brand-hover);
    text-decoration: none;
  }

  .has-children > a::after,
  .submenu-toggle::after {
    content: '';
    display: inline-block;
    margin-left: 6px;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
  }

  .sub-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 250px;
    background: #fff;
    list-style: none;
    margin: 0;
    padding: 6px 0;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.18s ease;
  }

  .has-children:hover > .sub-menu,
  .has-children:focus-within > .sub-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .sub-menu a {
    display: block;
    padding: 9px 18px;
    font-size: 0.85rem;
    color: var(--ink);
  }

  .sub-menu a:hover,
  .sub-menu a[aria-current='page'] {
    color: var(--brand);
    background: var(--surface-alt);
    text-decoration: none;
  }

  @media (max-width: 991px) {
    .menu-toggle {
      display: block;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .site-nav.is-open {
      max-height: 80vh;
      overflow-y: auto;
    }

    .onepress-menu {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 0;
    }

    .onepress-menu > li > a,
    .submenu-toggle {
      padding: 12px 16px;
      width: 100%;
      text-align: left;
    }

    .sub-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      max-height: 0;
      overflow: hidden;
      padding: 0;
      transition: max-height 0.22s ease;
      background: var(--surface-alt);
    }

    .has-children.is-open > .sub-menu {
      max-height: 500px;
      padding: 4px 0;
    }

    .has-children:hover > .sub-menu {
      max-height: 0;
    }

    .has-children.is-open:hover > .sub-menu {
      max-height: 500px;
    }

    .sub-menu a {
      padding-left: 32px;
    }
  }

  @media (min-width: 992px) {
    .site-nav {
      max-height: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.querySelector<HTMLElement>('.site-nav');

  toggle?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  // Mobile: tap a parent item to reveal its submenu instead of navigating.
  document.querySelectorAll<HTMLElement>('.has-children').forEach((li) => {
    const trigger = li.querySelector<HTMLElement>(':scope > a, :scope > .submenu-toggle');
    trigger?.addEventListener('click', (event) => {
      if (window.matchMedia('(min-width: 992px)').matches) return;
      const isOpen = li.classList.contains('is-open');
      if (!isOpen) {
        event.preventDefault();
        li.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
