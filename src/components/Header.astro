---
import { nap, nav, site } from '../data/site';

const { pathname } = Astro.url;
const isCurrent = (href?: string) =>
  !!href && href !== '/' && pathname.startsWith(href);
---

<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a class="site-logo" href="/">
      {/* AVIF then WebP then the original JPEG. It renders at 220px wide,
          so the 440px variants cover a 2x screen and nothing wider is
          emitted — a bigger file is not a sharper logo. `eager`, because it
          is above the fold on every page; `width`/`height` are the source's
          intrinsic ratio so the header does not reflow when it lands. */}
      <picture>
        <source type="image/avif" srcset="/images/cropped-evergreen-cleaning-toronto-logo-banner.avif" />
        <source type="image/webp" srcset="/images/cropped-evergreen-cleaning-toronto-logo-banner.webp" />
        <img
          src={site.logo}
          alt="Evergreen Cleaning Service Toronto logo"
          width="884"
          height="265"
          loading="eager"
          decoding="async"
        />
      </picture>
      <span class="screen-reader-text">{site.name}</span>
    </a>

    {/* Persistent actions. The telephone number used to be a menu item and
        there was no quote action in the header at all; on a phone the number
        was two taps away inside the drawer. Both now sit beside the menu at
        every width. The link keeps the measurement contract: `header` while
        the bar is a bar, `mobile_navigation` while the drawer is open. */}
    <div class="header-actions">
      <a
        class="header-phone"
        href={nap.phoneHref}
        data-call-location="header"
        aria-label={`Call ${nap.phoneDisplay}`}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1z"/></svg>
        <span class="header-phone-number">{nap.phoneDisplay}</span>
        <span class="header-phone-short">Call</span>
      </a>
      <a class="btn btn-primary header-quote" href="/request-a-quote/" data-cta-location="header">Get a quote</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-menu">
        <span class="menu-toggle-bar"></span>
        <span class="screen-reader-text">Menu</span>
      </button>
    </div>

    {/* `data-call-drawer` marks the element whose `is-open` state turns this
        same navigation into the mobile drawer. */}
    <nav class="site-nav" aria-label="Primary" data-call-drawer>
      <ul class="onepress-menu" id="primary-menu">
        {
          nav.map((item) => (
            <li class={item.children ? 'has-children' : ''}>
              {item.href ? (
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  aria-haspopup={item.children ? 'true' : undefined}
                >
                  {item.label}
                </a>
              ) : (
                <button type="button" class="submenu-toggle" aria-expanded="false">
                  {item.label}
                </button>
              )}
              {item.children && (
                <ul class="sub-menu">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.href} aria-current={pathname === child.href ? 'page' : undefined}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
        <li class="drawer-only">
          <a href={nap.phoneHref} data-call-location="mobile_navigation">Call {nap.phoneDisplay}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Rebuilt 2026-10-15 for a three-hub menu plus persistent phone and quote
     actions. The bar is 72px on a desktop and 60px on a phone; the drawer
     takes over below 1200px, where six menu items, the number and the
     button no longer fit on one line beside the logo. */
  .site-header {
    position: sticky;
    top: 0;
    width: 100%;
    background: #fff;
    z-index: 1000;
    box-shadow: var(--shadow-header);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 72px;
  }

  .site-logo {
    flex: none;
    order: 1;
  }

  .site-logo picture,
  .site-logo img {
    display: block;
    height: 60px;
    width: auto;
  }

  .site-nav {
    order: 2;
    margin-left: auto;
  }

  .header-actions {
    order: 3;
    display: flex;
    align-items: center;
    gap: 10px;
    flex: none;
  }

  .header-phone {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink-heading);
    white-space: nowrap;
    padding: 8px 4px;
    min-height: 44px;
  }

  .header-phone svg {
    color: var(--brand);
  }

  .header-phone:hover,
  .header-phone:focus-visible {
    color: var(--brand);
    text-decoration: none;
  }

  .header-phone-short {
    display: none;
  }

  .header-quote {
    margin: 0;
    white-space: nowrap;
    padding: 10px 16px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: 0;
    width: 44px;
    height: 44px;
    position: relative;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle-bar,
  .menu-toggle-bar::before,
  .menu-toggle-bar::after {
    position: absolute;
    right: 10px;
    width: 24px;
    height: 3px;
    background: var(--brand);
    content: '';
    transition: transform 0.2s ease;
  }

  .menu-toggle-bar {
    top: 50%;
    margin-top: -2px;
  }
  .menu-toggle-bar::before {
    top: -8px;
    right: 0;
  }
  .menu-toggle-bar::after {
    top: 8px;
    right: 0;
  }

  .onepress-menu {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .onepress-menu > li {
    position: relative;
  }

  .onepress-menu > li > a,
  .submenu-toggle {
    display: block;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink-heading);
    padding: 0 11px;
    line-height: 72px;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    white-space: nowrap;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .onepress-menu > li > a:hover,
  .onepress-menu > li > a:focus-visible,
  .onepress-menu > li > a[aria-current='page'],
  .submenu-toggle:hover {
    color: var(--brand);
    text-decoration: none;
  }

  .has-children > a::after,
  .submenu-toggle::after {
    content: '';
    display: inline-block;
    margin-left: 5px;
    border: 4px solid transparent;
    border-top-color: currentColor;
    vertical-align: middle;
    transform: translateY(2px);
  }

  .drawer-only {
    display: none;
  }

  .sub-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 260px;
    background: #fff;
    list-style: none;
    margin: 0;
    padding: 6px 0;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12);
    border-top: 3px solid var(--brand);
    display: none;
  }

  .has-children:hover > .sub-menu,
  .has-children:focus-within > .sub-menu {
    display: block;
  }

  .sub-menu a {
    display: block;
    padding: 9px 18px;
    font-size: 0.9rem;
    color: var(--ink-heading);
  }

  .sub-menu a:hover,
  .sub-menu a:focus-visible,
  .sub-menu a[aria-current='page'] {
    color: var(--brand);
    background: var(--surface-alt);
    text-decoration: none;
  }

  @media (max-width: 1199px) {
    .header-inner {
      min-height: 60px;
    }

    .site-logo picture,
    .site-logo img {
      height: 46px;
    }

    .header-actions {
      margin-left: auto;
      order: 2;
    }

    .site-nav {
      order: 3;
    }

    .menu-toggle {
      display: block;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      margin: 0;
      background: #fff;
      box-shadow: 0 10px 20px rgba(0, 0, 0, 0.12);
      display: none;
    }

    .site-nav.is-open {
      display: block;
      max-height: calc(100vh - 60px);
      overflow-y: auto;
    }

    .onepress-menu {
      flex-direction: column;
      align-items: stretch;
      padding: 8px 0;
    }

    .onepress-menu > li > a,
    .submenu-toggle {
      padding: 12px 16px;
      line-height: 1.4;
      width: 100%;
      text-align: left;
      font-size: 14px;
    }

    .drawer-only {
      display: block;
    }

    .sub-menu {
      position: static;
      box-shadow: none;
      border-top: 0;
      padding: 0 0 6px;
      background: var(--surface-alt);
      display: none;
    }

    .has-children:hover > .sub-menu,
    .has-children:focus-within > .sub-menu {
      display: none;
    }

    .has-children.is-open > .sub-menu {
      display: block;
    }

    .sub-menu a {
      padding: 10px 16px 10px 32px;
    }
  }

  @media (max-width: 767px) {
    .header-phone-number {
      display: none;
    }
    .header-phone-short {
      display: inline;
    }
    .header-phone {
      border: 1px solid var(--rule);
      border-radius: var(--radius);
      padding: 8px 10px;
    }
    .header-quote {
      padding: 8px 10px;
      font-size: 12px;
    }
    .site-logo picture,
    .site-logo img {
      height: 38px;
    }
    .header-inner {
      gap: 8px;
    }
    .header-actions {
      gap: 6px;
    }
    .menu-toggle {
      width: 40px;
    }
    .menu-toggle-bar {
      right: 8px;
    }
  }

  /* 360–399px phones: logo + "Call" + quote + menu measured 16px wider than
     the 330px container at 360px. The phone becomes an icon-only button
     (its aria-label still names the number) and the logo steps down. */
  @media (max-width: 399px) {
    .header-phone-short {
      display: none;
    }
    .header-phone {
      padding: 8px 10px;
    }
    .site-logo picture,
    .site-logo img {
      height: 34px;
    }
  }

  @media (max-width: 359px) {
    .header-quote {
      display: none;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const navEl = document.querySelector<HTMLElement>('.site-nav');

  toggle?.addEventListener('click', () => {
    const open = navEl?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  // Mobile: tap a parent item to reveal its submenu instead of navigating.
  document.querySelectorAll<HTMLElement>('.has-children').forEach((li) => {
    const trigger = li.querySelector<HTMLElement>(':scope > a, :scope > .submenu-toggle');
    trigger?.addEventListener('click', (event) => {
      if (window.matchMedia('(min-width: 1200px)').matches) return;
      const isOpen = li.classList.contains('is-open');
      if (!isOpen) {
        event.preventDefault();
        li.classList.add('is-open');
        trigger.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
