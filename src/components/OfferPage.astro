---
/**
 * The service and industry page template (2026-10-15).
 *
 * Structure, in the order a buyer needs it: what this is and where (H1 and
 * summary), the two next steps (quote, call), then — only where the page has
 * the facts — who it is for, the original page copy, what is included, scope
 * notes and scheduling, how the work runs, what changes the price, real
 * reviews, FAQs, related services and the service area, and finally the
 * quote band. A quote form sits beside the content on a wide screen and
 * below it on a phone.
 *
 * Every section is driven by front matter fields that default to empty, and
 * an empty section renders nothing. That is the rule that keeps a missing
 * fact from turning into a placeholder.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import QuickQuoteForm from './QuickQuoteForm.astro';
import ProcessSteps from './blocks/ProcessSteps.astro';
import FaqList from './blocks/FaqList.astro';
import ReviewQuotes from './blocks/ReviewQuotes.astro';
import QuoteBand from './blocks/QuoteBand.astro';
import LinkCards from './blocks/LinkCards.astro';
import TrustStrip from './blocks/TrustStrip.astro';
import { AREAS, AREA_GROUPS } from '../data/coverage';
import { PRICING_FACTORS } from '../data/process';
import { nap, site } from '../data/site';
import { REPLY_PROMISE } from '../data/landing';
import { pageTitle } from '../lib/title';
import { breadcrumbSchema, serviceSchema, webPageSchema } from '../lib/schema';
import { lastmodFor } from '../lib/sitemap-lastmod.mjs';
import PagePhoto from './blocks/PagePhoto.astro';
import { responsiveSet } from '../lib/responsive-images.mjs';

interface Offer {
  title: string;
  description?: string;
  image?: string;
  h1?: string;
  seoTitle?: string;
  summary?: string;
  fitHeading?: string;
  fit: string[];
  included: { heading: string; items: string[] }[];
  scope: string[];
  scheduling: string[];
  showProcess: boolean;
  showPricing: boolean;
  reviews: string[];
  faqs: { q: string; a: string }[];
  related: { title: string; href: string; text?: string }[];
  showAreas: boolean;
  ctaHeading?: string;
  ctaText?: string;
}

interface Props {
  data: Offer;
  /** Rendered Markdown body, already normalised. */
  body: string | null;
  /** 'Services' or 'Industries' — the breadcrumb parent. */
  parent: { name: string; url: string };
  /** The conversion identity of this page's form. */
  formId: string;
}

const { data, body, parent, formId } = Astro.props;
const h1 = data.h1 ?? data.title;
const title = data.seoTitle ?? pageTitle(data.title);
const path = Astro.url.pathname;

/* A line for every related link that does not bring its own. Mixed cards,
   two with a description beside two without, looked half-empty; these are
   the descriptions the homepage and location pages already use. */
const RELATED_TEXT: Record<string, string> = {
  '/services/office-cleaning/': 'Recurring after-hours janitorial service.',
  '/services/commercial-cleaning/': 'Retail, institutional, hospitality and mixed-use buildings.',
  '/services/janitorial-services/': 'The scheduled, day-to-day upkeep, visit by visit.',
  '/services/industrial-cleaning/': 'Plant and warehouse floors, high dusting and staff facilities.',
  '/services/building-maintenance/': 'Strip and wax, carpet extraction, high dusting.',
  '/services/post-construction-cleaning/': 'Clean-up after a renovation or fit-out, before handover.',
  '/services/disinfection-cleaning/': 'Clean first, then disinfect the surfaces people touch.',
  '/services/emergency-cleaning/': 'Floods, water damage and messes that cannot wait.',
  '/services/pressure-washing/': 'Entrances, walkways, loading docks and exteriors.',
  '/services/graffiti-removal/': 'Removal matched to the surface it is on.',
  '/industries/medical-dental-clinics/': 'Waiting rooms, treatment areas and washrooms.',
  '/industries/property-management/': 'Common areas, lobbies, tenant spaces and short-notice work.',
  '/industries/': 'Offices, clinics, warehouses, retail and more.',
  '/green-clean-products/': 'The approved green cleaning products our crews use.',
};

/* The page's photo as its hero (11 Nov 2026, "each service page should have
   a hero image"). Until then the hero was a plain tinted band and the photo
   sat below it, at the top of the main column. It is now the first thing on
   the page and its Largest Contentful Paint, so it is eager and high
   priority, from the same AVIF/WebP/JPEG set the body photos use. The body
   copy of the photo is dropped when the hero carries it. */
const heroSet = data.image ? responsiveSet(data.image) : null;

/* A photo with no 1200w variant is not stretched across a desktop (12 Nov
   2026, SEO audit 11 Nov, images N7). The graffiti removal photo's source is
   only 645px wide, so its largest honest file is the 768w one, and at
   `100vw` that was blown up to the full width of a 1920px screen. Such a
   hero keeps the photo full-bleed on a phone, where 768 is enough, and from
   768px up holds it to the right-hand half at no more than 645px, fading
   into the dark band the text sits on. `sizes` follows, so the browser picks
   the file for the box it will really fill. */
const heroCompact = heroSet ? !heroSet.widths.includes(1200) : false;
const HERO_SIZES = heroCompact ? '(min-width: 1290px) 645px, (min-width: 768px) 50vw, 100vw' : '100vw';

/* Eight bodies open with the same photo; with it in the hero that showed it
   twice, a screen apart. The body's copy (its <picture>, or a bare <img>,
   with the paragraph around it) is removed when the hero carries it. */
const escape = (v: string) => v.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const bodyHtml =
  heroSet && body
    ? body.replace(
        new RegExp(
          String.raw`(?:<p>\s*)?(?:<picture>(?:(?!</picture>)[\s\S])*?/images/${escape(heroSet.base)}[-.](?:(?!</picture>)[\s\S])*?</picture>|<img\b[^>]*/images/${escape(heroSet.base)}[-.][^>]*>)(?:\s*</p>)?`,
        ),
        '',
      )
    : body;
---

<BaseLayout title={title} description={data.description} image={data.image} imageAlt={data.imageAlt}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(
      breadcrumbSchema([
        { name: site.name, url: '/' },
        { name: parent.name, url: parent.url },
        { name: data.title },
      ])
    )}
    is:inline
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(serviceSchema({ name: data.title, description: data.description, url: path }))}
    is:inline
  />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(
      webPageSchema({
        name: title,
        url: path,
        description: data.description,
        image: data.image,
        dateModified: lastmodFor(`${site.url}${path}`),
        mainEntityId: `${site.url}${path}#service`,
      }),
    )}
    is:inline
  />
  {/* The hero photo, preloaded (12 Nov 2026, SEO audit 11 Nov, performance
      P1 and images N11). It is the LCP element on every service and industry
      page, and without this its request waited for the parser to reach the
      <picture>: 0.5 to 1.0 s of load delay in the lab. The AVIF set only,
      with the same URLs and sizes as the <picture>'s AVIF source, so the
      preloaded file is the one the <picture> then uses: every browser that
      honours `imagesrcset` also decodes AVIF. Pages without a hero emit
      nothing. */}
  {
    heroSet && (
      <link
        slot="head"
        rel="preload"
        as="image"
        type="image/avif"
        imagesrcset={heroSet.avif}
        imagesizes={HERO_SIZES}
        fetchpriority="high"
      />
    )
  }

  {/* `data-leadnet-gate` on the hero and the trust list below it: on a phone
      the video bubble waits until both have scrolled past (LeadVideo.astro). */}
  <section
    class:list={['offer-hero', heroSet && 'has-image', heroCompact && 'is-compact']}
    data-leadnet-gate={heroSet ? '' : undefined}
  >
    {
      heroSet && (
        <picture class="offer-hero-media">
          <source type="image/avif" srcset={heroSet.avif} sizes={HERO_SIZES} />
          <source type="image/webp" srcset={heroSet.webp} sizes={HERO_SIZES} />
          {/* No `decoding="async"` (12 Nov 2026, SEO audit 11 Nov, P1): this
              is the LCP element, and async decoding lets the browser paint
              the rest of the frame first. */}
          <img
            src={`/images/${heroSet.base}-${heroSet.widths.includes(768) ? 768 : heroSet.widths.at(-1)}.jpg`}
            srcset={heroSet.jpg}
            sizes={HERO_SIZES}
            alt={data.imageAlt ?? ''}
            width="1200"
            height="800"
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      )
    }
    <div class="container">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <a href={parent.url}>{parent.name}</a> &gt;{' '}
        <span aria-current="page">{data.title}</span>
      </nav>
      <h1>{h1}</h1>
      {data.summary && <p class="offer-summary">{data.summary}</p>}
      <p class="offer-actions">
        <a class="btn btn-primary btn-lg" href="#offer-quote" data-quote-cta data-cta-location="hero">Get a free quote</a>
        <a class="btn btn-ghost btn-lg" href={nap.phoneHref} data-call-location="hero">Call {nap.phoneDisplay}</a>
      </p>
    </div>
  </section>

  <div class="container offer-trust" data-leadnet-gate={heroSet ? '' : undefined}>
    <TrustStrip />
  </div>

  <div class="container offer-grid section-padding">
    <div class="offer-main stack">
      {/* The page's own photo (its social-sharing image), when the body has
          none of its own: these pages showed no photograph at all (SEO audit H6). */}
      {data.image && !heroSet && !(body ?? '').includes('<img') && (
        <PagePhoto src={data.image} alt={data.imageAlt ?? data.title} />
      )}
      {
        data.fit.length > 0 && (
          <section aria-label={data.fitHeading ?? 'Who this is for'}>
            <h2 class="blk-title">{data.fitHeading ?? 'Who this is for'}</h2>
            <ul class="check-list">
              {data.fit.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )
      }

      {bodyHtml && <div class="entry-content offer-body" set:html={bodyHtml} />}

      {
        data.included.length > 0 && (
          <section aria-label="What is included">
            <h2 class="blk-title">What is included</h2>
            <div class="offer-included">
              {data.included.map((group) => (
                <div>
                  <h3>{group.heading}</h3>
                  <ul class="check-list">
                    {group.items.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        (data.scope.length > 0 || data.scheduling.length > 0) && (
          <div class="cols-2">
            {data.scheduling.length > 0 && (
              <section aria-label="Scheduling">
                <h2 class="blk-title">Scheduling</h2>
                <ul class="check-list">
                  {data.scheduling.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            )}
            {data.scope.length > 0 && (
              <section aria-label="Scope">
                <h2 class="blk-title">Scope and limits</h2>
                <ul class="offer-scope">
                  {data.scope.map((item) => <li>{item}</li>)}
                </ul>
              </section>
            )}
          </div>
        )
      }

      {data.showProcess && <ProcessSteps heading="How it works" />}

      {
        data.showPricing && (
          <section aria-label="What affects the price">
            <h2 class="blk-title">What affects the price</h2>
            <p>
              Every quote is written after a walkthrough, because these are what change it — and none of
              them can be judged reliably over the phone:
            </p>
            <ul class="check-list">
              {PRICING_FACTORS.map((item) => <li>{item}</li>)}
            </ul>
          </section>
        )
      }

      {data.reviews.length > 0 && <ReviewQuotes names={data.reviews} />}

      <FaqList faqs={data.faqs} />

      <LinkCards heading="Related" items={data.related.map((r) => ({ ...r, text: r.text ?? RELATED_TEXT[r.href] }))} />

      {
        data.showAreas && (
          <section aria-label="Service area">
            <h2 class="blk-title">Where we work</h2>
            <p>
              Crews are dispatched across the Greater Toronto Area from our Toronto base. Pages with local
              detail are linked.
            </p>
            <div class="offer-areas">
              {AREA_GROUPS.map((group) => (
                <div>
                  <h3>{group}</h3>
                  <ul>
                    {AREAS.filter((a) => a.group === group).map((a) => (
                      <li>{a.href ? <a href={a.href}>{a.name}</a> : a.name}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <aside class="offer-aside" aria-label="Request a quote">
      <div class="offer-form-card">
        <QuickQuoteForm
          id="offer-quote"
          formId={formId}
          heading="Get a free quote"
          intro={`We reply ${REPLY_PROMISE}, then arrange a free walkthrough when it suits you. No obligation.`}
        />
      </div>
    </aside>
  </div>

  <div class="container offer-band">
    <QuoteBand heading={data.ctaHeading} text={data.ctaText} />
  </div>
</BaseLayout>

<style>
  .offer-hero {
    background: var(--surface-tint);
    border-bottom: 1px solid var(--rule);
    padding: 28px 0 30px;
  }
  /* With a photo: full-bleed, darkened toward the text so white type clears
     4.5:1 over the brightest part of any of the photos, as on the homepage. */
  .offer-hero.has-image {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface-dark);
    border-bottom: 0;
    color: #fff;
    padding: 56px 0 60px;
  }
  .offer-hero-media,
  .offer-hero.has-image::after {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .offer-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }
  .offer-hero.has-image::after {
    content: '';
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.62) 55%, rgba(0, 0, 0, 0.4) 100%);
  }
  .offer-hero.has-image h1,
  .offer-hero.has-image .offer-summary,
  .offer-hero.has-image .breadcrumbs,
  .offer-hero.has-image .breadcrumbs a {
    color: #fff;
  }
  .offer-hero.has-image .btn-ghost {
    border-color: #fff;
    color: #fff;
  }
  .offer-hero.has-image .btn-ghost:hover,
  .offer-hero.has-image .btn-ghost:focus-visible {
    background: #fff;
    color: var(--brand-dark);
  }
  /* A hero with no 1200w file (see `heroCompact`): from 768px up the photo
     takes the right-hand half, never wider than its 645px source, and fades
     in from the left so there is no hard edge against the dark band. */
  @media (min-width: 768px) {
    .offer-hero.is-compact .offer-hero-media {
      left: auto;
      width: min(50%, 645px);
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 35%);
      mask-image: linear-gradient(90deg, transparent 0, #000 35%);
    }
  }
  @media (max-width: 767px) {
    .offer-hero.has-image {
      padding: 36px 0 40px;
    }
    /* Text runs the full width on a phone, so darken evenly. */
    .offer-hero.has-image::after {
      background: rgba(0, 0, 0, 0.66);
    }
  }
  .offer-hero h1 {
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 10px 0 12px;
    max-width: 900px;
  }
  @media (max-width: 767px) {
    .offer-hero h1 {
      font-size: 1.85rem;
    }
  }
  .offer-summary {
    font-size: 1.125rem;
    max-width: 820px;
    margin: 0 0 18px;
    color: var(--ink-heading);
  }
  .offer-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }
  .offer-actions .btn {
    margin: 0;
  }
  /* Full width on a narrow phone, as the homepage hero's buttons are: left-
     aligned at their own widths the two measured 260 and 272px and read as
     misaligned (SEO audit, visual finding 9). */
  @media (max-width: 479px) {
    .offer-actions .btn {
      flex: 1 1 100%;
    }
  }
  .offer-trust {
    padding-top: 24px;
  }
  /* One `minmax(0, 1fr)` track below 992px: an implicit track has a
     min-content floor, and a long unbroken line in the commercial cleaning
     checklist pushed it to 333px on a 320px phone (SEO audit, 30 Oct 2026). */
  .offer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
  }
  .offer-grid > * {
    min-width: 0;
  }
  @media (min-width: 992px) {
    .offer-grid {
      grid-template-columns: minmax(0, 1fr) 360px;
      align-items: start;
    }
  }
  /* Sticky only where the whole form fits on screen: the card is about 875px,
     plus 78px once reCAPTCHA loads on the first focus, plus the 92px header.
     On a shorter window a pinned form left its lower fields and submit
     button off-screen until the end of the page. */
  @media (min-width: 992px) and (min-height: 1080px) {
    .offer-aside {
      position: sticky;
      top: 92px;
      /* Never taller than the window: if the form grows after it is pinned
         (validation errors, a re-rendered CAPTCHA), it scrolls inside its
         own box rather than hiding the submit button (Codex review, #67). */
      max-height: calc(100vh - 108px);
      overflow-y: auto;
    }
  }
  .offer-form-card {
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 4px solid var(--brand);
    border-radius: 6px;
    padding: 20px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  }
  .offer-included {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .offer-included {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .offer-included h3 {
    font-size: 1.1rem;
    margin: 0 0 10px;
  }
  .offer-scope {
    margin: 0;
    padding-left: 18px;
  }
  .offer-scope li + li {
    margin-top: 6px;
  }
  .offer-areas {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
  .offer-areas h3 {
    font-size: 1rem;
    margin: 0 0 6px;
  }
  .offer-areas ul {
    margin: 0;
    padding-left: 18px;
  }
  /* 44px targets on a phone or any touch screen (13 Nov 2026, SEO audit
     11 Nov, critic R4): at 360px the area links measured 24px and the
     breadcrumb links 30px, missed by the 7 Nov pass over the footer, the
     homepage areas and the sidebar. Each area row becomes 44px, plain-text
     areas included so the list keeps one rhythm, and the breadcrumb's line
     grows to fit; with a mouse on a desktop nothing changes. */
  @media (max-width: 767px), (pointer: coarse) {
    .offer-areas li {
      line-height: 44px;
      padding-block: 0;
    }

    .offer-areas li > a {
      min-height: 44px;
      line-height: 44px;
    }

    .offer-hero .breadcrumbs a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-block: 0;
    }
  }
  .offer-band {
    padding-bottom: 56px;
  }
  .offer-body :global(h2) {
    font-size: 1.5rem;
  }
</style>
