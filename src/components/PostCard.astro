---
/**
 * Blog post teaser, used by the /category/blog/ and /blog/ listings.
 * Pass a blog collection entry: <PostCard post={post} loading="eager" />
 */
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Use "eager" for cards that are above the fold. */
  loading?: 'lazy' | 'eager';
}

const { post, loading = 'lazy' } = Astro.props;
const { title, description, pubDate, image, imageAlt } = post.data;

const href = `/${post.id}/`;
// Every post in the archive had a thumbnail, but a handful of those files are
// not in /public/images, so those cards fall back to the logo. The logo is a
// wide banner with the company name in it: it is letterboxed rather than
// cropped to 2:1, otherwise the name is cut off (see .is-fallback below).
const thumb = image ?? site.logo;
const isFallback = !image;
const isoDate = pubDate.toISOString().slice(0, 10);
const dateLabel = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(pubDate);
---

<article class="post-card">
  <a
    class:list={['post-card-thumb', isFallback && 'is-fallback']}
    href={href}
    tabindex="-1"
    aria-hidden="true"
  >
    <img
      src={thumb}
      alt={isFallback ? `${site.name} logo` : (imageAlt ?? title)}
      loading={loading}
      decoding="async"
      width={isFallback ? 884 : 600}
      height={isFallback ? 265 : 300}
    />
  </a>
  <div class="post-card-body">
    <p class="post-card-meta">
      <time datetime={isoDate}>{dateLabel}</time>
    </p>
    <h2 class="post-card-title"><a href={href}>{title}</a></h2>
    {description && <p class="post-card-excerpt">{description}</p>}
    <a class="post-card-more" href={href}>
      Read more<span class="screen-reader-text"> about {title}</span>
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      border-color var(--motion-fast) ease,
      box-shadow var(--motion-base) var(--ease-out),
      transform var(--motion-base) var(--ease-out);
  }

  /* As ServiceCard: brand border for everyone, lift and zoom for a pointer. */
  .post-card:hover,
  .post-card:focus-within {
    border-color: var(--brand);
  }

  @media (hover: hover) {
    .post-card:hover {
      box-shadow: var(--shadow-lift);
      transform: translateY(var(--lift));
    }
    .post-card:hover .post-card-thumb:not(.is-fallback) img {
      transform: scale(1.04);
    }
  }

  .post-card-thumb {
    display: block;
    overflow: hidden;
    background: var(--surface-alt);
  }

  .post-card-thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    transition: transform 600ms var(--ease-out);
  }

  /* Logo fallback: hold the same 2:1 card shape, but letterbox the banner so
     the company name inside it is never cropped. */
  .post-card-thumb.is-fallback {
    aspect-ratio: 2 / 1;
    display: grid;
    place-items: center;
    padding: 16px 24px;
  }

  .post-card-thumb.is-fallback img {
    aspect-ratio: auto;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .post-card-body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .post-card-meta {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }

  .post-card-title {
    font-size: 1.25rem;
    margin: 0 0 10px;
  }

  .post-card-title a {
    color: var(--ink-heading);
  }

  .post-card-title a:hover,
  .post-card-title a:focus-visible {
    color: var(--brand);
  }

  .post-card-excerpt {
    margin: 0 0 16px;
  }

  .post-card-more {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--brand);
  }

  .post-card-more::after {
    content: ' \2192';
    position: relative;
    left: 0;
    transition: left var(--motion-base) var(--ease-out);
  }

  @media (hover: hover) {
    .post-card:hover .post-card-more::after {
      left: 4px;
    }
  }

  .post-card a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }
</style>
