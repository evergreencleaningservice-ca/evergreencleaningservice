---
/**
 * Blog post teaser, used by the /category/blog/ and /blog/ listings.
 * Pass a blog collection entry: <PostCard post={post} loading="eager" />
 */
import type { CollectionEntry } from 'astro:content';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Use "eager" for cards that are above the fold. */
  loading?: 'lazy' | 'eager';
}

const { post, loading = 'lazy' } = Astro.props;
const { title, description, pubDate, image } = post.data;

const href = `/${post.id}/`;
const thumb = image ?? site.logo;
const isoDate = pubDate.toISOString().slice(0, 10);
const dateLabel = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
}).format(pubDate);
---

<article class="post-card">
  <a class="post-card-thumb" href={href} tabindex="-1" aria-hidden="true">
    <img src={thumb} alt="" loading={loading} decoding="async" width="600" height="300" />
  </a>
  <div class="post-card-body">
    <p class="post-card-meta">
      <time datetime={isoDate}>{dateLabel}</time>
    </p>
    <h2 class="post-card-title"><a href={href}>{title}</a></h2>
    {description && <p class="post-card-excerpt">{description}</p>}
    <a class="post-card-more" href={href}>
      Read more<span class="screen-reader-text"> about {title}</span>
    </a>
  </div>
</article>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .post-card:hover,
  .post-card:focus-within {
    box-shadow: 0 8px 20px rgba(50, 50, 50, 0.12);
    transform: translateY(-2px);
  }

  .post-card-thumb {
    display: block;
    background: var(--surface-alt);
  }

  .post-card-thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  .post-card-body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .post-card-meta {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }

  .post-card-title {
    font-size: 1.25rem;
    margin: 0 0 10px;
  }

  .post-card-title a {
    color: var(--ink-heading);
  }

  .post-card-title a:hover,
  .post-card-title a:focus-visible {
    color: var(--brand);
  }

  .post-card-excerpt {
    margin: 0 0 16px;
  }

  .post-card-more {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--brand);
  }

  .post-card-more::after {
    content: ' \2192';
  }

  .post-card a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }
</style>
