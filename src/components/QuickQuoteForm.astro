---
/**
 * The quote form — every quote form on the site, the landing pages and the
 * homepage included.
 *
 * WHAT IT ASKS (2026-10-22). The client asked for the form to look and work
 * exactly like the original site's WPForms form **1381**, the one whose
 * notification email they read every lead in. Its fields, in its order:
 *
 *   Name *                one box; the email shows the whole name on one line
 *   Name of Business *
 *   Address *             street & unit #, city, province (Ontario), postal
 *                         code. Country is not asked: the email prints "CA".
 *   Email *
 *   Phone *
 *   I'm interested in a quote for these services   checkboxes, not required
 *   Additional comments                          not required
 *
 * This replaces the short form (name, phone, email, one service select, an
 * optional city). It asks more and will convert somewhat worse; the client
 * chose a lead that arrives with its address and business over a shorter
 * form.
 *
 * Everything behind the form is unchanged: the same endpoint, the same
 * honeypot, the same captcha, the same single `lead_form_submission` after a
 * 2xx, the same attribution merged invisibly by `lead-submit.ts`, and the
 * same inline error messages from `quick-quote.ts`.
 */
import SpamGuard from './SpamGuard.astro';
import { SERVICE_OPTIONS } from '../data/services';
import { REPLY_PROMISE } from '../data/landing';
import { SERVICE_LOCATION_SUGGESTIONS } from '../data/coverage';

interface Props {
  /** Prefix for field ids, so two of these can share a page. */
  id?: string;
  /** Heading rendered above the fields. Omit to render none. */
  heading?: string;
  /** Small line under the heading. */
  intro?: string;
  /**
   * The REPORTING identity — what lands in `form_id` on the conversion event
   * and in the `form_id` column in Neon. Distinct from `id`, which is the DOM
   * element and the anchor target.
   *
   * The two landing pages keep the identities they already report under, so
   * the rows already in the table continue to line up with the rows to come.
   * Merging them would make the two pages indistinguishable in the conversion
   * data, which is the entire reason for running two.
   */
  formId?: string;
  /** Text on the submit button. */
  submitLabel?: string;
  /** Load the captcha at once — for a form inside the first screen. */
  eagerCaptcha?: boolean;
  /**
   * When the success message says a reply will come. Omit it and the form
   * uses REPLY_PROMISE, "within 2 hours", the one promise the site and the
   * Google Ads make (client, 30 Oct 2026).
   */
  replyPromise?: string;
}

const {
  id = 'quick-quote',
  heading,
  intro,
  formId = 'quick-quote',
  submitLabel = 'Get my free quote',
  eagerCaptcha = false,
  replyPromise = REPLY_PROMISE,
} = Astro.props;
const f = (name: string) => `${id}-${name}`;


---

<form
  class="qq"
  id={id}
  method="post"
  action="#"
  novalidate
  data-endpoint="/api/submit-lead"
  data-form-id={formId}
  data-reply-promise={replyPromise}
  data-quick-quote
  aria-labelledby={heading ? f('heading') : undefined}
  aria-label={heading ? undefined : 'Request a quote'}
>
  {heading && <h2 class="qq-heading" id={f('heading')}>{heading}</h2>}
  {intro && <p class="qq-intro">{intro}</p>}

  {/* The error summary. Always in the DOM with a reserved height, so showing
      it moves nothing — an error that shifts the layout moves the field the
      visitor is about to correct. */}
  <div class="qq-summary" data-qq-summary role="alert" aria-live="assertive" tabindex="-1"></div>

  <div class="qq-row">
  <div class="qq-field">
    <label class="qq-label" for={f('name')}>Name <span class="qq-req">*</span></label>
    <input
      type="text"
      id={f('name')}
      name="name"
      autocomplete="name"
      autocapitalize="words"
      required
      aria-describedby={f('name-error')}
    />
    <p class="qq-error" id={f('name-error')} data-qq-error="name"></p>
  </div>

  <div class="qq-field">
    <label class="qq-label" for={f('business-name')}>
      Name of Business <span class="qq-req">*</span>
    </label>
    <input
      type="text"
      id={f('business-name')}
      name="business-name"
      autocomplete="organization"
      required
      aria-describedby={f('business-name-error')}
    />
    <p class="qq-error" id={f('business-name-error')} data-qq-error="business-name"></p>
  </div>
  </div>

  {/* The address is four boxes on screen and one thing in the email: street,
      "city, province", postal code, then "CA", each on its own line, the
      way the original's notification printed it. Composed in `quick-quote.ts`. */}
  <fieldset class="qq-field qq-group">
    <legend class="qq-label">Address <span class="qq-req">*</span></legend>

    <div class="qq-field">
      <label class="qq-sublabel" for={f('address1')}>Street address &amp; unit #</label>
      <input
        type="text"
        id={f('address1')}
        name="address1"
        autocomplete="address-line1"
        required
        aria-describedby={f('address1-error')}
      />
      <p class="qq-error" id={f('address1-error')} data-qq-error="address1"></p>
    </div>

    <div class="qq-row qq-row-3">
      <div class="qq-field">
        <label class="qq-sublabel" for={f('city')}>City</label>
        <input
          type="text"
          id={f('city')}
          name="city"
          autocomplete="address-level2"
          list={f('city-list')}
          required
          aria-describedby={f('city-error')}
        />
        <datalist id={f('city-list')}>
          {SERVICE_LOCATION_SUGGESTIONS.map((place) => <option value={place} />)}
        </datalist>
        <p class="qq-error" id={f('city-error')} data-qq-error="city"></p>
      </div>

      <div class="qq-field">
        <label class="qq-sublabel" for={f('province')}>Province</label>
        <input
          type="text"
          id={f('province')}
          name="province"
          value="Ontario"
          autocomplete="address-level1"
          required
          aria-describedby={f('province-error')}
        />
        <p class="qq-error" id={f('province-error')} data-qq-error="province"></p>
      </div>

      <div class="qq-field">
        <label class="qq-sublabel" for={f('postal')}>Postal code</label>
        <input
          type="text"
          id={f('postal')}
          name="postal"
          autocomplete="postal-code"
          autocapitalize="characters"
          maxlength="10"
          required
          aria-describedby={f('postal-error')}
        />
        <p class="qq-error" id={f('postal-error')} data-qq-error="postal"></p>
      </div>
    </div>
  </fieldset>

  <div class="qq-row">
  <div class="qq-field">
    <label class="qq-label" for={f('email')}>Email <span class="qq-req">*</span></label>
    <input
      type="email"
      id={f('email')}
      name="email"
      inputmode="email"
      autocomplete="email"
      spellcheck="false"
      required
      aria-describedby={f('email-error')}
    />
    <p class="qq-error" id={f('email-error')} data-qq-error="email"></p>
  </div>

  <div class="qq-field">
    <label class="qq-label" for={f('phone')}>Phone <span class="qq-req">*</span></label>
    <input
      type="tel"
      id={f('phone')}
      name="phone"
      inputmode="tel"
      autocomplete="tel"
      {/* A FORMAT MASK, NOT AN EXAMPLE NUMBER. An earlier attempt used a
          plausible-looking 416 number and `landing-pages.test.ts` caught
          it: these pages must show exactly one telephone number, the real
          one, so a second set of digits on screen is a number a visitor
          could read as the client's. */}
      placeholder="(XXX) XXX-XXXX"
      required
      aria-describedby={f('phone-error')}
    />
    <p class="qq-error" id={f('phone-error')} data-qq-error="phone"></p>
  </div>
  </div>

  <fieldset class="qq-field qq-group">
    <legend class="qq-label">I'm interested in a quote for these services</legend>
    <ul class="qq-choices">
      {
        SERVICE_OPTIONS.map((service, i) => (
          <li>
            <input type="checkbox" id={f(`service-${i}`)} name="services" value={service} />
            <label for={f(`service-${i}`)}>{service}</label>
          </li>
        ))
      }
    </ul>
  </fieldset>

  <div class="qq-field">
    <label class="qq-label" for={f('message')}>Additional comments</label>
    <textarea id={f('message')} name="message" rows="2" maxlength="4000"></textarea>
  </div>


  {/* Honeypot. A person never sees it, so anything in it is a bot. */}
  <div class="qq-hp" aria-hidden="true">
    <label for={f('hp')}>Company website</label>
    <input type="text" id={f('hp')} name="company-website" tabindex="-1" autocomplete="off" />
  </div>

  <SpamGuard eager={eagerCaptcha} />

  <button class="qq-submit" type="submit">{submitLabel}</button>

</form>

<script>
  /* Wired here rather than by `FormRuntime`, which binds every
     `form[data-endpoint]` with the browser's own validation bubbles. This
     form renders its own inline messages, so it brings its own wiring — and `FormRuntime`
     skips it, because `wireLeadForm` refuses a form it has already bound and
     this script runs first. */
  import { wireQuickQuote } from '../lib/quick-quote';

  document
    .querySelectorAll<HTMLFormElement>('form[data-quick-quote]')
    .forEach((form) => wireQuickQuote(form));
</script>

<style>
  /* A size container, so the rows below go side by side when the FORM is
     wide enough rather than the viewport: the landing pages put it in a
     narrow column on a wide screen. */
  .qq {
    margin: 0;
    container-type: inline-size;
  }

  .qq-heading {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--ink-heading);
  }

  .qq-intro {
    margin: 0 0 20px;
    color: var(--ink);
    line-height: 1.6;
  }

  /* Reserved, so revealing an error shifts nothing. */
  .qq-summary {
    min-height: 0;
    margin: 0;
  }

  .qq-summary:not(:empty) {
    min-height: auto;
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #d9534f;
    border-left-width: 4px;
    border-radius: var(--radius);
    background: #fdf3f3;
    color: #a94442;
    line-height: 1.5;
  }

  .qq-summary:focus-visible {
    outline: 2px solid #a94442;
    outline-offset: 2px;
  }

  /* Related fields share a line — name and business, city/province/postal,
     email and phone — which is most of what keeps an eight-question form
     short on screen, a phone included. They stack below 260px. Between 260
     and 400px — any phone — the address row puts the city on a line of
     its own, with province and postal code paired under it. */
  .qq-row {
    display: grid;
    gap: 0 12px;
  }

  @container (min-width: 260px) {
    .qq-row {
      grid-template-columns: 1fr 1fr;
    }

    .qq-row-3 > :first-child {
      grid-column: 1 / -1;
    }
  }

  /* City, province and postal code on one line from 300px (30 Oct 2026,
     "the forms are too long"): in the service pages' 318px sidebar form the
     postal code box is about 87px, enough for "M5V 1Z4". It was 400px, which
     put the city on a line of its own in every sidebar form. */
  @container (min-width: 300px) {
    .qq-row-3 {
      grid-template-columns: 1.25fr 1fr 0.95fr;
    }

    .qq-row-3 > :first-child {
      grid-column: auto;
    }

    /* Two columns of services from 300px too: eight one-line rows were the
       tallest part of the form. */
    .qq-choices {
      grid-template-columns: 1fr 1fr;
    }
  }

  .qq-field {
    margin: 0 0 8px;
    min-width: 0;
  }

  .qq-group {
    margin: 0;
    padding: 0;
    border: 0;
  }

  /* One column, two from 400px (in the container query above): on a phone
     two columns wrap most names onto two or three lines and save nothing.
     Never three. */
  .qq-choices {
    display: grid;
    gap: 6px 12px;
    margin: 2px 0 10px;
    padding: 0;
    list-style: none;
  }

  .qq-choices li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    font-size: 14px;
    line-height: 1.3;
  }

  /* 18px boxes in the brand green; the label is part of the target too. */
  .qq-choices input {
    flex: none;
    width: 18px;
    height: 18px;
    margin: 1px 0 0;
    accent-color: var(--brand);
  }

  .qq-choices label {
    color: var(--ink-heading);
    cursor: pointer;
  }

  .qq-label {
    display: block;
    padding: 0;
    margin: 0 0 4px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--ink-heading);
  }

  .qq-sublabel {
    display: block;
    margin: 0 0 3px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .qq-hint {
    display: block;
    margin-top: 2px;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink);
  }

  .qq-req {
    color: #c0392b;
  }

  .qq-optional {
    font-weight: 400;
    font-size: 12.5px;
    color: var(--ink);
  }

  .qq input[type='text'],
  .qq input[type='tel'],
  .qq input[type='email'],
  .qq select,
  .qq textarea {
    width: 100%;
    max-width: 100%;
    /* 38px (42px until 30 Oct 2026): compact, and still well over the 24px minimum target. The
       custom properties let a page set a tighter size (the landing pages do
       on desktop) without out-shouting this component's scoped selectors. */
    min-height: var(--qq-input-height, 38px);
    padding: var(--qq-input-padding, 7px 10px);
    /* FILLED, NOT OUTLINED. The field is described by its own tint rather
       than by a rule around it, so a column of inputs reads as a stack of
       targets instead of a stack of boxes.

       #ebf2fa IS MEASURED, not chosen. Sampled from the reference design's
       own screenshot: nine probes across all six inputs and the textarea
       returned the identical value, so it is the fill, not an artefact of
       one compressed pixel.

       A first attempt used a neutral green-grey (#eef1ec) on the reasoning
       that the reference's blue is its own brand colour. Side by side that
       was wrong in the way that matters: at that lightness the field barely
       separated from white, so the form read as a page with text on it
       rather than as a set of boxes to fill. The blue is doing structural
       work here, not brand work — it says "this is where you type" — and it
       sits under Evergreen's green without competing for it. The button
       stays green; only the boxes are the reference's.

       A VISIBLE EDGE since 30 Oct 2026. The tint alone is about 1.1:1
       against the white card, so on a phone several fields read as blank
       bands (SEO audit; WCAG 1.4.11 asks 3:1 for an input's boundary).
       #7f8a99 is 3.5:1 on white. */
    border: 1px solid #7f8a99;
    border-radius: var(--radius);
    background: #ebf2fa;
    font-family: inherit;
    font-size: 16px; /* under 16px, iOS zooms the page on focus */
    color: var(--ink-heading);
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  /* The border is transparent rather than absent so focus and error states
     have something to colour without the field changing size. */
  .qq input[type='text']:hover,
  .qq input[type='tel']:hover,
  .qq input[type='email']:hover,
  .qq select:hover,
  .qq textarea:hover {
    /* One step deeper than the resting fill, enough to register under a
       cursor without becoming a second state to read. */
    background: #e2ecf8;
  }

  /* A placeholder is a hint, never the label — every field above keeps its
     own <label for>. Kept well clear of the text colour so the two are never
     mistaken for one another. */
  .qq ::placeholder {
    /* Measured off the reference at #757575 — the darkest pixel inside three
       separate placeholder runs, every time. Neutral rather than tinted,
       which is what keeps it reading as a hint instead of as a fourth colour
       in the field.

       SHIPPED ONE STEP DARKER, and this is the one place the reference is
       not copied exactly. #757575 on #ebf2fa computes to 4.08:1, under the
       4.5:1 WCAG AA wants for text this size; #6b6b6b is 4.72:1. The two are
       indistinguishable side by side, so the difference costs nothing and
       buys a form that is readable to someone whose eyesight is not the
       designer's. */
    color: #6b6b6b;
    opacity: 1; /* Firefox dims placeholders by default */
  }

  .qq textarea {
    height: var(--qq-textarea-height, auto);
    min-height: var(--qq-textarea-height, 60px);
    resize: vertical;
    line-height: 1.5;
  }

  .qq input:focus-visible,
  .qq select:focus-visible,
  .qq textarea:focus-visible,
  .qq-submit:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .qq [aria-invalid='true'] {
    border-color: #c0392b;
    background: #fffafa;
  }

  /* No space is held for a message that is not there: across eight fields
     the reserved lines added up to a screen's worth of blank. A message
     pushes the fields below it down when it appears, and the summary at the
     top lists every problem at once. */
  .qq-error {
    margin: 3px 0 0;
    font-size: 12.5px;
    line-height: 1.15rem;
    color: #a94442;
  }

  .qq-error:empty {
    display: none;
  }

  .qq-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .qq-submit {
    width: 100%;
    min-height: 48px;
    margin-top: 4px;
    border: 0;
    border-radius: var(--radius);
    background: var(--brand);
    color: #fff;
    padding: 12px 22px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .qq-submit:hover:not(:disabled) {
    background: var(--brand-dark);
  }

  .qq-submit:disabled {
    opacity: 0.75;
    cursor: progress;
  }

  @media (min-width: 560px) {
    .qq-submit {
      width: auto;
      min-width: 260px;
    }
  }

</style>

<style is:global>
  /* Replaces the form on success, so it is not scoped to this component. */
  .qq-confirm {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border: 1px solid var(--brand);
    border-left-width: 4px;
    border-radius: var(--radius);
    background: #f2f8ee;
    line-height: 1.6;
    color: var(--ink-heading);
  }

  .qq-confirm strong {
    font-family: var(--font-heading);
    font-size: 1.125rem;
  }

  .qq-confirm a {
    color: var(--brand);
    font-weight: 700;
  }

  .qq-confirm:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 3px;
  }
</style>
