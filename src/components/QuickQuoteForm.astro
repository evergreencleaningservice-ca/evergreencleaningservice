---
/**
 * The short lead form — the primary quote experience, and the one cold paid
 * traffic sees.
 *
 * WHY IT EXISTS. The form it replaces asks for eighteen fields and requires
 * nine of them, including a complete street address and a last name, before
 * it will accept an enquiry from someone who has not yet decided to buy
 * anything. Measured on the built page: 1,363px tall at 390px wide, on a page
 * 4,376px tall. Everything it asks that is not "who are you and how do I call
 * you back" is a question the account executive can ask on the phone, and
 * every one of them is a place to give up.
 *
 * WHAT IT ASKS, AND WHAT IT REFUSES TO ASK:
 *
 *   first name      not a full name. A surname buys nothing at this stage.
 *   business name   the one qualifying fact that matters for commercial
 *                   cleaning, and it is one field.
 *   phone           EITHER of these. Not both.
 *   email
 *   postal or city  how we know whether we serve you. One short field, and it
 *                   takes a postal code or a place name — a visitor should
 *                   never have to guess which format a box wants.
 *   service         one select.
 *   message         optional, and labelled optional.
 *
 * NO street address. NO square footage, frequency or preferred schedule. Those
 * are qualification, and qualification happens after a lead exists, not as a
 * condition of creating one. The long form is still there for anyone who
 * wants to hand over the full picture up front — it is a choice now, not a
 * toll.
 *
 * "PHONE OR EMAIL" IS THE ONE RULE HTML CANNOT STATE. `required` can only say
 * "this field, always", and marking both required is precisely the friction
 * this form removes. It is checked in `validate` below, after the browser has
 * finished with per-field validity, so a visitor is never told about a
 * cross-field rule while a single field is still malformed.
 *
 * Everything behind the form is unchanged: the same endpoint, the same
 * honeypot, the same Turnstile, the same single `lead_form_submission` after
 * a 2xx, the same attribution merged invisibly by `lead-submit.ts`.
 */
import SpamGuard from './SpamGuard.astro';
import { nap } from '../data/site';

interface Props {
  /** Prefix for field ids, so two of these can share a page. */
  id?: string;
  /** Heading rendered above the fields. Omit to render none. */
  heading?: string;
  /** Small line under the heading. */
  intro?: string;
  /**
   * The REPORTING identity — what lands in `form_id` on the conversion event
   * and in the `form_id` column in Neon. Distinct from `id`, which is the DOM
   * element and the anchor target.
   *
   * The two landing pages keep the identities they already report under, so
   * the rows already in the table continue to line up with the rows to come.
   * Merging them would make the two pages indistinguishable in the conversion
   * data, which is the entire reason for running two.
   */
  formId?: string;
  /** Text on the submit button. */
  submitLabel?: string;
  /** Load the captcha at once — for a form inside the first screen. */
  eagerCaptcha?: boolean;
}

const {
  id = 'quick-quote',
  heading,
  intro,
  formId = 'quick-quote',
  submitLabel = 'Get my free quote',
  eagerCaptcha = false,
} = Astro.props;
const f = (name: string) => `${id}-${name}`;


/**
 * The marketing-consent wording, in one place because it is submitted with
 * the form as well as displayed beside the box.
 *
 * CASL wants the sender identified and an unsubscribe route stated, so both
 * are in the sentence rather than assumed. It is written as a plain offer, not
 * as a legal clause: a box nobody reads is not meaningful consent however
 * carefully it is drafted.
 */
const CONSENT_TEXT =
  `Email me occasional cleaning tips and offers from ${nap.name}. ` +
  'Unsubscribe any time — this is separate from your quote, which we will reply to either way.';
---

<form
  class="qq"
  id={id}
  method="post"
  action="#"
  novalidate
  data-endpoint="/api/submit-lead"
  data-form-id={formId}
  data-quick-quote
  aria-labelledby={heading ? f('heading') : undefined}
  aria-label={heading ? undefined : 'Request a quote'}
>
  {heading && <h2 class="qq-heading" id={f('heading')}>{heading}</h2>}
  {intro && <p class="qq-intro">{intro}</p>}

  {/* The error summary. Always in the DOM with a reserved height, so showing
      it moves nothing — an error that shifts the layout moves the field the
      visitor is about to correct. */}
  <div class="qq-summary" data-qq-summary role="alert" aria-live="assertive" tabindex="-1"></div>

  <div class="qq-row">
    <div class="qq-field">
      <label class="qq-label" for={f('first')}>First name <span class="qq-req">*</span></label>
      <input
        type="text"
        id={f('first')}
        name="first-name"
        autocomplete="given-name"
        autocapitalize="words"
        placeholder="Jane"
        required
        aria-describedby={f('first-error')}
      />
      <p class="qq-error" id={f('first-error')} data-qq-error="first-name"></p>
    </div>

    <div class="qq-field">
      <label class="qq-label" for={f('last')}>Last name <span class="qq-req">*</span></label>
      <input
        type="text"
        id={f('last')}
        name="last-name"
        autocomplete="family-name"
        autocapitalize="words"
        placeholder="Doe"
        required
        aria-describedby={f('last-error')}
      />
      <p class="qq-error" id={f('last-error')} data-qq-error="last-name"></p>
    </div>
  </div>

  <div class="qq-row">
    <div class="qq-field">
      <label class="qq-label" for={f('phone')}>Mobile phone <span class="qq-req">*</span></label>
      <input
        type="tel"
        id={f('phone')}
        name="phone"
        inputmode="tel"
        autocomplete="tel"
        {/* A FORMAT MASK, NOT AN EXAMPLE NUMBER. An earlier attempt used a
            plausible-looking 416 number and `landing-pages.test.ts` caught
            it: these pages must show exactly one telephone number, the real
            one, so a second set of digits on screen is a number a visitor
            could read as the client's. The reference masks it the same way. */}
        placeholder="+1 XXX XXX XXXX"
        required
        aria-describedby={f('phone-error')}
      />
      <p class="qq-error" id={f('phone-error')} data-qq-error="phone"></p>
    </div>

    <div class="qq-field">
      <label class="qq-label" for={f('email')}>Email <span class="qq-req">*</span></label>
      <input
        type="email"
        id={f('email')}
        name="email"
        inputmode="email"
        autocomplete="email"
        spellcheck="false"
        placeholder="jane@yourcompany.com"
        required
        aria-describedby={f('email-error')}
      />
      <p class="qq-error" id={f('email-error')} data-qq-error="email"></p>
    </div>
  </div>

  <div class="qq-field">
    <label class="qq-label" for={f('message')}>
      Cleaning needs <span class="qq-req">*</span>
    </label>
    <textarea
      id={f('message')}
      name="message"
      rows="4"
      placeholder="How can we help? Please describe your facility type and the main cleaning challenges you'd like us to solve."
      required
      aria-describedby={f('message-error')}></textarea>
    <p class="qq-error" id={f('message-error')} data-qq-error="message"></p>
  </div>


  {/*
    Express consent to marketing email — optional, and unticked.

    WHY IT IS HERE AT ALL. Canada's anti-spam law needs express consent before
    a commercial electronic message, and the burden of proving it sits with the
    sender. The enquiry itself does not need a box: someone asking for a quote
    plainly expects a reply, which is implied consent under PIPEDA. This box is
    only about email that is marketing.

    WHY IT IS NOT REQUIRED AND NOT PRE-TICKED. A pre-ticked box is not express
    consent under CASL, and a required one is a hard gate on a paid click. The
    reference design this was modelled on also carries a REQUIRED
    "store and process my personal data" box; that is a GDPR pattern and it is
    deliberately not copied here.

    The wording is submitted with the form, not just the boolean, so a row can
    always say what its sender actually agreed to even after this copy changes.
  */}
  <div class="qq-consent">
    <input type="checkbox" id={f('consent')} name="marketing-consent" value="yes" />
    <label for={f('consent')}>{CONSENT_TEXT}</label>
  </div>

  {/* Honeypot. A person never sees it, so anything in it is a bot. */}
  <div class="qq-hp" aria-hidden="true">
    <label for={f('hp')}>Company website</label>
    <input type="text" id={f('hp')} name="company-website" tabindex="-1" autocomplete="off" />
  </div>

  <SpamGuard eager={eagerCaptcha} />

  <button class="qq-submit" type="submit">{submitLabel}</button>

  <p class="qq-after">
    An account executive reads this and replies within <strong>2 business hours</strong> on a
    working day. No obligation, and no visit until you ask for one. Prefer to talk now?{' '}
    <a href={nap.phoneHref} data-call-location="form_note">Call {nap.phoneDisplay}</a>.
  </p>
</form>

<script>
  /* Wired here rather than by `FormRuntime`, which binds every
     `form[data-endpoint]` with the browser's own validation bubbles. This
     form renders its own inline messages and needs the cross-field
     "phone or email" rule, so it brings its own wiring — and `FormRuntime`
     skips it, because `wireLeadForm` refuses a form it has already bound and
     this script runs first. */
  import { wireQuickQuote } from '../lib/quick-quote';

  document
    .querySelectorAll<HTMLFormElement>('form[data-quick-quote]')
    .forEach((form) => wireQuickQuote(form));
</script>

<style>
  .qq {
    margin: 0;
  }

  .qq-heading {
    margin: 0 0 6px;
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1.25;
    color: var(--ink-heading);
  }

  .qq-intro {
    margin: 0 0 20px;
    color: var(--ink);
    line-height: 1.6;
  }

  /* Reserved, so revealing an error shifts nothing. */
  .qq-summary {
    min-height: 0;
    margin: 0;
  }

  .qq-summary:not(:empty) {
    min-height: auto;
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #d9534f;
    border-left-width: 4px;
    border-radius: var(--radius);
    background: #fdf3f3;
    color: #a94442;
    line-height: 1.5;
  }

  .qq-summary:focus-visible {
    outline: 2px solid #a94442;
    outline-offset: 2px;
  }

  .qq-row {
    display: grid;
    gap: 0 18px;
  }

  @media (min-width: 560px) {
    .qq-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .qq-field {
    margin: 0 0 14px;
    min-width: 0;
  }

  .qq-contact {
    margin: 0 0 6px;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .qq-label {
    display: block;
    padding: 0;
    margin: 0 0 5px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.4px;
    color: var(--ink-heading);
  }

  .qq-sublabel {
    display: block;
    margin: 0 0 5px;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }

  .qq-hint {
    display: block;
    margin-top: 2px;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--ink);
  }

  .qq-req {
    color: #c0392b;
  }

  .qq-optional {
    font-weight: 400;
    font-size: 12.5px;
    color: var(--ink);
  }

  .qq input[type='text'],
  .qq input[type='tel'],
  .qq input[type='email'],
  .qq select,
  .qq textarea {
    width: 100%;
    max-width: 100%;
    /* 48px: comfortably over the 24px minimum, and the size a thumb expects. */
    min-height: 48px;
    padding: 13px 14px;
    /* FILLED, NOT OUTLINED. The field is described by its own tint rather
       than by a rule around it, so a column of inputs reads as a stack of
       targets instead of a stack of boxes.

       #ebf2fa IS MEASURED, not chosen. Sampled from the reference design's
       own screenshot: nine probes across all six inputs and the textarea
       returned the identical value, so it is the fill, not an artefact of
       one compressed pixel.

       A first attempt used a neutral green-grey (#eef1ec) on the reasoning
       that the reference's blue is its own brand colour. Side by side that
       was wrong in the way that matters: at that lightness the field barely
       separated from white, so the form read as a page with text on it
       rather than as a set of boxes to fill. The blue is doing structural
       work here, not brand work — it says "this is where you type" — and it
       sits under Evergreen's green without competing for it. The button
       stays green; only the boxes are the reference's. */
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: #ebf2fa;
    font-family: inherit;
    font-size: 16px; /* under 16px, iOS zooms the page on focus */
    color: var(--ink-heading);
    transition:
      background 0.15s ease,
      border-color 0.15s ease;
  }

  /* The border is transparent rather than absent so focus and error states
     have something to colour without the field changing size. */
  .qq input[type='text']:hover,
  .qq input[type='tel']:hover,
  .qq input[type='email']:hover,
  .qq select:hover,
  .qq textarea:hover {
    /* One step deeper than the resting fill, enough to register under a
       cursor without becoming a second state to read. */
    background: #e2ecf8;
  }

  /* A placeholder is a hint, never the label — every field above keeps its
     own <label for>. Kept well clear of the text colour so the two are never
     mistaken for one another. */
  .qq ::placeholder {
    /* Measured off the reference at #757575 — the darkest pixel inside three
       separate placeholder runs, every time. Neutral rather than tinted,
       which is what keeps it reading as a hint instead of as a fourth colour
       in the field.

       SHIPPED ONE STEP DARKER, and this is the one place the reference is
       not copied exactly. #757575 on #ebf2fa computes to 4.08:1, under the
       4.5:1 WCAG AA wants for text this size; #6b6b6b is 4.72:1. The two are
       indistinguishable side by side, so the difference costs nothing and
       buys a form that is readable to someone whose eyesight is not the
       designer's. */
    color: #6b6b6b;
    opacity: 1; /* Firefox dims placeholders by default */
  }

  .qq textarea {
    min-height: 84px;
    resize: vertical;
    line-height: 1.5;
  }

  .qq input:focus-visible,
  .qq select:focus-visible,
  .qq textarea:focus-visible,
  .qq-submit:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .qq [aria-invalid='true'] {
    border-color: #c0392b;
    background: #fffafa;
  }

  /* Reserved height, again: the message appears into space already held. */
  .qq-error {
    min-height: 1.15rem;
    margin: 3px 0 0;
    font-size: 12.5px;
    line-height: 1.15rem;
    color: #a94442;
  }

  .qq-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Marketing consent. Optional, unticked, and visually quieter than the
     fields — it is an offer, not another thing to fill in. */
  .qq-consent {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-top: 4px;
  }

  .qq-consent input {
    flex: none;
    /* 18px and nudged down to sit on the first line of the label, which wraps
       to two or three lines at phone width. */
    width: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--brand);
  }

  .qq-consent label {
    font-size: 13px;
    line-height: 1.45;
    color: var(--ink);
  }

  .qq-submit {
    width: 100%;
    min-height: 52px;
    margin-top: 6px;
    border: 0;
    border-radius: var(--radius);
    background: var(--brand);
    color: #fff;
    padding: 15px 22px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.4px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .qq-submit:hover:not(:disabled) {
    background: var(--brand-dark);
  }

  .qq-submit:disabled {
    opacity: 0.75;
    cursor: progress;
  }

  @media (min-width: 560px) {
    .qq-submit {
      width: auto;
      min-width: 260px;
    }
  }

  .qq-after {
    margin: 14px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--ink);
  }

  .qq-after a {
    color: var(--brand);
    font-weight: 700;
  }
</style>

<style is:global>
  /* Replaces the form on success, so it is not scoped to this component. */
  .qq-confirm {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border: 1px solid var(--brand);
    border-left-width: 4px;
    border-radius: var(--radius);
    background: #f2f8ee;
    line-height: 1.6;
    color: var(--ink-heading);
  }

  .qq-confirm strong {
    font-family: var(--font-heading);
    font-size: 1.125rem;
  }

  .qq-confirm a {
    color: var(--brand);
    font-weight: 700;
  }

  .qq-confirm:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 3px;
  }
</style>
