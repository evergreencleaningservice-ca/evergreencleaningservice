---
/**
 * The quote form — WPForms form **1381**.
 *
 * WHICH VERSION. The archive holds two generations of this form, and an
 * earlier pass here took the wrong one. Captures from December 2023 to July
 * 2024 show seven services and no address block; captures from April 2025 to
 * October 2025 show **eight services and an address block**. The later shape
 * is the current one, and it is what this builds. (The giveaway was that 46 of
 * the archived pages carry the old shape and only 5 carry the new one — the
 * majority is the older site, not the current one.)
 *
 * Its fields, in the original's order:
 *
 *   Name *                First / Last
 *   Name of Business *
 *   Address *             Address Line 1 ("Street address & unit #"), City,
 *                         State ("Ontario"), Postal Code, Country (CA)
 *   Email *               before Phone here; form 1384 has them the other way
 *   Phone *
 *   I'm interested a quote for these services   eight, not required
 *   Additional comments                          not required
 *   Custom Captcha *      "What is 7+2?" — the contact form asks 7+1
 *
 * Format is WPForms's, shared with the contact form: the field label above in
 * 11px/600 uppercase on 2px tracking, and each sub-label BELOW its input.
 *
 * `variant="sidebar"` is the narrow-column rendering the original uses in the
 * sidebar — the same form, stacked.
 *
 * The original's "What is 7+2?" arithmetic question is REMOVED, on instruction,
 * to take friction off every form on the site. It was never the protection: the
 * expected answer is emitted into the page beside the question. The honeypot
 * and the reCAPTCHA checkbox are what guard this form.
 *
 * WIRED UP. Posts to /api/submit-lead — the endpoint the PPC form already
 * used — via `FormRuntime.astro`, and is guarded by the reCAPTCHA v2 checkbox
 * the original carries. It spent the port with `action="#"`, which validated in
 * the browser and then dropped the enquiry; that was the launch blocker named
 * in HANDOFF §7.1.
 *
 * `action` stays "#" as a no-JS fallback that does nothing rather than posting
 * the visitor's details somewhere that will not receive them. The original has
 * no no-JS path either — WPForms needs its own script to submit.
 */
import { countries, DEFAULT_COUNTRY } from '../data/countries';
import { site } from '../data/site';
import SpamGuard from './SpamGuard.astro';
import FormRuntime from './FormRuntime.astro';

interface Props {
  variant?: 'page' | 'sidebar';
  id?: string;
}

const { variant = 'page', id = 'quote' } = Astro.props;
const f = (name: string) => `${id}-${name}`;

/** The original's eight, in its order. */
const services = [
  'Office Cleaning',
  'Commercial Cleaning',
  'Property Management and Building Maintenance',
  'Janitorial Services',
  'Commercial Carpet Cleaning',
  'Floor Services / Finishing',
  'Reno Construction Clean-up',
  'Other',
];

---

<form
  class:list={['wpf', 'quote-form', variant === 'sidebar' && 'is-sidebar']}
  method="post"
  action="#"
  data-endpoint="/api/submit-lead"
  data-form-id="quote-form-1381"
  aria-label="Request a quote"
>
  <fieldset class="wpf-field">
    <legend class="wpf-label">Name <span class="wpf-req" aria-hidden="true">*</span></legend>
    <div class="wpf-row wpf-row-2">
      <div class="wpf-col">
        <input type="text" id={f('first')} name="first-name" autocomplete="given-name" required />
        <label class="wpf-sub" for={f('first')}>First</label>
      </div>
      <div class="wpf-col">
        <input type="text" id={f('last')} name="last-name" autocomplete="family-name" required />
        <label class="wpf-sub" for={f('last')}>Last</label>
      </div>
    </div>
  </fieldset>

  <div class="wpf-field">
    <label class="wpf-label" for={f('business')}>
      Name of Business <span class="wpf-req" aria-hidden="true">*</span>
    </label>
    <input type="text" id={f('business')} name="business-name" autocomplete="organization" required />
  </div>

  <fieldset class="wpf-field">
    <legend class="wpf-label">Address <span class="wpf-req" aria-hidden="true">*</span></legend>

    <div class="wpf-row">
      <div class="wpf-col">
        <input
          type="text"
          id={f('address1')}
          name="address1"
          placeholder="Street address &amp; unit #"
          autocomplete="address-line1"
          required
        />
        <label class="wpf-sub" for={f('address1')}>Address Line 1</label>
      </div>
    </div>

    <div class="wpf-row wpf-row-2">
      <div class="wpf-col">
        <input type="text" id={f('city')} name="city" autocomplete="address-level2" required />
        <label class="wpf-sub" for={f('city')}>City</label>
      </div>
      <div class="wpf-col">
        <input
          type="text"
          id={f('state')}
          name="state"
          value="Ontario"
          autocomplete="address-level1"
          required
        />
        <label class="wpf-sub" for={f('state')}>State / Province / Region</label>
      </div>
    </div>

    <div class="wpf-row wpf-row-2">
      <div class="wpf-col">
        <input type="text" id={f('postal')} name="postal" autocomplete="postal-code" required />
        <label class="wpf-sub" for={f('postal')}>Postal Code</label>
      </div>
      <div class="wpf-col">
        <select id={f('country')} name="country" autocomplete="country" required>
          {
            countries.map((c) => (
              <option value={c.code} selected={c.code === DEFAULT_COUNTRY}>
                {c.name}
              </option>
            ))
          }
        </select>
        <label class="wpf-sub" for={f('country')}>Country</label>
      </div>
    </div>
  </fieldset>

  <div class="wpf-field">
    <label class="wpf-label" for={f('email')}>
      Email <span class="wpf-req" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id={f('email')}
      name="email"
      inputmode="email"
      autocomplete="email"
      spellcheck="false"
      required
    />
  </div>

  <div class="wpf-field">
    <label class="wpf-label" for={f('phone')}>
      Phone <span class="wpf-req" aria-hidden="true">*</span>
    </label>
    <input type="tel" id={f('phone')} name="phone" inputmode="tel" autocomplete="tel" required />
  </div>

  <fieldset class="wpf-field">
    <legend class="wpf-label">I'm interested a quote for these services</legend>
    <ul class="wpf-choices">
      {
        services.map((s, i) => (
          <li>
            <input type="checkbox" id={f('svc' + i)} name="services" value={s} />
            <label for={f('svc' + i)}>{s}</label>
          </li>
        ))
      }
    </ul>
  </fieldset>

  <div class="wpf-field">
    <label class="wpf-label" for={f('comments')}>Additional comments</label>
    <textarea id={f('comments')} name="comments" rows={variant === 'sidebar' ? 3 : 5}></textarea>
  </div>

  {/* Honeypot, as the original has. Real people never see it. */}
  <div class="wpf-hp" aria-hidden="true">
    <label for={f('hp')}>Message</label>
    <input type="text" id={f('hp')} name="company-website" tabindex="-1" autocomplete="off" />
  </div>

  <SpamGuard />

  <button class="wpf-submit" type="submit">Submit</button>
</form>

<FormRuntime />

<style>
  .wpf {
    margin: 0;
  }

  .wpf-note {
    font-size: 14px;
    color: var(--ink);
    margin: 0 0 20px;
  }

  .wpf-field {
    margin: 0 0 20px;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .wpf-label {
    display: block;
    padding: 0;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--ink);
    margin-bottom: 4px;
  }

  .wpf-sub {
    display: block;
    font-family: var(--font-heading);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--ink);
    margin-top: 4px;
  }

  .wpf-req {
    color: #f00;
  }

  .wpf-row {
    display: grid;
    gap: 0 20px;
    margin-bottom: 10px;
  }

  .wpf-row:last-child {
    margin-bottom: 0;
  }

  @media (min-width: 480px) {
    .wpf:not(.is-sidebar) .wpf-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  .wpf input[type='text'],
  .wpf input[type='tel'],
  .wpf input[type='email'],
  .wpf select,
  .wpf textarea {
    width: 100%;
    max-width: 100%;
    height: 38px;
    padding: 10px;
    border: 0;
    border-radius: 2px;
    background: #f2f2f2;
    font-family: inherit;
    font-size: 15px;
    color: #000;
  }

  .wpf textarea {
    height: 215px;
    resize: vertical;
  }

  .is-sidebar textarea {
    height: 110px;
  }

  .wpf input:focus-visible,
  .wpf select:focus-visible,
  .wpf textarea:focus-visible,
  .wpf-submit:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .wpf-choices {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .wpf-choices li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
  }

  .wpf-choices input {
    flex: none;
    margin-top: 3px;
  }

  .wpf-choices label {
    font-size: 15px;
    color: var(--ink);
  }


  .wpf-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .wpf-submit {
    border: 0;
    border-radius: 2px;
    background: var(--brand);
    color: #fff;
    padding: 15px 23px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .wpf-submit:hover {
    background: var(--brand-hover, #3f7523);
  }
</style>
