---
/**
 * The Request Quote form, matching the original's field set exactly.
 *
 * The original was a WPForms embed appearing both on /request-a-quote/ and in
 * the sidebar of every inner page, so this is one component used in both
 * places. `variant="sidebar"` is the narrow column rendering — same fields,
 * tighter layout.
 *
 * TODO: the submit endpoint still needs wiring. The original posted to
 * WordPress; nothing here delivers yet, and the note in the markup says so
 * rather than pretending otherwise.
 */
import { site } from '../data/site';

interface Props {
  variant?: 'page' | 'sidebar';
  id?: string;
}

const { variant = 'page', id = 'quote' } = Astro.props;

/** The original's services checklist, in its order. */
// The original's seven, in its order. An earlier pass had eight, with
// "Property Management and Building Maintenance" added and the first two
// swapped.
const services = [
  'Commercial Cleaning',
  'Office Cleaning',
  'Janitorial Services',
  'Commercial Carpet Cleaning',
  'Floor Services / Finishing',
  'Reno Construction Clean-up',
  'Other',
];

// The original used a WPForms "custom captcha" — a small arithmetic question.
// Kept so the ported form has the same anti-spam step; the answer is checked
// server-side once the endpoint exists.
const captcha = { a: 7, b: 2 };
const f = (name: string) => `${id}-${name}`;
---

<form
  class:list={['quote-form', variant === 'sidebar' && 'is-sidebar']}
  method="post"
  action="#"
  aria-label="Request a quote"
>
  <p class="form-note" role="note">
    This form is not connected yet, so a submission will not reach us. Please call
    <a href={site.phoneHref}>{site.phone}</a> or email
    <a href={`mailto:${site.email}`}>{site.email}</a> in the meantime.
  </p>

  <fieldset class="field-group">
    <legend>Name <span class="req" aria-hidden="true">*</span></legend>
    <div class="row row-2">
      <div class="field">
        <label for={f('first')}>First</label>
        <input type="text" id={f('first')} name="first-name" autocomplete="given-name" required />
      </div>
      <div class="field">
        <label for={f('last')}>Last</label>
        <input type="text" id={f('last')} name="last-name" autocomplete="family-name" required />
      </div>
    </div>
  </fieldset>

  <div class="field">
    <label for={f('business')}>Name of Business <span class="req" aria-hidden="true">*</span></label>
    <input type="text" id={f('business')} name="business" autocomplete="organization" required />
  </div>


  <div class="row row-2">
    <div class="field">
      <label for={f('email')}>Email <span class="req" aria-hidden="true">*</span></label>
      <input
        type="email"
        id={f('email')}
        name="email"
        inputmode="email"
        autocomplete="email"
        spellcheck="false"
        required
      />
    </div>
    <div class="field">
      <label for={f('phone')}>Phone <span class="req" aria-hidden="true">*</span></label>
      <input type="tel" id={f('phone')} name="phone" inputmode="tel" autocomplete="tel" required />
    </div>
  </div>

  <fieldset class="field-group">
    <legend>I'm interested a quote for these services</legend>
    <ul class="choices">
      {
        services.map((s, i) => (
          <li>
            <input type="checkbox" id={f('svc' + i)} name="services" value={s} />
            <label for={f('svc' + i)}>{s}</label>
          </li>
        ))
      }
    </ul>
  </fieldset>

  <div class="field">
    <label for={f('comments')}>Additional comments</label>
    <textarea id={f('comments')} name="comments" rows={variant === 'sidebar' ? 3 : 5}></textarea>
  </div>

  <div class="field">
    <label for={f('captcha')}>
      Custom Captcha <span class="req" aria-hidden="true">*</span>
    </label>
    <p class="captcha-q">What is {captcha.a}+{captcha.b}?</p>
    <input
      type="text"
      id={f('captcha')}
      name="captcha"
      inputmode="numeric"
      autocomplete="off"
      required
    />
    <input type="hidden" name="captcha-sum" value={captcha.a + captcha.b} />
  </div>

  {/* Honeypot, as the original had. Real people never see it. */}
  <div class="honeypot" aria-hidden="true">
    <label for={f('hp')}>Leave this field empty</label>
    <input type="text" id={f('hp')} name="company-website" tabindex="-1" autocomplete="off" />
  </div>

  <button class="btn btn-primary" type="submit">Submit</button>
</form>

<style>
  .quote-form {
    max-width: 640px;
  }

  .is-sidebar {
    max-width: none;
  }

  .form-note {
    font-size: 13px;
    color: var(--ink);
    margin: 0 0 14px;
  }

  .req {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .field-group {
    /* Fieldsets default to min-width: min-content, which forces horizontal
       scroll in a narrow column. */
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0 0 14px;
  }

  .field-group legend,
  .field label {
    display: block;
    padding: 0;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink-heading);
    margin-bottom: 4px;
  }

  .field-group legend {
    margin-bottom: 8px;
  }

  .field {
    margin-bottom: 12px;
  }

  .row {
    display: grid;
    gap: 0 12px;
  }

  @media (min-width: 560px) {
    .quote-form:not(.is-sidebar) .row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  select,
  textarea {
    width: 100%;
    max-width: 100%;
    font: inherit;
    font-size: 15px;
    color: inherit;
    background: #fff;
    padding: 8px 10px;
    border: 1px solid #cdd2d7;
    border-radius: var(--radius);
  }

  .is-sidebar input,
  .is-sidebar select,
  .is-sidebar textarea {
    font-size: 14px;
    padding: 7px 9px;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .choices {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .choices li {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 6px;
  }

  .choices input {
    width: auto;
    margin-top: 3px;
    flex: none;
  }

  .choices label {
    margin: 0;
    font-weight: 400;
    font-size: 14px;
    color: var(--ink);
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .captcha-q {
    font-size: 14px;
    margin: 0 0 4px;
  }

  .quote-form .btn {
    margin-top: 6px;
  }

  .is-sidebar .btn {
    width: 100%;
  }
</style>
