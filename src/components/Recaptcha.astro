---
/**
 * The reCAPTCHA v2 checkbox, in the place WPForms puts it: after the honeypot,
 * immediately before the submit button.
 *
 * The original's container, for reference —
 *
 *   <div class="wpforms-recaptcha-container wpforms-is-recaptcha wpforms-is-recaptcha-type-v2">
 *     <div class="g-recaptcha" data-sitekey="…"></div>
 *     <input type="text" name="g-recaptcha-hidden" class="wpforms-recaptcha-hidden" …>
 *   </div>
 *
 * — reproduced below with this site's own `wpf-` class prefix. `g-recaptcha` is
 * kept exactly, because Google's own script selects on it.
 *
 * WHY EXPLICIT RENDER rather than letting api.js find the widgets itself: the
 * homepage carries two forms (the contact form in the page, the quote form in
 * the sidebar), and a service page carries the sidebar form beside its own.
 * Automatic rendering handles multiple widgets badly and gives no hook for
 * writing the token somewhere a submit handler can read it. The original uses
 * `render=explicit` for the same reason.
 *
 * The hidden input is the contract with `FormRuntime.astro`: Google's callback
 * writes the token into it, the expiry and error callbacks clear it, and the
 * submit handler refuses to post without it. That mirrors WPForms's own
 * `g-recaptcha-hidden` field, which exists so the form's validator has
 * something to validate.
 */
import { recaptcha } from '../data/site';

/* The client's key is domain-locked to evergreencleaningservice.ca, so it is
   opt-in through the environment rather than the default — see the note in
   src/data/site.ts. Unset, this is Google's test key, which renders a real
   widget carrying Google's own "for testing purposes only" banner. */
const siteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY || recaptcha.testSiteKey;
---

<div class="wpf-recaptcha wpf-field">
  <p class="wpf-recaptcha-wait">The “I’m not a robot” check appears here when you start filling in the form.</p>
  <div class="g-recaptcha" data-sitekey={siteKey}></div>
  <input
    type="text"
    name="g-recaptcha-hidden"
    class="wpf-recaptcha-hidden"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    required
  />
</div>

<script is:inline>
  /* Inline and idempotent. A page can hold two of these components; the loader
     must run once, and `grecaptcha.render()` must not be called twice on the
     same element — reCAPTCHA throws on that and takes the rest of the page's
     scripts down with it.

     LOADED ON INTENT, NOT ON ARRIVAL (2026-10-15). api.js used to be injected
     on first paint of every page carrying a form — the sidebar quote form puts
     one on every inner page. One v2 widget costs three copies of
     recaptcha__en.js (the page, the anchor iframe and the challenge iframe:
     separate frames, not a coding duplicate), ~700KB on the wire and, measured
     on the live homepage under Lighthouse's mobile throttling, ~1.4s of
     main-thread scripting before anyone has looked at a form.

     It now loads on whichever comes first:
       - the checkbox's slot comes within 300px of the viewport, so a visible
         checkbox is always a working checkbox; or
       - anything inside the form is focused, pressed or typed into.
     The slot keeps its 78px reserved height, so nothing shifts when the
     widget arrives, and the Worker still verifies every token server-side —
     nothing about the protection itself changed. */
  (function () {
    if (window.__wpfRecaptcha) return;
    window.__wpfRecaptcha = true;

    var MESSAGE = 'Please confirm you are not a robot.';

    window.wpfRecaptchaLoad = function () {
      document.querySelectorAll('.g-recaptcha').forEach(function (el) {
        if (el.dataset.wpfRendered) return;
        el.dataset.wpfRendered = '1';

        var hidden = el.parentNode.querySelector('.wpf-recaptcha-hidden');
        var set = function (value) {
          if (!hidden) return;
          hidden.value = value;
          /* The field is `required`, so clearing it after an expiry is what
             re-blocks the submit button without any state of our own. */
          hidden.setCustomValidity(value ? '' : MESSAGE);
        };
        set('');

        var wait = el.parentNode.querySelector('.wpf-recaptcha-wait');
        if (wait) wait.hidden = true;

        try {
          el.dataset.wpfWidgetId = window.grecaptcha.render(el, {
            sitekey: el.dataset.sitekey,
            callback: set,
            'expired-callback': function () {
              set('');
            },
            'error-callback': function () {
              set('');
            },
          });
        } catch (err) {
          /* An invalid domain, a blocked script, a key that was deleted. Do not
             leave the form permanently unsubmittable over it — drop the
             requirement and say why in the console, where a reviewer looking
             for "why is there no checkbox" will find it. */
          if (hidden) {
            hidden.required = false;
            hidden.setCustomValidity('');
          }
          if (window.console) console.warn('recaptcha: widget did not render —', err);
        }
      });
    };

    var injected = false;
    function inject() {
      if (injected) return;
      injected = true;
      var s = document.createElement('script');
      s.src = 'https://www.google.com/recaptcha/api.js?onload=wpfRecaptchaLoad&render=explicit';
      s.async = true;
      s.defer = true;
      document.head.appendChild(s);
    }
    window.wpfRecaptchaInject = inject;

    function arm() {
      var slots = document.querySelectorAll('.g-recaptcha');
      if (!slots.length) return;

      for (var i = 0; i < slots.length; i++) {
        /* Until the widget renders, a submit attempt explains itself rather
           than reporting an anonymous "fill out this field". */
        var hidden = slots[i].parentNode.querySelector('.wpf-recaptcha-hidden');
        if (hidden && !hidden.value) hidden.setCustomValidity(MESSAGE);
        if (slots[i].hasAttribute('data-eager')) { inject(); return; }

        var form = slots[i].closest('form') || slots[i];
        form.addEventListener('focusin', inject, { once: true });
        form.addEventListener('pointerdown', inject, { once: true });
        form.addEventListener('input', inject, { once: true });
      }

      /* The viewport trigger is armed by the visitor's first scroll, not on
         arrival. On the paid pages the form sits in the first screen; armed
         at once, the observer fired on load and every paid click paid the
         full reCAPTCHA cost before reading a word (measured: no change in
         blocking time on /lp/commercial-cleaning-quote/). Someone who has
         not scrolled reaches the checkbox only by filling the fields above
         it, which triggers the load through focus. */
      function observe() {
        if (!('IntersectionObserver' in window)) { inject(); return; }
        var io = new IntersectionObserver(function (entries) {
          for (var k = 0; k < entries.length; k++) {
            if (entries[k].isIntersecting) { inject(); io.disconnect(); return; }
          }
        }, { rootMargin: '300px 0px' });
        for (var m = 0; m < slots.length; m++) io.observe(slots[m]);
      }
      window.addEventListener('scroll', observe, { once: true, passive: true });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', arm, { once: true });
    } else {
      arm();
    }
  })();
</script>

<style>
  .wpf-recaptcha {
    /* The widget is a fixed 304x78 iframe; this keeps the row from collapsing
       before it loads and the form jumping when it does. */
    min-height: 78px;
    position: relative;
  }

  /* Sits in the reserved box until the widget renders, so the empty space
     explains itself. Absolutely placed: hiding it moves nothing. */
  .wpf-recaptcha-wait {
    position: absolute;
    inset: 0 auto auto 0;
    max-width: 304px;
    margin: 0;
    padding: 10px 12px;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--ink);
    border: 1px dashed var(--rule);
    border-radius: 4px;
  }

  /* Visually hidden, but focusable enough for the browser to report its
     validation message against — `display:none` would make the `required`
     silently unenforceable and the submit button dead with no explanation. */
  .wpf-recaptcha-hidden {
    position: absolute !important;
    clip: rect(0, 0, 0, 0) !important;
    height: 1px !important;
    width: 1px !important;
    border: 0 !important;
    overflow: hidden !important;
    padding: 0 !important;
    margin: 0 !important;
  }
</style>
