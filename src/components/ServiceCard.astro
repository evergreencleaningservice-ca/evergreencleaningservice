---
/**
 * Service teaser, used by the /services/ landing page.
 * Pass a services collection entry: <ServiceCard service={service} loading="eager" />
 */
import type { CollectionEntry } from 'astro:content';
import { existsSync } from 'node:fs';
import path from 'node:path';

interface Props {
  service: CollectionEntry<'services'>;
  /** Use "eager" for cards that are above the fold. */
  loading?: 'lazy' | 'eager';
}

const { service, loading = 'lazy' } = Astro.props;
const { title, description, image, imageAlt } = service.data;

const href = `/services/${service.id}/`;

/* A photo with -480/-768 siblings in public/images is served responsively;
   the full 1200x800 JPEG was being sent to a 360px-wide card. */
const base = image?.match(/^\/images\/(.+)\.jpg$/)?.[1];
const sized = !!base && existsSync(path.join(process.cwd(), 'public/images', `${base}-480.avif`));
const set = (ext: string) => `/images/${base}-480.${ext} 480w, /images/${base}-768.${ext} 768w`;
const SIZES = '(min-width: 992px) 300px, (min-width: 768px) 50vw, 100vw';
---

<article class="service-card">
  {
    image ? (
      <a class="service-card-thumb" href={href} tabindex="-1" aria-hidden="true">
        <picture>
          {sized && <source type="image/avif" srcset={set('avif')} sizes={SIZES} />}
          {sized && <source type="image/webp" srcset={set('webp')} sizes={SIZES} />}
          {!sized && /-card\.jpg$/.test(image) && <source type="image/avif" srcset={image.replace(/\.jpg$/, '.avif')} />}
          {!sized && /-card\.jpg$/.test(image) && <source type="image/webp" srcset={image.replace(/\.jpg$/, '.webp')} />}
          <img
            src={sized ? `/images/${base}-480.jpg` : image}
            srcset={sized ? set('jpg') : undefined}
            sizes={sized ? SIZES : undefined}
            alt={imageAlt ?? title}
            width="640"
            height="400"
            loading={loading}
            decoding="async"
          />
        </picture>
      </a>
    ) : (
      /* A service with no photo yet (pressure washing and graffiti removal
         had none until 31 Oct 2026). A tinted panel the size of a photo keeps the row even;
         without it the card was a tall empty white box beside its neighbours.
         An unrelated photo would be worse than none. */
      <a class="service-card-thumb is-placeholder" href={href} tabindex="-1" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="44" height="44">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 21c4.5-2.2 7-5.8 7-10.5V5.5L12 3 5 5.5v5C5 15.2 7.5 18.8 12 21Zm-3-9 2 2 4-4"
          />
        </svg>
      </a>
    )
  }
  <div class="service-card-body">
    <h2 class="service-card-title"><a href={href}>{title}</a></h2>
    {description && <p class="service-card-text">{description}</p>}
    <a class="service-card-more" href={href}>
      Learn more<span class="screen-reader-text"> about {title}</span>
    </a>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .service-card:hover,
  .service-card:focus-within {
    box-shadow: 0 8px 20px rgba(50, 50, 50, 0.12);
    transform: translateY(-2px);
  }

  .service-card-thumb {
    display: block;
    background: var(--surface-alt);
  }

  .service-card-thumb.is-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 8 / 5;
    background: linear-gradient(135deg, #eef5ea 0%, #dcebd3 100%);
    color: var(--brand);
  }

  .service-card-thumb img {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }

  .service-card-body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }

  .service-card-title {
    font-size: 1.25rem;
    margin: 0 0 10px;
  }

  .service-card-title a {
    color: var(--ink-heading);
  }

  .service-card-title a:hover,
  .service-card-title a:focus-visible {
    color: var(--brand);
  }

  .service-card-text {
    margin: 0 0 16px;
  }

  .service-card-more {
    margin-top: auto;
    align-self: flex-start;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--brand);
  }

  .service-card-more::after {
    content: ' \2192';
  }

  .service-card a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }
</style>
