---
/**
 * The inner-page sidebar, matching the original's <aside id="secondary">.
 *
 * Three widgets, in the original's order: search, Recent Posts and the tag
 * cloud. It appears on every inner page, service page and post — but not the
 * homepage, which the original renders full width.
 *
 * WHAT THIS USED TO BE, because the correction is worth recording. The third
 * widget was a "Request Quote" form, which the original does not have
 * anywhere in its sidebar, and the tag cloud the original DOES have was
 * dropped. The reasoning for dropping it was sound as far as it went: the
 * cloud rendered 26 links on 63 pages, and with `/tag/*` a blanket 301 to
 * `/category/blog/` every one of them led to the same place — 26 different
 * words all meaning "the blog".
 *
 * But the fix for links that all go to one page is to build the pages, not to
 * delete the links and quietly put a lead form in their place. The archives
 * now exist at `src/pages/tag/[tag]/[...page].astro`, so each word leads
 * somewhere different, which is what it looked like it did all along.
 *
 * THE `/tag/*` WILDCARD STAYS. It is the fallback for the nine tags the
 * original carries with zero posts (see `emptyTagSlugs`) and anything else
 * still pointed at from a backlink or Google's index: those land on the blog
 * archive in one hop rather than 404ing. The 26 real archives are static
 * assets, and `tests/build/tags.test.ts` pins that they serve rather than
 * being swallowed by the wildcard.
 */
import { getCollection } from 'astro:content';
import { tags } from '../data/tags';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<aside id="secondary" class="sidebar" aria-label="Sidebar">
  <section class="widget widget-search" aria-label="Search">
    <form class="search-form" role="search" action="/search/" method="get">
      <label class="screen-reader-text" for="sidebar-search">Search for:</label>
      {/* The original's own placeholder and a labelled "Search" button, not an
          icon. Its form GETs `?s=` at the site root, which a static build has
          nothing to answer with, so this posts to the port's own /search/
          page instead — the one difference here, and it is what makes the
          search work at all. */}
      <input
        type="search"
        id="sidebar-search"
        name="q"
        placeholder="Search &hellip;"
        autocomplete="off"
      />
      <input class="search-submit" type="submit" value="Search" />
    </form>
  </section>

  <section class="widget widget-recent">
    <h2 class="widget-title">Recent Posts</h2>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget widget-tags">
    <h2 class="widget-title">Tags</h2>
    {/* `.tagcloud` and the inline font-size are WordPress's own markup, kept
        so the cloud reads the way the original's does. The aria-label is the
        original's too: at 8pt the size carries no meaning for a screen
        reader, so the count is spoken instead. */}
    <div class="tagcloud">
      {
        tags.map((tag) => (
          <a
            href={`/tag/${tag.slug}/`}
            style={`font-size: ${tag.size}pt`}
            aria-label={`${tag.name} (${tag.count} ${tag.count === 1 ? 'item' : 'items'})`}
          >
            {tag.name}
          </a>
        ))
      }
    </div>
  </section>
</aside>

<style>
  .sidebar {
    min-width: 0;
  }

  .widget {
    margin-bottom: 40px;
  }

  .widget:last-child {
    margin-bottom: 0;
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 0 0 15px;
  }

  /* search */
  /* Measured on the original: a 43px row, the field on #f2f2f2 with no border
     or radius, the button brand green with a 2px radius and 15px/23px padding. */
  .search-form {
    display: flex;
  }

  .search-form input[type='search'] {
    flex: 1 1 auto;
    min-width: 0;
    height: 43px;
    border: 0;
    border-radius: 0;
    padding: 10px 15px;
    background: #f2f2f2;
    font: inherit;
    font-size: 15px;
    color: inherit;
  }

  .search-submit {
    flex: none;
    height: 43px;
    border: 0;
    border-radius: 2px;
    background: var(--brand);
    color: #fff;
    padding: 15px 23px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
  }

  .search-submit:hover {
    background: var(--brand-hover, #3f7523);
  }

  .search-form input:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  /* recent posts */
  .widget-recent ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .widget-recent li {
    padding: 8px 0;
    border-bottom: 1px solid #eee;
    font-size: 15px;
    line-height: 1.5;
  }

  .widget-recent li:last-child {
    border-bottom: 0;
  }

  .widget-recent a {
    color: var(--ink);
  }

  .widget-recent a:hover {
    color: var(--brand);
  }

  /* tag cloud */

  /* The SIZES are measured — each one is read off the original's rendered
     `.tagcloud`, where WordPress writes it inline, and they carry the whole
     point of a cloud: "commercial cleaning" is 22pt against 8pt for the
     twenty tags with a single post. See src/data/tags.ts.

     The COLOUR AND SPACING are this sidebar's own, matching the Recent Posts
     widget directly above: the original's theme stylesheet is not reachable
     to measure (its own /tag/ pages sit behind the origin's challenge, and
     the theme CSS path 404s), so rather than guess at numbers this follows
     the conventions already measured for the widget beside it. */
  .tagcloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
  }

  .tagcloud a {
    color: var(--ink);
    /* Sizes run 8pt to 22pt, so a shared line-height would either crowd the
       large ones or strand the small ones. Unitless scales with each. */
    line-height: 1.35;
  }

  .tagcloud a:hover,
  .tagcloud a:focus-visible {
    color: var(--brand);
  }
</style>
