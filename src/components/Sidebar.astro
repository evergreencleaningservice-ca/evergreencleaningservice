---
/**
 * The inner-page sidebar, after the original's <aside id="secondary">.
 *
 * Three widgets: search, Recent Posts and Our Services. It appears on inner
 * pages and posts; the homepage and the service pages (OfferPage) are full
 * width.
 *
 * The third widget was the original's tag cloud until 2026-11-03; why it is
 * now a list of service pages is written beside `serviceLinks`. The tag
 * archives (`src/pages/tag/[tag]/[...page].astro`) are untouched and still
 * linked from each post's own tag list.
 */
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

/* The sidebar's third widget, since 2026-11-03: the service pages, linked
   with the words people search for. It replaced the tag cloud, which put six
   links on every inner page to tag archives that are `noindex` — so every
   page passed weight to pages that cannot rank, under the very anchors
   ("commercial office cleaning", "janitorial services") the service pages
   need. The tag archives still exist and each post still links its own tags;
   only the sitewide cloud is gone.

   Janitorial has its own page since 10 Nov 2026 (competitor research: the
   searches are won by dedicated janitorial pages). */
const serviceLinks = [
  { label: 'Commercial office cleaning', href: '/office-cleaning/' },
  { label: 'Commercial cleaning', href: '/commercial-cleaning/' },
  { label: 'Janitorial services', href: '/janitorial-services/' },
  { label: 'Industrial cleaning', href: '/industrial-cleaning/' },
  { label: 'Building maintenance', href: '/building-maintenance/' },
  { label: 'Disinfection cleaning', href: '/disinfection-cleaning/' },
  { label: 'Post-construction cleaning', href: '/post-construction-cleaning/' },
] as const;
---

<aside id="secondary" class="sidebar" aria-label="Sidebar" data-reveal="flow">
  <section class="widget widget-search" aria-label="Search">
    <form class="search-form" role="search" action="/search/" method="get">
      <label class="screen-reader-text" for="sidebar-search">Search for:</label>
      {/* The original's own placeholder and a labelled "Search" button, not an
          icon. Its form GETs `?s=` at the site root, which a static build has
          nothing to answer with, so this posts to the port's own /search/
          page instead — the one difference here, and it is what makes the
          search work at all. */}
      <input
        type="search"
        id="sidebar-search"
        name="q"
        placeholder="Search &hellip;"
        autocomplete="off"
      />
      <input class="search-submit" type="submit" value="Search" />
    </form>
  </section>

  <section class="widget widget-recent">
    <h2 class="widget-title">Recent Posts</h2>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget widget-services">
    <h2 class="widget-title">Our Services</h2>
    <ul>
      {
        serviceLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </section>
</aside>

<style>
  .sidebar {
    min-width: 0;
  }

  .widget {
    margin-bottom: 40px;
  }

  .widget:last-child {
    margin-bottom: 0;
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 0 0 15px;
  }

  /* search */
  /* Measured on the original: a 43px row, the field on #f2f2f2 with no border
     or radius, the button brand green with a 2px radius and 15px/23px padding. */
  .search-form {
    display: flex;
  }

  .search-form input[type='search'] {
    flex: 1 1 auto;
    min-width: 0;
    height: 43px;
    border: 0;
    border-radius: 0;
    padding: 10px 15px;
    background: #f2f2f2;
    font: inherit;
    font-size: 15px;
    color: inherit;
  }

  .search-submit {
    flex: none;
    height: 43px;
    border: 0;
    border-radius: 2px;
    background: var(--brand);
    color: #fff;
    padding: 15px 23px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
    transition: background-color var(--motion-fast) ease;
  }

  /* `--brand-hover` is the bright #69ed3d, meant for green text on the dark
     footer; white text on it measures 1.6:1. The darker brand is the hover
     for every other solid green button on the site. */
  .search-submit:hover,
  .search-submit:focus-visible {
    background: var(--brand-dark);
  }

  .search-form input:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  /* recent posts */
  .widget-recent ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .widget-recent li {
    padding: 8px 0;
    border-bottom: 1px solid #eee;
    font-size: 15px;
    line-height: 1.5;
  }

  .widget-recent li:last-child {
    border-bottom: 0;
  }

  /* Both link lists: the row's link slides 4px right under the pointer, so
     a list of plain titles answers the mouse the way the cards do. */
  .widget-recent a,
  .widget-services a {
    color: var(--ink);
    display: inline-block;
    transition:
      color var(--motion-fast) ease,
      transform var(--motion-base) var(--ease-out);
  }

  .widget-recent a:hover,
  .widget-recent a:focus-visible {
    color: var(--brand);
  }

  @media (hover: hover) {
    .widget-recent a:hover,
    .widget-services a:hover {
      transform: translateX(4px);
    }
  }

  /* services: the Recent Posts list's own rows, so the two widgets match. */
  .widget-services ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .widget-services li {
    padding: 8px 0;
    border-bottom: 1px solid #eee;
    font-size: 15px;
    line-height: 1.5;
  }

  .widget-services li:last-child {
    border-bottom: 0;
  }

  .widget-services a:hover,
  .widget-services a:focus-visible {
    color: var(--brand);
  }

  /* On a phone or any touch screen the whole row is the link, at least 44px
     tall (SEO re-audit, 7 Nov 2026, visual N2: the links measured 23px in
     39px rows). The row's 8px padding moves from the item onto the link, so
     a two-line post title is exactly as tall as before; a one-line row grows
     from 39px to 45px with its border. A desktop with a mouse is unchanged. */
  @media (max-width: 767px), (pointer: coarse) {
    .widget-recent li,
    .widget-services li {
      padding-block: 0;
    }

    .widget-recent a,
    .widget-services a {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding-block: 8px;
    }
  }
</style>
