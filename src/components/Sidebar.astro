---
/**
 * The inner-page sidebar, matching the original's <aside id="secondary">.
 *
 * Three widgets, in the original's order: search, Recent Posts and a Request
 * Quote form. It appears on every inner page, service page and post — but not
 * the homepage, which the original renders full width.
 *
 * THE TAG CLOUD IS GONE, and this is the one place this component departs
 * from the original. It rendered 26 links on 63 pages — 1,638 internal links
 * — and every one of them went to the same place, because this port has no
 * tag taxonomy and `/tag/*` is a blanket 301 to `/category/blog/`. So it was
 * 26 different words all meaning "the blog", repeated site-wide: nothing for
 * a visitor to choose between, and a crawler spending its budget on 1,638
 * redirects to one page.
 *
 * The 301 STAYS. Removing the widget removes the links this site makes;
 * `/tag/<slug>/` addresses still exist out in the world — in backlinks,
 * bookmarks and Google's index — and they still land on the blog archive in
 * one hop. Deleting the rule would turn those into 404s, which is the
 * opposite of the point.
 */
import { getCollection } from 'astro:content';
import QuoteForm from './QuoteForm.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<aside id="secondary" class="sidebar" aria-label="Sidebar">
  <section class="widget widget-search" aria-label="Search">
    <form class="search-form" role="search" action="/search/" method="get">
      <label class="screen-reader-text" for="sidebar-search">Search for:</label>
      {/* The original's own placeholder and a labelled "Search" button, not an
          icon. Its form GETs `?s=` at the site root, which a static build has
          nothing to answer with, so this posts to the port's own /search/
          page instead — the one difference here, and it is what makes the
          search work at all. */}
      <input
        type="search"
        id="sidebar-search"
        name="q"
        placeholder="Search &hellip;"
        autocomplete="off"
      />
      <input class="search-submit" type="submit" value="Search" />
    </form>
  </section>

  <section class="widget widget-recent">
    <h2 class="widget-title">Recent Posts</h2>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}/`}>{post.data.title}</a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget widget-quote">
    <h2 class="widget-title">Request Quote</h2>
    <QuoteForm variant="sidebar" id="sidebar-quote" />
  </section>
</aside>

<style>
  .sidebar {
    min-width: 0;
  }

  .widget {
    margin-bottom: 40px;
  }

  .widget:last-child {
    margin-bottom: 0;
  }

  .widget-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    line-height: 1.1;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 0 0 15px;
  }

  /* search */
  /* Measured on the original: a 43px row, the field on #f2f2f2 with no border
     or radius, the button brand green with a 2px radius and 15px/23px padding. */
  .search-form {
    display: flex;
  }

  .search-form input[type='search'] {
    flex: 1 1 auto;
    min-width: 0;
    height: 43px;
    border: 0;
    border-radius: 0;
    padding: 10px 15px;
    background: #f2f2f2;
    font: inherit;
    font-size: 15px;
    color: inherit;
  }

  .search-submit {
    flex: none;
    height: 43px;
    border: 0;
    border-radius: 2px;
    background: var(--brand);
    color: #fff;
    padding: 15px 23px;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    line-height: 1;
    cursor: pointer;
  }

  .search-submit:hover {
    background: var(--brand-hover, #3f7523);
  }

  .search-form input:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: -2px;
  }

  /* recent posts */
  .widget-recent ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .widget-recent li {
    padding: 8px 0;
    border-bottom: 1px solid #eee;
    font-size: 15px;
    line-height: 1.5;
  }

  .widget-recent li:last-child {
    border-bottom: 0;
  }

  .widget-recent a {
    color: var(--ink);
  }

  .widget-recent a:hover {
    color: var(--brand);
  }

  /* quote form */

</style>
