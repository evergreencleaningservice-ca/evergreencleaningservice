---
/**
 * The spam check on every form. Renders whichever provider `site.captcha`
 * names, so the two never diverge and a form opts in by rendering this once.
 *
 * TURNSTILE (the default) is invisible: no checkbox, no image grid, nothing to
 * click. Cloudflare runs its checks while the visitor fills the form and drops
 * a token into a hidden `cf-turnstile-response` input it inserts into the form
 * itself. That input is the contract with every submit handler on the site —
 * they read it, and the Worker verifies it against Cloudflare before the lead
 * reaches the database. A visitor it cannot clear silently is shown an
 * interactive challenge by Cloudflare; that is Cloudflare's UI, not ours.
 *
 * Implicit rendering, not explicit: api.js finds every `.cf-turnstile` on the
 * page by itself and handles several correctly, which is what /contact-us/ and
 * /request-a-quote/ need — each carries two forms. reCAPTCHA needed explicit
 * rendering for that; Turnstile does not, so this is the simpler of the two.
 *
 * The `<noscript>` line is not decoration. With scripting off, no token is ever
 * produced and the Worker will answer 403, so the visitor needs to be told why
 * the form cannot work rather than watching it fail.
 */
import { captcha } from '../data/site';
import Recaptcha from './Recaptcha.astro';

const turnstileKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || captcha.turnstile.testSiteKey;

/* Built as a string and written with `set:html`, because Astro emits an
   `is:inline` script body as RAW TEXT. Wrapping it in {`...`} publishes the
   braces and backticks verbatim and the loader never runs — that exact bug
   shipped on 76 pages once already (see GoogleTagManager.astro). */
const loader = `
(function () {
  if (document.querySelector('script[data-turnstile]')) return;
  var s = document.createElement('script');
  s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
  s.async = true;
  s.defer = true;
  s.setAttribute('data-turnstile', '');
  document.head.appendChild(s);
})();
`.trim();
---

{
  captcha.provider === 'turnstile' ? (
    <div class="spamguard">
      <div
        class="cf-turnstile"
        data-sitekey={turnstileKey}
        data-appearance="interaction-only"
        data-response-field-name="cf-turnstile-response"
        data-retry="auto"
      />
      <noscript>
        <p class="spamguard-noscript">
          This form needs JavaScript enabled to verify you are not a bot. Please enable it, or call
          us on (416) 803-4880 and we will take the details directly.
        </p>
      </noscript>
    </div>
  ) : (
    <Recaptcha />
  )
}

{
  /* Injected rather than written as a plain <script src>: a page can hold two
     forms — /contact-us/ and /request-a-quote/ both do — and a component emits
     its markup once per instance, so a literal script tag would load api.js
     twice and initialise Turnstile twice on the same page. The guard makes
     every copy after the first a no-op. */
  captcha.provider === 'turnstile' && <script is:inline set:html={loader} />
}

<style>
  /* `interaction-only` means the widget draws nothing until Cloudflare decides
     a visitor needs a challenge, so this collapses to zero height in the
     ordinary case and only takes space when there is something to show. */
  .spamguard:not(:empty) {
    margin-bottom: 4px;
  }

  .spamguard-noscript {
    margin: 0 0 12px;
    padding: 10px 12px;
    border: 1px solid #d9534f;
    border-radius: var(--radius);
    background: #fdf3f3;
    color: #a94442;
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
