---
/** A grid of descriptive internal links — related services, industries, areas. */
interface Props {
  heading?: string;
  items: { title: string; href: string; text?: string }[];
  level?: 'h2' | 'h3';
}
const { heading, items, level = 'h2' } = Astro.props;
const Tag = level;
/* Columns that divide the set evenly where they can: four as 4 (or 2 x 2
   on a narrower column), six as 3 + 3, and anything else in rows of three
   with the short last row centred. */
const cols = items.length === 4 ? 4 : Math.min(3, items.length);
---

{
  items.length > 0 && (
    <section class="blk-links" aria-label={heading ?? 'Related pages'}>
      {heading && <Tag class="blk-title">{heading}</Tag>}
      <ul style={`--cols: ${cols}`}>
        {items.map((item) => (
          <li>
            <a href={item.href}>
              <strong>{item.title}</strong>
              {item.text && <span>{item.text}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .blk-links ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    container-type: inline-size;
  }
  .blk-links li {
    flex: 0 0 100%;
    min-width: 0;
  }
  @container (min-width: 480px) {
    .blk-links li {
      flex-basis: calc((100% - 12px) / 2);
    }
  }
  @container (min-width: 760px) {
    .blk-links li {
      flex-basis: calc((100% - (var(--cols) - 1) * 12px) / var(--cols));
    }
  }
  .blk-links a {
    display: block;
    height: 100%;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 14px 16px;
    color: var(--ink);
    text-decoration: none;
  }
  .blk-links a:hover,
  .blk-links a:focus-visible {
    border-color: var(--brand);
    text-decoration: none;
  }
  .blk-links strong {
    display: block;
    color: var(--brand-dark);
    font-family: var(--font-heading);
    font-size: 1rem;
    margin-bottom: 2px;
  }
  .blk-links strong::after {
    content: '\00a0→'; /* no-break space: the arrow never wraps alone */
  }
  .blk-links span {
    display: block;
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
