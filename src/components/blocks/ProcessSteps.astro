---
/**
 * The five steps from first contact to an ongoing contract. One component,
 * one source (`src/data/process.ts`), used on the homepage, the service pages,
 * the industry pages and /our-process/.
 */
import { PROCESS_STEPS } from '../../data/process';

interface Props {
  heading?: string;
  intro?: string;
  /** Heading level of the section title. */
  level?: 'h2' | 'h3';
}

const { heading = 'How it works', intro, level = 'h2' } = Astro.props;
const Tag = level;
---

<section class="blk-process" aria-label={heading}>
  <Tag class="blk-title">{heading}</Tag>
  {intro && <p class="blk-intro">{intro}</p>}
  <ol class="blk-steps">
    {
      PROCESS_STEPS.map((step) => (
        <li>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* Five steps. In a grid they split 3+2 with an empty sixth slot; as a
     centred flex row the last two sit in the middle, and where the column is
     wide enough (a full-width page) all five share one row. */
  .blk-steps {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
    container-type: inline-size;
  }
  .blk-steps li {
    flex: 0 0 100%;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .blk-steps li {
      flex-basis: calc((100% - 2 * 16px) / 3);
    }
  }
  @container (min-width: 1000px) {
    .blk-steps li {
      flex-basis: calc((100% - 4 * 16px) / 5);
    }
  }
  .blk-steps li {
    counter-increment: step;
    position: relative;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 48px 18px 16px;
  }
  .blk-steps li::before {
    content: counter(step);
    position: absolute;
    top: 14px;
    left: 18px;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font: 700 14px/26px var(--font-heading);
    text-align: center;
  }
  .blk-steps h3 {
    font-size: 1.05rem;
    line-height: 1.3;
    margin: 0 0 6px;
  }
  .blk-steps p {
    margin: 0;
    font-size: 0.9375rem;
  }
</style>
