---
/**
 * Named Google reviews, quoted in full. Real reviews only (src/data/reviews.ts),
 * chosen per page for relevance — never re-attributed to a city or industry
 * the reviewer did not mention, and never summarised into a rating.
 */
import { reviews, reviewDate } from '../../data/reviews';

interface Props {
  names?: string[];
  heading?: string;
}
const { names, heading = 'What clients say' } = Astro.props;
const chosen = names ? reviews.filter((r) => names.includes(r.name)) : reviews;
---

<section class="blk-reviews" aria-label={heading}>
  <h2 class="blk-title">{heading}</h2>
  <div class="blk-review-grid" data-reveal="stagger">
    {
      chosen.map((r) => {
        /* A month, not "N months ago", which went stale between builds
           (2026-11-06, SEO audit item 31). */
        const when = reviewDate(r);
        return (
          <figure class="blk-review">
            <blockquote>
              <p>“{r.text}”</p>
            </blockquote>
            <figcaption>
              <strong>{r.name}</strong>, Google review, <time datetime={when.datetime}>{when.label}</time>
            </figcaption>
          </figure>
        );
      })
    }
  </div>
</section>

<style>
  .blk-review-grid {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .blk-review-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }
  .blk-review {
    margin: 0;
    background: #fff;
    border: 1px solid var(--rule);
    border-left: 4px solid var(--brand);
    border-radius: 6px;
    padding: 16px 18px;
  }
  .blk-review blockquote {
    margin: 0 0 10px;
  }
  .blk-review p {
    margin: 0;
    color: var(--ink-heading);
  }
  .blk-review figcaption {
    font-size: 0.8125rem;
  }
</style>
