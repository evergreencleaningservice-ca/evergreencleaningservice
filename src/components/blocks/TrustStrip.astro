---
/** Four verified trust points (src/data/process.ts). No ratings, no counts. */
import { TRUST_FACTS } from '../../data/process';

interface Props {
  tone?: 'light' | 'plain';
}
const { tone = 'light' } = Astro.props;
---

<ul class:list={['blk-trust', `is-${tone}`]}>
  {
    TRUST_FACTS.map((f) => (
      <li>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M9 16.2 4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4z" />
        </svg>
        <span>
          <strong>{f.title}</strong>
          <span class="blk-trust-body">{f.body}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .blk-trust {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  @media (min-width: 640px) {
    .blk-trust {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1100px) {
    .blk-trust {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .blk-trust li {
    display: flex;
    gap: 10px;
    align-items: flex-start;
  }
  .blk-trust svg {
    flex: none;
    color: var(--brand);
    margin-top: 2px;
  }
  .blk-trust strong {
    display: block;
    color: var(--ink-heading);
    font-family: var(--font-heading);
    font-size: 1rem;
    line-height: 1.3;
  }
  .blk-trust-body {
    display: block;
    font-size: 0.875rem;
    line-height: 1.5;
  }
</style>
