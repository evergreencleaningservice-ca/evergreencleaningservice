---
import QuoteForm from '../QuoteForm.astro';
import { site, serviceAreas, social } from '../../data/site';
---

<section class="section-padding section-alt" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="section-title-area">
      <p class="section-subtitle">We&#039;d love to hear from you ...</p>
      <h2 class="section-title" id="contact-title">Get in touch</h2>
    </div>

    <div class="grid grid-2 contact-grid">
      <div class="contact-form-wrap">
        <QuoteForm id="contact" />
      </div>

      <div class="contact-info">
        <h3>WE ARE ACCEPTING NEW CLEANING CLIENTS.</h3>
        <p>
          If you&#8217;re looking for janitorial, office cleaning, or any commercial cleaning
          services in the Toronto GTA area, we&#8217;d love to hear from you.
        </p>

        <h3>Service Locations:</h3>
        <p>{serviceAreas}</p>

        <div class="address-box">
          <h3>{site.name}</h3>
          <address>
            243 Queen St W.<br />
            Toronto<br />
            Ontario M5V 1Z4<br />
            Canada
          </address>
          <p class="contact-line">
            <a href={site.phoneHref}>+1 {site.phone}</a>
          </p>
          <p class="contact-line">
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>

        <h5 class="social-title">Follow us on Social Media</h5>
        <ul class="social-links">
          {
            social.map((item) => (
              <li>
                <a href={item.href} rel="noopener noreferrer" target="_blank">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    align-items: start;
  }

  .contact-form-wrap {
    min-width: 0;
  }

  .social-title {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 24px 0 10px;
  }

  .social-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  .social-links a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .contact-form {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    padding: 26px 24px 30px;
  }

  .form-note {
    background: #fff8e6;
    border-left: 4px solid #d9a400;
    padding: 12px 14px;
    font-size: 0.9rem;
    margin: 0 0 22px;
  }

  .field {
    margin-bottom: 18px;
  }

  .field label {
    display: block;
    font-family: var(--font-heading);
    font-weight: 600;
    color: var(--ink-heading);
    margin-bottom: 6px;
  }

  .field label span {
    color: #c0392b;
  }

  .field input,
  .field textarea {
    width: 100%;
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    padding: 10px 12px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: #fff;
  }

  .field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 1px;
    border-color: var(--brand);
  }

  .form-required-note {
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .form-required-note span {
    color: #c0392b;
  }

  .contact-info h3 {
    font-size: 1.15rem;
    margin-top: 1.4em;
  }

  .contact-info > h3:first-child {
    margin-top: 0;
  }

  .address-box {
    margin-top: 1.6em;
    padding: 22px 24px;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
  }

  .address-box h3 {
    margin-top: 0;
  }

  .address-box address {
    font-style: normal;
    margin-bottom: 0.8em;
  }

  .contact-line {
    margin: 0 0 4px;
  }
</style>
