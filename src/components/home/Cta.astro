<section class="section-padding section-inverse" id="section-cta" aria-labelledby="cta-title">
  <div class="container cta-inner">
    <h2 id="cta-title">Ready to partner with a cleaning company that you can count on?</h2>
    <p class="cta-action">
      <a class="btn btn-outline btn-lg" href="/request-a-quote/">Request a Quote Now</a>
    </p>
  </div>
</section>

<style>
  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .cta-inner h2 {
    flex: 1 1 420px;
    margin: 0;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .cta-action {
    margin: 0;
    flex: none;
  }

  .cta-action .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (max-width: 767px) {
    .cta-inner {
      text-align: center;
      justify-content: center;
    }
  }
</style>
