---
import { site } from '../../data/site';
---

<section class="section-padding section-alt" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-title-area">
      <h2 class="section-title" id="features-title">3 Easy Steps</h2>
    </div>

    <div class="grid grid-3">
      <div class="step">
        <span class="step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect>
            <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <h3 class="step-title"><a href="/request-a-quote/">Contact</a></h3>
        <p>
          Either give us a call directly at <a href={site.phoneHref}>{site.phone}</a> or request a quote
          for any of our commercial cleaning services using our handy form on the <a
            href="/contact-us/">contact page</a
          >. We&#8217;d love to hear from you.
        </p>
      </div>

      <div class="step">
        <span class="step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="4" y="3" width="16" height="18" rx="2"></rect>
            <path d="M8 8h8M8 12h8M8 16h5" stroke-linecap="round"></path>
          </svg>
        </span>
        <h3 class="step-title">Assess</h3>
        <p>
          We&#8217;ll set up a time with you when we can sit down and go over your company commercial
          cleaning requirements in detail. We&#8217;ll then present you with a proposal for services.
        </p>
      </div>

      <div class="step">
        <span class="step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M20.5 12a8.5 8.5 0 1 1-2.5-6" stroke-linecap="round"></path>
            <path d="M20.5 3.5v5h-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </span>
        <h3 class="step-title">Refresh</h3>
        <p>
          Now that you&#8217;ve hired a commercial cleaning team that you can count on, you can now
          focus on what you do best, your business. All your cleaning requirements are now in good
          hands.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .step {
    text-align: center;
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 86px;
    height: 86px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    margin-bottom: 18px;
  }

  .step-icon svg {
    width: 38px;
    height: 38px;
  }

  .step-title {
    font-size: 1.2rem;
    margin-bottom: 0.6em;
  }

  .step-title a {
    color: var(--ink-heading);
  }

  .step-title a:hover,
  .step-title a:focus-visible {
    color: var(--brand);
  }

  .step p {
    margin: 0;
  }
</style>
