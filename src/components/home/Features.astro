---
import { site } from '../../data/site';
---

<section class="section-padding section-alt" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-title-area">
      <h2 class="section-title" id="features-title">3 Easy Steps</h2>
    </div>

    <div class="grid grid-3">
      <div class="step wow slideInUp">
        <span class="step-media">
          <span class="step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect>
            <path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          </span>
        </span>
        <h3 class="step-title"><a href="/request-a-quote/">Contact</a></h3>
        <p>
          Either give us a call directly at <a href={site.phoneHref}>{site.phone}</a> or request a quote
          for any of our commercial cleaning services using our handy form on the <a
            href="/contact-us/">contact page</a
          >. We&#8217;d love to hear from you.
        </p>
      </div>

      <div class="step wow slideInUp">
        <span class="step-media">
          <span class="step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="4" y="3" width="16" height="18" rx="2"></rect>
            <path d="M8 8h8M8 12h8M8 16h5" stroke-linecap="round"></path>
          </svg>
          </span>
        </span>
        <h3 class="step-title">Assess</h3>
        <p>
          We&#8217;ll set up a time with you when we can sit down and go over your company commercial
          cleaning requirements in detail. We&#8217;ll then present you with a proposal for services.
        </p>
      </div>

      <div class="step wow slideInUp">
        <span class="step-media">
          <span class="step-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M20.5 12a8.5 8.5 0 1 1-2.5-6" stroke-linecap="round"></path>
            <path d="M20.5 3.5v5h-5" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          </span>
        </span>
        <h3 class="step-title">Refresh</h3>
        <p>
          Now that you&#8217;ve hired a commercial cleaning team that you can count on, you can now
          focus on what you do best, your business. All your cleaning requirements are now in good
          hands.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .step {
    text-align: center;
  }

  /* The original draws this with a Font Awesome icon stack: `.fa-5x` at 4em of
     the 14px root gives the stack a 56px font-size, so its box is 2.5em x 2em
     (140 x 112px) and the `fa-stack-2x` circle behind the glyph is 2em — a
     112px disc. The glyph itself is `fa-stack-1x`, so it stays at 56px.
     Measured on the original: 140x112 box, circle 112px, glyph white. */
  .step-media {
    width: 140px;
    height: 112px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
  }

  .step-icon svg {
    width: 50px;
    height: 50px;
  }

  /* `.feature-item:hover .icon-background-default` — the disc darkens to #333
     and grows 10%, over .5s. Only the disc transitions in the theme, and only
     on the way in; the glyph is a sibling there, so it neither moves nor
     scales. Both are reproduced here. */
  .step:hover .step-icon,
  .step:focus-within .step-icon {
    background: #333;
    transform: scale(1.1);
    transition: all 0.5s ease-in-out;
  }

  .step:hover .step-icon svg,
  .step:focus-within .step-icon svg {
    transform: scale(0.909);
    transition: all 0.5s ease-in-out;
  }

  @media (prefers-reduced-motion: reduce) {
    .step:hover .step-icon,
    .step:focus-within .step-icon,
    .step:hover .step-icon svg,
    .step:focus-within .step-icon svg {
      transform: none;
      transition: none;
    }
  }

  .step-title {
    font-size: 1.2rem;
    margin-bottom: 0.6em;
  }

  .step-title a {
    color: var(--ink-heading);
  }

  .step-title a:hover,
  .step-title a:focus-visible {
    color: var(--brand);
  }

  .step p {
    margin: 0;
  }
</style>
