---
/**
 * The original gallery images carried empty alt attributes. Alt text here is
 * written from each file's own subject so the grid is usable with a screen
 * reader; the images and their order are unchanged.
 *
 * Each one is a link to the full-size file, as the original's are
 * (`<a href="[upload]" class="g-item">`), and carries the theme's `g-zoom-in`
 * hover: the picture scales to 1.5 over half a second, linear, clipped by the
 * link.
 *
 * NOT reproduced: the original runs a justified-gallery script over these,
 * which sizes each row to a 187px height and varies the widths to each image's
 * own aspect ratio. That script is not in the archive and does not run in the
 * reference copy — its items measure 0x0 there — so there is nothing to port
 * it from. This is a uniform grid at the original's 5px spacing instead.
 */
const photos = [
  {
    src: '/images/Toronto-Industrial-Cleaning-demo.jpg',
    alt: 'Industrial floor cleaned by the Evergreen team in Toronto',
  },
  {
    src: '/images/office-cleaning-in-Toronto.jpg',
    alt: 'Office cleaning under way in a Toronto workspace',
  },
  {
    src: '/images/toronto-office-cleaning-services.jpg',
    alt: 'Toronto office left tidy after a scheduled cleaning visit',
  },
  {
    src: '/images/retailstore_1-1024x682.jpg',
    alt: 'Retail store with clean floors and dusted display shelving',
  },
  {
    src: '/images/commercial-lobby-cleaning-demo.jpg',
    alt: 'Polished commercial building lobby',
  },
  {
    src: '/images/office-cleaning-services-Toronto.jpg',
    alt: 'Open-plan Toronto office after an office cleaning service',
  },
  {
    src: '/images/toronto-office-cleaning.jpg',
    alt: 'Clean desks and seating area in a Toronto office',
  },
  {
    src: '/images/lobby.jpg',
    alt: 'Building lobby with clean seating and glass',
  },
  {
    src: '/images/dentistoffice_1-1024x683.jpg',
    alt: 'Spotless dental clinic treatment room',
  },
  {
    src: '/images/office-pic.jpg',
    alt: 'Cleaned office workstations and meeting table',
  },
];
---

<section class="section-padding section-white" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-title-area">
      <p class="section-subtitle">Evergreen Cleaning makes</p>
      <h2 class="section-title" id="gallery-title">Clean Spaces</h2>
    </div>

    <ul class="gallery-grid">
      {
        photos.map((photo) => (
          <li>
            <a class="g-item" href={photo.src}>
              <img
                src={photo.src}
                alt={photo.alt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    /* `data-spacing="5"` on the original's gallery. */
    gap: 5px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
  }

  /* `.g-zoom-in .g-item { display: block; overflow: hidden }` */
  .g-item {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .gallery-grid img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* `.g-zoom-in .g-item img { transition: all .5s linear }` */
    transition: transform 0.5s linear;
  }

  /* `.g-zoom-in .g-item:hover img { transform: scale(1.5, 1.5) }` */
  .g-item:hover img,
  .g-item:focus-visible img {
    transform: scale(1.5, 1.5);
  }

  .g-item:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-grid img {
      transition: none;
    }

    .g-item:hover img,
    .g-item:focus-visible img {
      transform: none;
    }
  }
</style>
