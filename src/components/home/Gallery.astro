---
/**
 * The original gallery images carried empty alt attributes. Alt text here is
 * written from each file's own subject so the grid is usable with a screen
 * reader; the images and their order are unchanged.
 *
 * Each one is a link to the full-size file, as the original's are
 * (`<a href="[upload]" class="g-item">`), and carries the theme's `g-zoom-in`
 * hover: the picture scales to 1.5 over half a second, linear, clipped by the
 * link.
 *
 * NOT reproduced: the original runs a justified-gallery script over these,
 * which sizes each row to a 187px height and varies the widths to each image's
 * own aspect ratio. That script is not in the archive and does not run in the
 * reference copy — its items measure 0x0 there — so there is nothing to port
 * it from. This is a uniform grid at the original's 5px spacing instead.
 */
const photos = [
  {
    src: '/images/warehouse-floor-scrubber-industrial.jpg',
    alt: 'Industrial floor scrubbed by an Evergreen technician in a warehouse',
  },
  {
    src: '/images/office-backpack-vacuum-toronto.jpg',
    alt: 'Cleaner vacuuming an open-plan Toronto office',
  },
  {
    src: '/images/night-janitorial-crew-office-toronto.jpg',
    alt: 'Evening janitorial crew cleaning a Toronto office',
  },
  {
    src: '/images/car-dealership-showroom-floor-mopping.jpg',
    alt: 'Cleaner mopping a car dealership showroom floor',
  },
  {
    src: '/images/lobby-floor-scrubber-commercial.jpg',
    alt: 'Commercial lobby floor being machine scrubbed',
  },
  {
    src: '/images/common-areas-glass-railing-cleaning.jpg',
    alt: 'Cleaner wiping a glass railing in a building common area',
  },
  {
    src: '/images/post-construction-cleanup-vacuum.jpg',
    alt: 'Post-construction dust being vacuumed from a new build floor',
  },
  {
    src: '/images/marble-floor-restoration-buffing.jpg',
    alt: 'Marble floor being buffed with a floor machine',
  },
  {
    src: '/images/dental-office-cleaning-technician.jpg',
    alt: 'Technician disinfecting a dental treatment chair',
  },
  {
    src: '/images/carpet-extraction-boardroom-toronto.jpg',
    alt: 'Boardroom carpet being cleaned with an extraction wand',
  },
];
---

<section class="section-padding section-white" id="gallery" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-title-area">
      <p class="section-subtitle">Evergreen Cleaning makes</p>
      <h2 class="section-title" id="gallery-title">Clean Spaces</h2>
    </div>

    <ul class="gallery-grid">
      {
        photos.map((photo) => (
          <li>
            <a class="g-item" href={photo.src}>
              <img
                src={photo.src}
                alt={photo.alt}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    /* `data-spacing="5"` on the original's gallery. */
    gap: 5px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 600px) {
    .gallery-grid {
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    }
  }

  /* `.g-zoom-in .g-item { display: block; overflow: hidden }` */
  .g-item {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }

  .gallery-grid img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    /* `.g-zoom-in .g-item img { transition: all .5s linear }` */
    transition: transform 0.5s linear;
  }

  /* `.g-zoom-in .g-item:hover img { transform: scale(1.5, 1.5) }` */
  .g-item:hover img,
  .g-item:focus-visible img {
    transform: scale(1.5, 1.5);
  }

  .g-item:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-grid img {
      transition: none;
    }

    .g-item:hover img,
    .g-item:focus-visible img {
      transform: none;
    }
  }
</style>
