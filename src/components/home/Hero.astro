---
import { nap } from '../../data/site';

/**
 * The hero visual ROTATES through three office photographs (31 Oct 2026,
 * client: "use an office", no people except the gloved hand on the desk).
 * Until then it was one picture of a ride-on scrubber in a corridor.
 *
 * The FIRST slide is the page's Largest Contentful Paint and is treated as
 * one: a real <picture> in the markup, eager, high priority, with a srcset
 * and explicit dimensions, so the preload scanner finds it. The other two
 * sit in a <template>, which fetches nothing: the script below adds them
 * only after the page has finished loading, so they never compete with the
 * first paint, and then crossfades every six seconds. Without JavaScript,
 * or with reduced motion asked for, the first photo simply stays.
 *
 * AVIF then WebP then JPEG at 480/768/1000/1200 wide (the sources are
 * 1200px stock photos, so no upscaled 1600), cut to 2.4:1, plus a 640x800
 * crop for phones. Generated by `npm run images:variants`.
 */
/* Described (SEO audit H11): the first slide is the page's main image. */
const SLIDES = [
  {
    base: 'gallery-corporate-office-cleaning-hero',
    alt: 'Clean, empty open-plan office with white desks and plants against a dark wall',
  },
  { base: 'office-cleaning-cost-boardroom-hero', alt: '' },
  { base: 'spring-office-desk-cleaning-toronto-hero', alt: '' },
];
const WIDTHS = [480, 768, 1000, 1200] as const;
const NATURAL = { width: 1200, height: 500 };

const srcset = (base: string, ext: string) =>
  WIDTHS.map((w) => `/images/${base}-${w}.${ext} ${w}w`).join(', ');
const [first, ...rest] = SLIDES;
---

<section class="hero" id="hero">
  <div class="hero-slides" aria-hidden="true">
    <picture class="hero-slide is-active">
      <source media="(max-width: 640px)" type="image/avif" srcset={`/images/${first.base}-mobile-640x800.avif`} />
      <source type="image/avif" srcset={srcset(first.base, 'avif')} sizes="100vw" />
      <source media="(max-width: 640px)" type="image/webp" srcset={`/images/${first.base}-mobile-640x800.webp`} />
      <source type="image/webp" srcset={srcset(first.base, 'webp')} sizes="100vw" />
      <source media="(max-width: 640px)" srcset={`/images/${first.base}-mobile-640x800.jpg`} />
      <img
        src={`/images/${first.base}-1000.jpg`}
        srcset={srcset(first.base, 'jpg')}
        sizes="100vw"
        width={NATURAL.width}
        height={NATURAL.height}
        alt={first.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
    <template data-hero-more>
      {
        rest.map((slide) => (
          <picture class="hero-slide">
            <source media="(max-width: 640px)" type="image/avif" srcset={`/images/${slide.base}-mobile-640x800.avif`} />
            <source type="image/avif" srcset={srcset(slide.base, 'avif')} sizes="100vw" />
            <source media="(max-width: 640px)" type="image/webp" srcset={`/images/${slide.base}-mobile-640x800.webp`} />
            <source type="image/webp" srcset={srcset(slide.base, 'webp')} sizes="100vw" />
            <source media="(max-width: 640px)" srcset={`/images/${slide.base}-mobile-640x800.jpg`} />
            <img
              src={`/images/${slide.base}-1000.jpg`}
              srcset={srcset(slide.base, 'jpg')}
              sizes="100vw"
              width={NATURAL.width}
              height={NATURAL.height}
              alt={slide.alt}
              decoding="async"
            />
          </picture>
        ))
      }
    </template>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  {/* Rewritten 2026-10-15. The rotating five-word brandmark is gone: it was
      decoration (aria-hidden), 75px tall on a desktop, and pushed the
      heading, the service area and both actions further down the first
      screen. The first screen now answers what Evergreen does, where, for
      whom and how to start — in that order. */}
  <div class="container hero-inner">
    <p class="hero-eyebrow">Commercial cleaning since 1989</p>
    <h1 class="hero-title">Office &amp; Commercial Cleaning in Toronto and the GTA</h1>

    <p class="hero-sub">
      Recurring janitorial cleaning, building maintenance and specialty cleaning for offices, clinics,
      managed buildings and industrial sites — after hours, by a consistent crew.
    </p>

    <p class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/request-a-quote/" data-cta-location="hero">Get a free quote</a>
      <a class="btn btn-outline btn-lg" href={nap.phoneHref} data-call-location="hero">Call {nap.phoneDisplay}</a>
    </p>

    <ul class="hero-points">
      <li>Free on-site walkthrough</li>
      <li>WSIB covered, bonded and insured</li>
      <li>A reply within 2 hours</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--surface-dark);
    color: #fff;
    overflow: hidden;
  }

  /* On a wide screen the hero was only as tall as its text, so the 2.4:1
     photo was cropped to a 5:1 strip and the crew lost their heads. From
     1600px it grows with the width (to a cap), with the text centred in it. */
  @media (min-width: 1600px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: min(30vw, 820px);
    }
  }

  .hero-slides,
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Darker than the original 30%, and weighted to the left where the text
     sits, so white text clears 4.5:1 over the brightest part of the photo. */
  .hero-overlay {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.55) 55%, rgba(0, 0, 0, 0.35) 100%);
  }

  .hero-inner {
    position: relative;
    padding-top: 72px;
    padding-bottom: 72px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #d8f0c8;
    margin: 0 0 10px;
  }

  .hero-title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 16px;
    max-width: 760px;
  }

  /* Larger on large monitors, where 48px read small (30 Oct 2026). */
  @media (min-width: 1800px) {
    .hero-title {
      font-size: 3.5rem;
      max-width: 880px;
    }
  }

  .hero-sub {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: #fff;
    max-width: 640px;
    margin: 0 0 24px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 22px;
  }

  .hero-actions .btn {
    margin: 0;
  }

  .hero-actions .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .hero-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .hero-points li::before {
    content: '✓ ';
    color: #9fdc7c;
  }

  @media (max-width: 767px) {
    .hero-inner {
      padding-top: 40px;
      padding-bottom: 44px;
    }
    .hero-title {
      font-size: 2rem;
    }
    .hero-sub {
      font-size: 1.0625rem;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  /* Adds the other office slides once the page has loaded, then crossfades
     every six seconds. A slide whose photo has not arrived yet is skipped
     for that turn rather than faded in blank; a hidden tab does not rotate. */
  const hero = document.getElementById('hero');
  const more = hero?.querySelector<HTMLTemplateElement>('template[data-hero-more]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const start = () => {
    const box = hero!.querySelector('.hero-slides')!;
    box.append(more!.content.cloneNode(true));
    const slides = [...box.querySelectorAll<HTMLElement>('.hero-slide')];
    let current = 0;
    window.setInterval(() => {
      if (document.hidden) return;
      const next = (current + 1) % slides.length;
      const img = slides[next].querySelector('img');
      if (img && !(img.complete && img.naturalWidth)) return;
      slides[current].classList.remove('is-active');
      slides[next].classList.add('is-active');
      current = next;
    }, 6000);
  };

  if (hero && more && !still) {
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });
  }
</script>
