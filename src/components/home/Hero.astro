---
import { site } from '../../data/site';

/**
 * Background slideshow images come from the data-images attribute on the
 * original <section id="hero"> (OnePress hero-slideshow-normal).
 */
const slides = [
  '/images/business-team.jpg',
  '/images/business-introductions.jpg',
  '/images/toronto-commercial-cleaning-business-meeting.jpg',
];

/** The words the original theme rotated inside the hero heading. */
const words = [
  'Office Cleaning',
  'Building Maintenance',
  'Commercial Cleaning',
  'Janitorial Services',
  'Disinfection Cleaning',
];
---

<section class="hero" id="hero">
  <div class="hero-slides" aria-hidden="true">
    {
      slides.map((src, i) => (
        <div
          class:list={['hero-slide', i === 0 && 'is-active']}
          style={`background-image: url('${src}')`}
        />
      ))
    }
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  {/* An h2, as the original's own hero is (`h2.hero-large-text`). The page's
      single h1 is "Toronto Office Cleaning Services" in the About band — the
      port had this as an h1 too, which gave the homepage two. */}
  <div class="container hero-inner">
    <h2 class="hero-title">
      Evergreen{' '}
      <span class="hero-rotator">
        {
          words.map((word, i) => (
            <span class:list={['hero-word', i === 0 && 'is-active']}>
              {word}
              {/* Keeps the words apart for screen readers, which read all five. */}
              {i < words.length - 1 && <span class="screen-reader-text">, </span>}
            </span>
          ))
        }
      </span>
    </h2>

    <p class="hero-sub">
      Leaders in Commercial Cleaning and Building Maintenance in Toronto and the GTA
    </p>

    <p class="hero-actions">
      <a class="btn btn-primary btn-lg" href={site.phoneHref}>Call now {site.phone}</a>
      <a class="btn btn-outline btn-lg" href="/request-a-quote/">Request a Quote</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--surface-dark);
    color: #fff;
    overflow: hidden;
  }

  .hero-slides,
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  .hero-overlay {
    background: rgba(0, 0, 0, 0.3);
  }

  /* The original sets 12% top and bottom padding on the inner container. */
  .hero-inner {
    position: relative;
    text-align: center;
    padding-top: 12%;
    padding-bottom: 12%;
  }

  /* Measured from the original: 75px / 800 / uppercase, with the tracking
     stepping down alongside the size at each breakpoint. */
  .hero-title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 75px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0 0 0.9375rem;
  }

  @media (max-width: 991px) {
    .hero-title {
      font-size: 60px;
      letter-spacing: 3px;
    }
  }

  @media (max-width: 767px) {
    .hero-title {
      font-size: 35px;
      letter-spacing: 2px;
    }
  }

  /* Every word sits in the same grid cell, so the heading keeps a stable
     width and the inactive words simply fade out behind the active one. */
  .hero-rotator {
    display: grid;
    max-width: 100%;
  }

  .hero-word {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .hero-word.is-active {
    opacity: 1;
  }

  /* The original's sub-line is 22px italic at weight 700. */
  .hero-sub {
    font-size: 22px;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.4px;
    line-height: 1.7;
    color: #fff;
    max-width: none;
    margin: 0 auto 1.25rem;
  }

  @media (max-width: 767px) {
    .hero-sub {
      font-size: 18px;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 0;
  }

  .hero-actions .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-word {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');

  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('.hero-slide'));
    const words = Array.from(hero.querySelectorAll<HTMLElement>('.hero-word'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Reduced motion: the first slide and the first word stay put, as rendered.
    const advance = (items: HTMLElement[], index: number) => {
      items[index]?.classList.remove('is-active');
      const next = (index + 1) % items.length;
      items[next]?.classList.add('is-active');
      return next;
    };

    if (!still.matches) {
      if (slides.length > 1) {
        let slide = 0;
        window.setInterval(() => {
          slide = advance(slides, slide);
        }, 6000);
      }

      if (words.length > 1) {
        let word = 0;
        window.setInterval(() => {
          word = advance(words, word);
        }, 2600);
      }
    }
  }
</script>
