---
import { nap } from '../../data/site';

/**
 * The hero visual is ONE licensed iStock photograph (the same picture as
 * gallery-commercial-lobby-cleaning), a ride-on scrubber in a polished
 * corridor, cropped to 2.4:1, a <picture> so it can carry `fetchpriority`,
 * a `srcset` and explicit dimensions. It is this page's Largest Contentful
 * Paint, so it is eager, high priority and discoverable by the preload
 * scanner. With a single image there is no slideshow and nothing deferred.
 *
 * AVIF then WebP then JPEG at 480/768/1000/1600 wide, plus a 640x800 crop
 * for phones that keeps the machine in frame. `object-fit: cover` +
 * `object-position: center` fill the full-bleed hero; width/height reserve
 * the 2.4:1 box. The empty left side of the corridor sits under the copy.
 */
/* Described since 2026-10-29 (SEO audit H11): this is the page's main image,
   not decoration. A description of what is in it, not a claim about results. */
const HERO = {
  base: 'ride-on-floor-scrubber-corridor-hero',
  alt: 'Ride-on floor scrubber parked in a bright corridor with a freshly polished floor',
};
const WIDTHS = [480, 768, 1000, 1600] as const;
const NATURAL = { width: 1600, height: 667 };

const srcset = (base: string, ext: string) =>
  WIDTHS.map((w) => `/images/${base}-${w}.${ext} ${w}w`).join(', ');


---

<section class="hero" id="hero">
  <div class="hero-slides" aria-hidden="true">
    <picture class="hero-slide is-active">
      <source media="(max-width: 640px)" type="image/avif" srcset={`/images/${HERO.base}-mobile-640x800.avif`} />
      <source type="image/avif" srcset={srcset(HERO.base, 'avif')} sizes="100vw" />
      <source media="(max-width: 640px)" type="image/webp" srcset={`/images/${HERO.base}-mobile-640x800.webp`} />
      <source type="image/webp" srcset={srcset(HERO.base, 'webp')} sizes="100vw" />
      <source media="(max-width: 640px)" srcset={`/images/${HERO.base}-mobile-640x800.jpg`} />
      <img
        src={`/images/${HERO.base}-1000.jpg`}
        srcset={srcset(HERO.base, 'jpg')}
        sizes="100vw"
        width={NATURAL.width}
        height={NATURAL.height}
        alt={HERO.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  {/* Rewritten 2026-10-15. The rotating five-word brandmark is gone: it was
      decoration (aria-hidden), 75px tall on a desktop, and pushed the
      heading, the service area and both actions further down the first
      screen. The first screen now answers what Evergreen does, where, for
      whom and how to start — in that order. */}
  <div class="container hero-inner">
    <p class="hero-eyebrow">Commercial cleaning since 1989</p>
    <h1 class="hero-title">Office &amp; Commercial Cleaning in Toronto and the GTA</h1>

    <p class="hero-sub">
      Recurring janitorial cleaning, building maintenance and specialty cleaning for offices, clinics,
      managed buildings and industrial sites — after hours, by a consistent crew.
    </p>

    <p class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/request-a-quote/" data-cta-location="hero">Get a free quote</a>
      <a class="btn btn-outline btn-lg" href={nap.phoneHref} data-call-location="hero">Call {nap.phoneDisplay}</a>
    </p>

    <ul class="hero-points">
      <li>Free on-site walkthrough</li>
      <li>WSIB covered, bonded and insured</li>
      <li>One account executive</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--surface-dark);
    color: #fff;
    overflow: hidden;
  }

  /* On a wide screen the hero was only as tall as its text, so the 2.4:1
     photo was cropped to a 5:1 strip and the crew lost their heads. From
     1600px it grows with the width (to a cap), with the text centred in it. */
  @media (min-width: 1600px) {
    .hero {
      display: flex;
      align-items: center;
      min-height: min(30vw, 820px);
    }
  }

  .hero-slides,
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Darker than the original 30%, and weighted to the left where the text
     sits, so white text clears 4.5:1 over the brightest part of the photo. */
  .hero-overlay {
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.55) 55%, rgba(0, 0, 0, 0.35) 100%);
  }

  .hero-inner {
    position: relative;
    padding-top: 72px;
    padding-bottom: 72px;
    max-width: 1140px;
  }

  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #d8f0c8;
    margin: 0 0 10px;
  }

  .hero-title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 16px;
    max-width: 760px;
  }

  .hero-sub {
    font-size: 1.1875rem;
    line-height: 1.6;
    color: #fff;
    max-width: 640px;
    margin: 0 0 24px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 0 0 22px;
  }

  .hero-actions .btn {
    margin: 0;
  }

  .hero-actions .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  .hero-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .hero-points li::before {
    content: '✓ ';
    color: #9fdc7c;
  }

  @media (max-width: 767px) {
    .hero-inner {
      padding-top: 40px;
      padding-bottom: 44px;
    }
    .hero-title {
      font-size: 2rem;
    }
    .hero-sub {
      font-size: 1.0625rem;
    }
    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
