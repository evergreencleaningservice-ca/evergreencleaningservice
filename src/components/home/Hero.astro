---
import { site, nap } from '../../data/site';

/**
 * The hero visual is ONE generated Evergreen commercial-cleaning montage
 * (1916x821 source), a decorative <picture> so it can carry `fetchpriority`,
 * a `srcset` and explicit dimensions. It is this page's Largest Contentful
 * Paint, so it is eager, high priority and discoverable by the preload
 * scanner. With a single image there is no slideshow and nothing deferred.
 *
 * AVIF then WebP then JPEG at 480/768/1000/1600 wide, generated by
 * `scripts/hero-variants.mjs`. `object-fit: cover` + `object-position: center`
 * fill the full-bleed hero; width/height reserve the 1916:821 box.
 */
const HERO = { base: 'evergreen-commercial-cleaning-hero', alt: '' };
const WIDTHS = [480, 768, 1000, 1600] as const;
const NATURAL = { width: 1916, height: 821 };

const srcset = (base: string, ext: string) =>
  WIDTHS.map((w) => `/images/${base}-${w}.${ext} ${w}w`).join(', ');

/** The words the original theme rotated inside the hero heading. */
const words = [
  'Office Cleaning',
  'Building Maintenance',
  'Commercial Cleaning',
  'Janitorial Services',
  'Disinfection Cleaning',
];
---

<section class="hero" id="hero">
  <div class="hero-slides" aria-hidden="true">
    <picture class="hero-slide is-active">
      <source type="image/avif" srcset={srcset(HERO.base, 'avif')} sizes="100vw" />
      <source type="image/webp" srcset={srcset(HERO.base, 'webp')} sizes="100vw" />
      <img
        src={`/images/${HERO.base}-1000.jpg`}
        srcset={srcset(HERO.base, 'jpg')}
        sizes="100vw"
        width={NATURAL.width}
        height={NATURAL.height}
        alt={HERO.alt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  {/* THE ROTATOR IS DECORATION, AND IS MARKED AS SUCH.

      It used to be the page's h1. What a crawler and a screen reader
      actually got from that was "Evergreen Office Cleaning, Building
      Maintenance, Commercial Cleaning, Janitorial Services, Disinfection
      Cleaning" — five rotating words read out as a comma list, which is not
      a heading, is not a sentence, and is a weak h1 for a page targeting
      Toronto office cleaning.

      So it is a div now, `aria-hidden`, and nothing about it changed on
      screen: same 75px uppercase type, same fade, same classes carrying
      every pixel of the styling. Assistive technology skips it entirely,
      which also removes the five screen-reader commas that were in there to
      stop the words running together.

      The h1 below is stable text, visible, and says what the page is. It is
      NOT a hidden keyword line — it is the sentence a visitor reads. */}
  <div class="container hero-inner">
    <div class="hero-brandmark" aria-hidden="true">
      Evergreen{' '}
      <span class="hero-rotator">
        {
          words.map((word, i) => (
            <span class:list={['hero-word', i === 0 && 'is-active']}>{word}</span>
          ))
        }
      </span>
    </div>

    <h1 class="hero-title">Professional Office &amp; Commercial Cleaning in Toronto</h1>

    <p class="hero-sub">
      Building maintenance and janitorial services across the GTA since 1989
    </p>

    <p class="hero-actions">
      <a class="btn btn-primary btn-lg" href={nap.phoneHref} data-call-location="hero">Call now {nap.phoneDisplay}</a>
      <a class="btn btn-outline btn-lg" href="/request-a-quote/">Request a Quote</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--surface-dark);
    color: #fff;
    overflow: hidden;
  }

  .hero-slides,
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Was a div with a background-image. `object-fit: cover` and
     `object-position: center` on the img reproduce `background-size: cover`
     and `background-position: center` pixel for pixel. */
  .hero-slide {
    position: absolute;
    inset: 0;
    display: block;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-overlay {
    background: rgba(0, 0, 0, 0.3);
  }

  /* The original sets 12% top and bottom padding on the inner container. */
  .hero-inner {
    position: relative;
    text-align: center;
    padding-top: 12%;
    padding-bottom: 12%;
  }

  /* Measured from the original: 75px / 800 / uppercase, with the tracking
     stepping down alongside the size at each breakpoint. These are the
     brandmark's numbers — they used to be .hero-title's, and the selector
     was renamed with the element. Nothing about the rendering changed. */
  .hero-brandmark {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 75px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0 0 0.9375rem;
  }

  @media (max-width: 991px) {
    .hero-brandmark {
      font-size: 60px;
      letter-spacing: 3px;
    }
  }

  @media (max-width: 767px) {
    .hero-brandmark {
      font-size: 35px;
      letter-spacing: 2px;
    }
  }

  /* The real heading. Sized to read as one — clearly above the supporting
     line beneath it, clearly below the brandmark above it. */
  .hero-title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 30px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.5px;
    margin: 0 0 0.75rem;
  }

  @media (max-width: 767px) {
    .hero-title {
      font-size: 22px;
      line-height: 1.3;
    }
  }

  /* Every word sits in the same grid cell, so the heading keeps a stable
     width and the inactive words simply fade out behind the active one. */
  .hero-rotator {
    display: grid;
    max-width: 100%;
  }

  .hero-word {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .hero-word.is-active {
    opacity: 1;
  }

  /* The original's sub-line is 22px italic at weight 700. */
  .hero-sub {
    font-size: 22px;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.4px;
    line-height: 1.7;
    color: #fff;
    max-width: none;
    margin: 0 auto 1.25rem;
  }

  @media (max-width: 767px) {
    .hero-sub {
      font-size: 18px;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 0;
  }

  .hero-actions .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');

  if (hero) {
    const words = Array.from(hero.querySelectorAll<HTMLElement>('.hero-word'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    const advance = (items: HTMLElement[], index: number) => {
      items[index]?.classList.remove('is-active');
      const next = (index + 1) % items.length;
      items[next]?.classList.add('is-active');
      return next;
    };

    /* Reduced motion: the first slide and the first word stay put, as
       rendered — and the other slides are never fetched at all. */
    if (!still.matches) {
      if (words.length > 1) {
        let word = 0;
        window.setInterval(() => {
          word = advance(words, word);
        }, 2600);
      }
    }
  }
</script>
