---
import { site, nap } from '../../data/site';

/**
 * Slideshow images, from the data-images attribute on the original
 * <section id="hero"> (OnePress hero-slideshow-normal).
 *
 * THESE ARE <img> ELEMENTS, NOT CSS BACKGROUNDS, and that is the point of
 * Phase 8. The first slide is this page's Largest Contentful Paint. As a
 * `background-image` it could not carry `fetchpriority`, could not have a
 * `srcset`, and was not discoverable by the browser's preload scanner at all
 * — it is only found after the stylesheet has been downloaded and parsed.
 * Lighthouse measured the consequence at 6.1s and named it: "LCP request
 * discovery — fetchpriority=high should be applied: false".
 *
 * A `<picture>` fixes all three at once, and the markup below is what makes
 * each of the phase's requirements true:
 *
 *   first slide    loading="eager" + fetchpriority="high", one src set, found
 *                  by the preload scanner in the first bytes of the document.
 *   other slides   NO src at all. They carry `data-*` and the rotator assigns
 *                  the source when it first shows them, so the initial load
 *                  downloads one hero image rather than three.
 *                  `loading="lazy"` would not have done this: a lazy image
 *                  inside the viewport loads immediately, and all three
 *                  slides are stacked full-bleed at the top of the page.
 *   every slide    explicit width/height so the box is reserved before the
 *                  bytes arrive, AVIF then WebP then JPEG, and a srcset at
 *                  480/768/1000 — the width of the sources, because
 *                  upscaling makes a bigger file and not a sharper picture.
 *
 * `object-fit: cover` + `object-position: center` reproduce
 * `background-size: cover` + `background-position: center` exactly, so the
 * crop, the overlay and the text are unchanged at every width.
 *
 * Variants are generated by `scripts/hero-variants.mjs`, which refuses to
 * emit a modern-format file larger than the JPEG it replaces.
 */
const slides = [
  { base: 'business-team', alt: '' },
  { base: 'business-introductions', alt: '' },
  { base: 'toronto-commercial-cleaning-business-meeting', alt: '' },
];

/** The sources are 1000x667; the hero is full-bleed, so sizes is 100vw. */
const WIDTHS = [480, 768, 1000] as const;
const NATURAL = { width: 1000, height: 667 };

const srcset = (base: string, ext: string) =>
  WIDTHS.map((w) => `/images/${base}-${w}.${ext} ${w}w`).join(', ');

/** The words the original theme rotated inside the hero heading. */
const words = [
  'Office Cleaning',
  'Building Maintenance',
  'Commercial Cleaning',
  'Janitorial Services',
  'Disinfection Cleaning',
];
---

<section class="hero" id="hero">
  <div class="hero-slides" aria-hidden="true">
    {
      slides.map((slide, i) => (
        <picture class:list={['hero-slide', i === 0 && 'is-active']}>
          {/* The first slide ships its sources. The rest carry them as data
              attributes and the rotator promotes them on first use, so the
              initial page load fetches one image, not three. */}
          {i === 0 ? (
            <>
              <source type="image/avif" srcset={srcset(slide.base, 'avif')} sizes="100vw" />
              <source type="image/webp" srcset={srcset(slide.base, 'webp')} sizes="100vw" />
              <img
                src={`/images/${slide.base}-1000.jpg`}
                srcset={srcset(slide.base, 'jpg')}
                sizes="100vw"
                width={NATURAL.width}
                height={NATURAL.height}
                alt={slide.alt}
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </>
          ) : (
            <>
              <source type="image/avif" data-srcset={srcset(slide.base, 'avif')} sizes="100vw" />
              <source type="image/webp" data-srcset={srcset(slide.base, 'webp')} sizes="100vw" />
              <img
                data-src={`/images/${slide.base}-1000.jpg`}
                data-srcset={srcset(slide.base, 'jpg')}
                sizes="100vw"
                width={NATURAL.width}
                height={NATURAL.height}
                alt={slide.alt}
                loading="lazy"
                decoding="async"
              />
            </>
          )}
        </picture>
      ))
    }
  </div>
  <div class="hero-overlay" aria-hidden="true"></div>

  {/* THE PAGE'S ONE h1.
      The original theme marks this up as `h2.hero-large-text` and puts the
      h1 down in the About band. That is backwards for a crawler: the first
      and most prominent thing on the page should be what the page is about.
      The h1 moved here and the About band's heading became an h2, which
      keeps the phrase "Toronto Office Cleaning Services" on the page and in
      the outline without the homepage carrying two h1s.

      Only the tag changed. `.hero-title` carries every pixel of the styling,
      so this renders identically.

      NOTE for whoever owns the copy: what a crawler and a screen reader
      actually read here is "Evergreen Office Cleaning, Building Maintenance,
      Commercial Cleaning, Janitorial Services, Disinfection Cleaning" — the
      five rotating words, read as a list. It is a weak h1 for a page
      targeting Toronto office cleaning. Rewriting hero copy is a content
      decision, not a markup one, so it is flagged rather than done. */}
  <div class="container hero-inner">
    <h1 class="hero-title">
      Evergreen{' '}
      <span class="hero-rotator">
        {
          words.map((word, i) => (
            <span class:list={['hero-word', i === 0 && 'is-active']}>
              {word}
              {/* Keeps the words apart for screen readers, which read all five. */}
              {i < words.length - 1 && <span class="screen-reader-text">, </span>}
            </span>
          ))
        }
      </span>
    </h1>

    <p class="hero-sub">
      Leaders in Commercial Cleaning and Building Maintenance in Toronto and the GTA
    </p>

    <p class="hero-actions">
      <a class="btn btn-primary btn-lg" href={nap.phoneHref}>Call now {nap.phoneDisplay}</a>
      <a class="btn btn-outline btn-lg" href="/request-a-quote/">Request a Quote</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--surface-dark);
    color: #fff;
    overflow: hidden;
  }

  .hero-slides,
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Was a div with a background-image. `object-fit: cover` and
     `object-position: center` on the img reproduce `background-size: cover`
     and `background-position: center` pixel for pixel. */
  .hero-slide {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    transition: opacity 1.2s ease-in-out;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .hero-slide.is-active {
    opacity: 1;
  }

  .hero-overlay {
    background: rgba(0, 0, 0, 0.3);
  }

  /* The original sets 12% top and bottom padding on the inner container. */
  .hero-inner {
    position: relative;
    text-align: center;
    padding-top: 12%;
    padding-bottom: 12%;
  }

  /* Measured from the original: 75px / 800 / uppercase, with the tracking
     stepping down alongside the size at each breakpoint. */
  .hero-title {
    font-family: var(--font-heading);
    color: #fff;
    font-size: 75px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: 4px;
    text-transform: uppercase;
    margin: 0 0 0.9375rem;
  }

  @media (max-width: 991px) {
    .hero-title {
      font-size: 60px;
      letter-spacing: 3px;
    }
  }

  @media (max-width: 767px) {
    .hero-title {
      font-size: 35px;
      letter-spacing: 2px;
    }
  }

  /* Every word sits in the same grid cell, so the heading keeps a stable
     width and the inactive words simply fade out behind the active one. */
  .hero-rotator {
    display: grid;
    max-width: 100%;
  }

  .hero-word {
    grid-area: 1 / 1;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .hero-word.is-active {
    opacity: 1;
  }

  /* The original's sub-line is 22px italic at weight 700. */
  .hero-sub {
    font-size: 22px;
    font-style: italic;
    font-weight: 700;
    letter-spacing: 0.4px;
    line-height: 1.7;
    color: #fff;
    max-width: none;
    margin: 0 auto 1.25rem;
  }

  @media (max-width: 767px) {
    .hero-sub {
      font-size: 18px;
    }
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 0;
  }

  .hero-actions .btn:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-word {
      transition: none;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');

  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('.hero-slide'));
    const words = Array.from(hero.querySelectorAll<HTMLElement>('.hero-word'));
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    /**
     * Promote a deferred slide's sources.
     *
     * Slides after the first ship with `data-src` / `data-srcset` and no
     * `src`, so the initial page load fetches one hero image rather than
     * three. `loading="lazy"` cannot do this job: these are stacked
     * full-bleed at the top of the page, so they are all inside the viewport
     * and a lazy image inside the viewport loads immediately.
     *
     * The <source> elements have to be promoted before the <img>, or the
     * browser picks a format from the sources it can see at the moment `src`
     * is set — which would be none of them, and it would take the JPEG.
     */
    const load = (slide: HTMLElement) => {
      if (slide.dataset.loaded) return;
      slide.dataset.loaded = 'true';

      slide.querySelectorAll<HTMLSourceElement>('source[data-srcset]').forEach((source) => {
        source.srcset = source.dataset.srcset ?? '';
        delete source.dataset.srcset;
      });

      const img = slide.querySelector<HTMLImageElement>('img[data-src]');
      if (!img) return;
      if (img.dataset.srcset) img.srcset = img.dataset.srcset;
      img.src = img.dataset.src ?? '';
      delete img.dataset.src;
      delete img.dataset.srcset;
    };

    const advance = (items: HTMLElement[], index: number) => {
      items[index]?.classList.remove('is-active');
      const next = (index + 1) % items.length;
      items[next]?.classList.add('is-active');
      return next;
    };

    /* Reduced motion: the first slide and the first word stay put, as
       rendered — and the other slides are never fetched at all. */
    if (!still.matches) {
      if (slides.length > 1) {
        let slide = 0;

        /* Warm the next slide once the page has finished loading, so the
           first transition is not a visible pop. After load, so it competes
           with nothing that matters. `requestIdleCallback` where it exists;
           Safari still does not have it. */
        const warm = () => load(slides[1]);
        if (document.readyState === 'complete') warm();
        else window.addEventListener('load', warm, { once: true });

        window.setInterval(() => {
          /* Fetch the one after next, not the one being shown — by the time
             a slide is fading in it is too late for it to have arrived. */
          load(slides[(slide + 2) % slides.length]);
          slide = advance(slides, slide);
        }, 6000);
      }

      if (words.length > 1) {
        let word = 0;
        window.setInterval(() => {
          word = advance(words, word);
        }, 2600);
      }
    }
  }
</script>
