---
/**
 * The Latest News band.
 *
 * The original is a **single column of list articles**, not a grid of cards:
 * a 300x150 thumbnail floated left with the copy flowing beside it, rules
 * above and below each entry. An earlier pass here built it as a three-card
 * grid with the picture on top, which is a different component entirely.
 *
 * Measured off the original's own render, and its `.list-article` rules:
 *
 *   article    border-top 1px #e9e9e9, 25px top and bottom; the last one also
 *              carries a border-bottom
 *   thumb      300x150, float left, 30px to its right
 *   meta       11px, 700, uppercase, 1.2px tracking, 10px below, brand green,
 *              and it reads just "Blog" — no date
 *   title      22px, weight 500, #333
 *   excerpt    15px, #777
 *   button     outline, not filled: transparent on a 1px brand border, brand
 *              text, 13px/600 uppercase, 2px radius, 8px/16px padding,
 *              inverting to solid on hover, 40px below the last entry
 *
 * The thumbnail has three states, which is easy to miss: it floats above
 * 940px, is **hidden entirely** between 721 and 940, and goes full width
 * below 720.
 *
 * The excerpt is WordPress's generated one — the first 30 words of the post
 * body followed by an ellipsis — not the post's meta description, which is
 * what this component was showing. 30, not WordPress's default 55: all three
 * of the original's excerpts stop at exactly 30 words.
 */
import { getCollection } from 'astro:content';

type Post = {
  id?: string;
  slug?: string;
  body?: string;
  data: { title: string; description?: string; pubDate: Date | string; image?: string };
};

// The blog collection may not be wired up yet; an empty list just drops the
// entries and leaves the "Visit Our Blog" button in place.
let entries: Post[] = [];
try {
  entries = (await getCollection('blog')) as unknown as Post[];
} catch {
  entries = [];
}

const toSlug = (post: Post) => String(post.slug ?? post.id ?? '').replace(/\.mdx?$/, '');
const toTime = (value: Date | string) => new Date(value).getTime();

/** WordPress's `the_excerpt()`: the body, stripped to text, first 30 words. */
const EXCERPT_WORDS = 30;

function excerpt(body: string | undefined, fallback: string | undefined): string {
  const text = (body ?? '')
    .replace(/```[\s\S]*?```/g, ' ') // fenced code
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ') // images
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // links keep their text
    .replace(/<[^>]+>/g, ' ') // inline html
    .replace(/^\s{0,3}#{1,6}\s+/gm, '') // heading markers
    .replace(/^\s{0,3}>\s?/gm, '') // block quotes
    .replace(/[*_~`]/g, '')
    .replace(/&nbsp;/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

  if (!text) return fallback ?? '';
  const words = text.split(' ');
  if (words.length <= EXCERPT_WORDS) return text;
  return `${words.slice(0, EXCERPT_WORDS).join(' ')} …`;
}

const posts = entries
  .slice()
  .sort((a, b) => toTime(b.data.pubDate) - toTime(a.data.pubDate))
  .slice(0, 3)
  .map((post) => ({ post, excerpt: excerpt(post.body, post.data.description) }));
---

<section class="section-news section-padding" id="news" aria-labelledby="news-title">
  <div class="container">
    <div class="section-title-area">
      <p class="section-subtitle">Evergreen Office Cleaning</p>
      <h2 class="section-title" id="news-title">Latest News</h2>
    </div>

    {
      posts.length > 0 && (
        <div class="blog-entry wow slideInUp">
          {posts.map(({ post, excerpt: text }) => (
            <article class="list-article">
              {post.data.image && (
                <div class="list-article-thumb">
                  <a href={`/${toSlug(post)}/`} tabindex="-1" aria-hidden="true">
                    <img
                      src={post.data.image}
                      alt=""
                      width="300"
                      height="150"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </div>
              )}
              <div class="list-article-content">
                <div class="list-article-meta">
                  <a href="/category/blog/" rel="category tag">
                    Blog
                  </a>
                </div>
                <header class="entry-header">
                  <h3 class="entry-title">
                    <a href={`/${toSlug(post)}/`} rel="bookmark">
                      {post.data.title}
                    </a>
                  </h3>
                </header>
                <div class="entry-excerpt">
                  <p>{text}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      )
    }

    <div class="all-news">
      <a class="btn-outline" href="/blog/">Visit Our Blog</a>
    </div>
  </div>
</section>

<style>
  /* `.section-news .list-article { border-top: 1px solid #e9e9e9; padding: 25px 0 }` */
  .list-article {
    border-top: 1px solid #e9e9e9;
    padding: 25px 0;
  }

  .list-article:last-of-type {
    border-bottom: 1px solid #e9e9e9;
  }

  /* Both the thumbnail and the copy beside it float, so the article clears. */
  .list-article::after {
    content: '';
    display: table;
    clear: both;
  }

  .list-article-thumb {
    float: left;
    margin-right: 30px;
  }

  .list-article-thumb img {
    display: block;
    width: 300px;
    height: 150px;
    object-fit: cover;
  }

  .list-article-thumb a:hover img {
    opacity: 0.8;
  }

  .list-article-content {
    float: none;
    overflow: hidden;
  }

  .list-article-meta {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 10px;
  }

  .list-article-meta a {
    color: var(--brand);
  }

  .entry-header {
    margin: 0;
  }

  .entry-title {
    font-size: 22px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink-heading);
    margin: 0 0 0.5rem;
  }

  .entry-title a {
    color: inherit;
  }

  .entry-title a:hover,
  .entry-title a:focus-visible {
    color: var(--brand);
  }

  .entry-excerpt p {
    margin: 0;
    font-size: 15px;
    color: var(--ink);
  }

  /* Three states, and the middle one is easy to miss: hidden entirely between
     721 and 940, full width below that. */
  @media screen and (max-width: 940px) {
    .list-article-thumb {
      display: none;
    }
  }

  @media screen and (max-width: 720px) {
    .list-article-thumb {
      display: block;
      float: none;
      width: 100%;
      margin-right: 0;
      margin-bottom: 30px;
    }

    .list-article-thumb img {
      width: 100%;
      height: auto;
    }
  }

  .all-news {
    margin-top: 40px;
    text-align: center;
  }

  /* `.btn-theme-primary-outline`: transparent on a 1px brand border, filling
     in on hover. */
  .btn-outline {
    display: inline-block;
    /* rem, not px: the original's button steps with the root font size —
       13px/8px/16px at a 16px root, 11.375/7/14 at 14. */
    padding: 0.5rem 1rem;
    border: 1px solid var(--brand);
    border-radius: 2px;
    background: transparent;
    color: var(--brand);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .btn-outline:hover,
  .btn-outline:focus-visible {
    background: var(--brand);
    color: #fff;
    text-decoration: none;
  }

  .btn-outline:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
</style>
