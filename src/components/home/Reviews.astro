---
/**
 * The Google reviews band (the original's `sid1679612802692`): the heading, the
 * five-star badge, and the Trustindex review slider.
 *
 * The widget itself is a third-party script and is not reproduced — this is a
 * static slider carrying the same four reviews, read out of the widget's own
 * `<template>` in the archived page. See `src/data/reviews.ts`.
 *
 * Its settings come from that template's attributes rather than guesswork:
 * a slider, up to three columns, cards targeting 300px, six-second autoplay
 * and left-aligned text.
 *
 * The behaviour is read from Trustindex's own loader.js, which is still served
 * from their CDN, rather than inferred from a screenshot:
 *
 *   - Autoplay is `setInterval(move, 6000)` with a 1000ms animation, held
 *     while `isMouseOver`.
 *   - There is no `data-slider-loop` on this widget, and without it the
 *     slider does not wrap: `toggleNavigation` hides the next control at the
 *     last review and flips the autoplay direction to "prev", then flips back
 *     at the first. It paces to the end and walks back.
 *   - Its next/prev controls are not on show — the original's visible surface
 *     is the timer, a swipe, and the arrow keys while it is on screen.
 *   - "Read more" appears only where the text is actually clipped. Where it is
 *     not, the widget replaces the label with a non-breaking space and sets
 *     opacity to 0 instead of removing it, which is what keeps the cards in a
 *     row the same height. Opening animates the text box's height over half a
 *     second and swaps the label to the template's "Hide".
 *
 * One deliberate difference: the original's badge is a bare `<img>` whose alt
 * calls it a "button" but which does not link anywhere. It links to the
 * business's Google review page here. Nothing about it looks different.
 */
import { relativeAge, reviews } from '../../data/reviews';

const reviewUrl = 'https://g.page/r/CW9cqxQ9_IfYEBM/review';
const cards = reviews.map((r) => ({ ...r, age: relativeAge(r.date) }));
---

<section class="section-padding section-alt" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-title-area">
      <h2 class="section-title" id="reviews-title">Google Reviews</h2>
      <div class="section-desc">
        <a href={reviewUrl} target="_blank" rel="noopener noreferrer">
          <img
            src="/images/google-reviews-5-star.png"
            alt="Read our Google reviews"
            width="124"
            height="93"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>

    <div class="ti" data-autoplay="6000">
      <div class="ti-track" role="group" aria-label="Google reviews">
        {
          cards.map((r) => (
            <article class="ti-card">
              <header class="ti-head">
                <img
                  class="ti-avatar"
                  src={r.avatar}
                  srcset={`${r.avatar} 1x, ${r.avatar.replace(/\.png$/, '-2x.png')} 2x`}
                  alt=""
                  width="40"
                  height="40"
                  loading="lazy"
                  decoding="async"
                />
                <div class="ti-who">
                  <p class="ti-name">{r.name}</p>
                  <p class="ti-age">{r.age}</p>
                </div>
                <svg class="ti-source" viewBox="0 0 24 24" aria-label="Google" role="img">
                  <path
                    fill="#4285F4"
                    d="M23.5 12.27c0-.79-.07-1.54-.2-2.27H12v4.51h6.47a5.53 5.53 0 0 1-2.4 3.58v3h3.86c2.26-2.09 3.57-5.17 3.57-8.82"
                  />
                  <path
                    fill="#34A853"
                    d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.86-3c-1.08.72-2.45 1.16-4.07 1.16-3.13 0-5.78-2.11-6.73-4.96H1.29v3.09A11.99 11.99 0 0 0 12 24"
                  />
                  <path
                    fill="#FBBC05"
                    d="M5.27 14.29a7.2 7.2 0 0 1 0-4.58V6.62H1.29a12 12 0 0 0 0 10.76z"
                  />
                  <path
                    fill="#EA4335"
                    d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.7 0 3.99 2.47 1.29 6.62l3.98 3.09C6.22 6.86 8.87 4.75 12 4.75"
                  />
                </svg>
              </header>

              <p class="ti-stars">
                <span class="screen-reader-text">{r.rating} out of 5</span>
                {Array.from({ length: r.rating }).map(() => (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      fill="#f6bb06"
                      d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 6.91-1.01z"
                    />
                  </svg>
                ))}
                {r.verified && (
                  <svg class="ti-verified" viewBox="0 0 24 24" role="img">
                    <title>Trustindex verifies that the original source of the review is Google.</title>
                    <path
                      fill="#4285F4"
                      d="M12 1.2l2.2 1.7 2.8-.2.9 2.6 2.4 1.4-.8 2.7.8 2.7-2.4 1.4-.9 2.6-2.8-.2L12 17.6l-2.2-1.7-2.8.2-.9-2.6-2.4-1.4.8-2.7-.8-2.7 2.4-1.4.9-2.6 2.8.2z"
                    />
                    <path
                      fill="none"
                      stroke="#fff"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m8.6 9.4 2.3 2.3 4.1-4.1"
                    />
                  </svg>
                )}
              </p>

              <div class="ti-text">
                <p>{r.text}</p>
              </div>
              {/* Rendered for every card, blanked by the script on the ones
                  that are not clipped — that is how the original keeps the
                  cards the same height. */}
              <button class="ti-more" type="button" aria-expanded="false">Read more</button>
            </article>
          ))
        }
      </div>

    </div>
  </div>
</section>

<style>
  .section-desc {
    margin-top: 18px;
  }

  .section-desc img {
    display: block;
    margin: 0 auto;
    width: 124px;
    height: auto;
  }

  /* --- the slider --- */
  /* The track scrolls horizontally, and its off-screen cards otherwise count
     towards the document's scrollWidth. Nothing could be scrolled sideways —
     `body` has `overflow-x: hidden` — but it made the page look like it
     overflowed by 785px at 390, which hides a real overflow if one ever
     appears. Containing it here keeps that check meaningful. */
  .ti {
    position: relative;
    overflow: hidden;
  }

  .ti-track {
    display: grid;
    grid-auto-flow: column;
    /* Cards target 300px, so the container's stepped widths give one, two and
       three across — which is why the original shows two at 940px. */
    grid-auto-columns: 100%;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .ti-track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .ti-track {
      grid-auto-columns: calc((100% - 20px) / 2);
    }
  }

  @media (min-width: 992px) {
    .ti-track {
      grid-auto-columns: calc((100% - 40px) / 3);
    }
  }

  .ti-card {
    scroll-snap-align: start;
    background: #f4f4f4;
    border-radius: 12px;
    padding: 20px;
    text-align: left;
  }

  .ti-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .ti-avatar {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .ti-who {
    min-width: 0;
    flex: 1;
  }

  .ti-name {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    color: #0c0c0c;
  }

  .ti-age {
    margin: 2px 0 0;
    font-size: 14px;
    line-height: 1.2;
    color: #6b6b6b; /* was #808080 — 3.59:1 on the #f4f4f4 card */
  }

  .ti-source {
    flex: none;
    width: 22px;
    height: 22px;
    align-self: flex-start;
  }

  .ti-stars {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0 0 12px;
  }

  .ti-stars svg {
    width: 19px;
    height: 19px;
  }

  .ti-verified {
    width: 18px;
    height: 18px;
    margin-left: 6px;
  }

  /* 17px is not a guess: the original fits "I highly recommend Art and the
     team" into the 299px the card leaves for text, and breaks there. At 15px
     the same string measured 246px here and " at" came up onto the first line.
     The widget sets its own typeface, so matching by size alone would not have
     reproduced the break. */
  .ti-text p {
    margin: 0;
    font-size: 17px;
    line-height: 1.45;
    color: #111;
    /* Four lines, then an ellipsis — the widget's "readmore" text mode. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
  }

  /* The widget animates the text box's height open and shut over half a
     second rather than snapping. */
  .ti-text {
    overflow: hidden;
    transition: height 0.5s ease;
  }

  .ti-card.is-open .ti-text p {
    -webkit-line-clamp: unset;
  }

  .ti-more {
    display: block;
    margin: 6px 0 0;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-size: 15px;
    line-height: 1.45;
    color: #6b6b6b; /* was #7a7a7a — 3.90:1 on the #f4f4f4 card */
    text-align: left;
    cursor: pointer;
  }

  .ti-more:hover {
    color: #111;
  }

  /* A review short enough not to be clipped still keeps this line, invisible
     and unclickable, so every card in a row is the same height. That is what
     the widget does — it replaces the label with a non-breaking space and
     sets opacity to 0 rather than removing it. */
  .ti-more.is-blank {
    opacity: 0;
    pointer-events: none;
  }

  .ti-more:focus-visible,
  .section-desc a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ti-text {
      transition: none;
    }
  }
</style>

<script>
  for (const slider of document.querySelectorAll<HTMLElement>('.ti')) {
    const track = slider.querySelector<HTMLElement>('.ti-track')!;
    const cards = [...track.querySelectorAll<HTMLElement>('.ti-card')];
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    // --- "Read more" ---
    //
    // The widget shows the control only where the text is actually clipped,
    // and where it is not it keeps the line as a blank rather than removing
    // it, so the cards in a row stay the same height. Opening animates the
    // text box's height and swaps the label to "Hide".
    for (const card of cards) {
      const box = card.querySelector<HTMLElement>('.ti-text')!;
      const para = box.querySelector<HTMLElement>('p')!;
      const more = card.querySelector<HTMLButtonElement>('.ti-more')!;

      const measure = () => {
        if (card.classList.contains('is-open')) return;
        // The clamp is on the paragraph, so the paragraph is what overflows.
        // Measuring the wrapper instead reports every card as unclipped.
        const clipped = para.scrollHeight > para.clientHeight + 1;
        more.classList.toggle('is-blank', !clipped);
        more.setAttribute('aria-hidden', String(!clipped));
        more.tabIndex = clipped ? 0 : -1;
      };

      more.addEventListener('click', () => {
        const from = box.offsetHeight;
        const open = !card.classList.contains('is-open');
        card.classList.toggle('is-open', open);
        more.textContent = open ? 'Hide' : 'Read more';
        more.setAttribute('aria-expanded', String(open));
        // from a fixed height to the new one, so there is something to animate
        const to = open ? box.scrollHeight : box.clientHeight;
        box.style.height = `${from}px`;
        requestAnimationFrame(() => {
          box.style.height = `${to}px`;
        });
        window.setTimeout(() => {
          box.style.height = '';
        }, 520);
      });

      measure();
      window.addEventListener('resize', measure);
    }

    // --- the slider ---
    //
    // This widget carries no `data-slider-loop`, and without it the original
    // does not wrap: at the last review it hides its next control and flips
    // its own autoplay direction to "prev", then flips back at the first. So
    // it paces to the end and walks back, rather than jumping to the start.
    let dir = 1;

    const step = () => {
      const card = cards[0];
      if (!card) return;
      const by = card.getBoundingClientRect().width + 20;
      const max = track.scrollWidth - track.clientWidth;
      if (max <= 1) return; // everything already fits; nothing to move
      if (track.scrollLeft >= max - 1) dir = -1;
      if (track.scrollLeft <= 1) dir = 1;
      track.scrollTo({
        left: Math.min(max, Math.max(0, track.scrollLeft + dir * by)),
        behavior: still.matches ? 'auto' : 'smooth',
      });
    };

    // The original has no visible arrows; it moves on its own timer, on a
    // swipe, and on the arrow keys while it is on screen. Keeping the arrow
    // keys is what leaves it reachable without a mouse.
    document.addEventListener('keyup', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      const box = slider.getBoundingClientRect();
      if (box.bottom < 0 || box.top > window.innerHeight) return;
      dir = e.key === 'ArrowRight' ? 1 : -1;
      step();
    });

    // Six seconds, from the widget's own data-pager-autoplay-timeout. It
    // holds while the pointer is over the widget, as the original's
    // `isMouseOver` does, and also while focus is inside it or the tab is in
    // the background — and never starts if the visitor asked for less motion.
    const wait = Number(slider.dataset.autoplay ?? 6000);
    let timer: number | undefined;
    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (still.matches) return;
      timer = window.setInterval(step, wait);
    };

    slider.addEventListener('pointerenter', stop);
    slider.addEventListener('pointerleave', start);
    slider.addEventListener('focusin', stop);
    slider.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    still.addEventListener('change', start);
    start();
  }
</script>
