---
/**
 * Why Evergreen — the homepage's case, from the business's own statements:
 * the three offers its original About section made, the verified trust
 * points, and the process. The superlatives that section also carried ("we're
 * simply the best") are not repeated; they are claims nobody can check.
 */
import TrustStrip from '../blocks/TrustStrip.astro';
import ProcessSteps from '../blocks/ProcessSteps.astro';
import { hoursNote } from '../../data/site';

/* "Monday to Friday 7am–6pm", read from the one place the hours are kept, so
   the reply promise below cannot drift from the hours the site publishes. */
const officeHours = hoursNote.replace(/^Office hours:\s*/, '');

const OFFERS = [
  {
    title: 'Flexible scheduling',
    body: 'We work after hours and at weekends to keep disruption to your employees and clients to a minimum, and plan the work around your schedule.',
  },
  {
    title: 'Proactive maintenance programmes',
    body: 'Periodic floor and surface care planned into the year, using professional equipment and current techniques, to extend the life of your floors and finishes.',
  },
  {
    title: 'A dedicated account executive',
    body: 'One person who responds to your concerns, coordinates walkthroughs and inspections, and adjusts the scope as your needs change.',
  },
];
---

<section class="section-padding" id="why" aria-labelledby="why-title">
  <div class="container stack">
    <div>
      <h2 class="blk-title" id="why-title">Why Toronto businesses choose Evergreen</h2>
      {/* SEO re-audit, 7 Nov 2026 (GEO N2): this said "Four things, each
          written into every contract since 1989", which nothing evidences,
          and a reply time cannot be a contract term. It is now stated as
          what it is, a commitment, and the 2-hour reply is qualified with
          the office hours, as the how-often guide already does. */}
      <p class="blk-intro">
        Four commitments we make to every client: the same crew at every visit, a scope agreed at a
        free walkthrough and set out in writing, cleaning done after hours so nobody works around us,
        and a reply to every enquiry within 2 hours during office hours ({officeHours}). Professional
        firms, clinics, retail outlets, industrial buildings and warehouses across Toronto and the GTA
        run on that.
      </p>
      <div class="why-grid" data-reveal="stagger">
        {
          OFFERS.map((o) => (
            <div>
              <h3>{o.title}</h3>
              <p>{o.body}</p>
            </div>
          ))
        }
      </div>
    </div>
    <TrustStrip />
    <ProcessSteps heading="How it works" />
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    gap: 22px;
  }
  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .why-grid h3 {
    font-size: 1.15rem;
    margin: 0 0 6px;
    color: var(--brand-dark);
  }
  .why-grid p {
    margin: 0;
  }
</style>
