---
/**
 * Where the crews go — one line, and deliberately not ten links.
 *
 * The site's footer turns this list into ten links to /locations/ pages. On a
 * paid landing page every one of those is a way out of a page somebody was
 * paid to arrive on, so here the same information is plain text.
 */
import { SERVICE_AREA_LINE } from '../../data/landing';

interface Props {
  /** The towns, as one sentence. Omit for the shared `SERVICE_AREA_LINE`. */
  line?: string;
}

const { line = SERVICE_AREA_LINE } = Astro.props;
---

<section class="lpx-areas" aria-label="Service area">
  <div class="lpx-wrap">
    <p><strong>Where we work:</strong> {line}</p>
  </div>
</section>
