---
/**
 * Why this business — four points, each one the site already makes.
 *
 * The copy is in `src/data/landing.ts` so the two pages cannot drift apart
 * again; before this they carried four differentiators each and only two of
 * the eight agreed.
 */
import { BENEFITS } from '../../data/landing';

interface Props {
  heading?: string;
}
const { heading = 'What you get' } = Astro.props;
---

<section class="lpx-section" aria-labelledby="lpx-benefits-h">
  <div class="lpx-wrap">
    <h2 id="lpx-benefits-h">{heading}</h2>
    <p class="lpx-section-note">
      Commercial cleaning across Toronto and the GTA, on a written scope you can hold us to.
    </p>
    <ul class="lpx-cards lpx-cards-4">
      {
        BENEFITS.map((b) => (
          <li>
            <strong>{b.title}</strong>
            <span>{b.body}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
