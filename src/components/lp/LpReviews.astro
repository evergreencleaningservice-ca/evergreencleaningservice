---
/**
 * Genuine reviews, and only genuine reviews.
 *
 * Every word is the reviewer's own, recovered from the Trustindex template in
 * the archive — see `src/data/reviews.ts` for how. The star row on each card
 * is the rating THAT PERSON left, which is a fact about that review.
 *
 * WHAT IS NOT HERE, AND WHY IT KEEPS NOT BEING HERE. No average, no "4.9/5",
 * no review count, no "5-star rated by local clients". There are four
 * recovered reviews and no verified aggregate from the business's Google
 * profile. Phase 7 removed an invented 4.9/5 from both landing pages; this
 * component is the reason it cannot come back by accident, because the pages
 * no longer write their own review markup.
 *
 * The previous version of this markup also failed an accessibility audit:
 * `aria-label` on a `<p>` is prohibited (a paragraph has no accessible name),
 * which cost the quote landing page 4 Lighthouse points. The rating is now
 * announced as ordinary text inside a visually-hidden span.
 */
import { reviews } from '../../data/reviews';

interface Props {
  heading?: string;
  /** Reviewer names to show, in order. Defaults to the first three. */
  names?: readonly string[];
}

const { heading = 'What Toronto businesses say', names } = Astro.props;

const picked = names
  ? names.map((n) => reviews.find((r) => r.name === n)).filter((r): r is NonNullable<typeof r> => Boolean(r))
  : reviews.slice(0, 3);
---

<section class="lpx-section" aria-labelledby="lpx-reviews-h">
  <div class="lpx-wrap">
    <h2 id="lpx-reviews-h">{heading}</h2>
    <p class="lpx-section-note">Reviews left on Google by Evergreen clients.</p>
    <ul class="lpx-reviews">
      {
        picked.map((r) => (
          <li>
            <p class="lpx-review-stars">
              <span aria-hidden="true">{'★'.repeat(r.rating)}</span>
              <span class="lpx-sr">{r.rating} out of 5</span>
            </p>
            <p class="lpx-review-body">{r.text}</p>
            <p class="lpx-review-who">
              <strong>{r.name}</strong>
              <span>Google review</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style is:global>
  .lpx-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
