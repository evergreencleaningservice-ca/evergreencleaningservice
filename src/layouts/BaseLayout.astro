---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadVideo from '../components/LeadVideo.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import { site } from '../data/site';
import { organizationGraph } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image ?? site.logo, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/*
      Weights chosen by measuring which faces actually compute on the original,
      not by reading its @font-face list. Raleway 800 carries the hero heading
      and every section title, and Open Sans italic carries the hero sub-line —
      without them the browser synthesises fake bold and fake oblique, which
      looks close in a computed-style dump and wrong on screen.
    */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,400;1,700&family=Raleway:wght@400;500;600;700;800&display=swap"
    />

    {/* Section 2.4: the organisation graph, on every page. */}
    <script type="application/ld+json" set:html={JSON.stringify(organizationGraph())} is:inline />

    <GoogleTagManager />

    <slot name="head" />

    {/* Blocks that never get observed must not stay hidden. is:inline keeps
        Astro from scoping this to the layout, where it would match nothing. */}
    <noscript>
      <style is:inline>.wow { visibility: visible !important; }</style>
    </noscript>
  </head>
  <body>
    <GoogleTagManager noscript />

    {/* `#page` and `#content` are the original's ids: the skip link and the
        footer's back-to-top arrow both address them. */}
    <div id="page" class="site">
      <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
      <Header />
      <div id="content" class="site-content">
        <main id="main" class="site-main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>

    {/* The original loads this site-wide, as a third-party script. It renders
        nothing until the client's clip is in public/video/ — see the note in
        the component. */}
    <LeadVideo />

    <script>
      // Stands in for WOW.js: reveal each `.wow` block as it scrolls into view.
      const blocks = document.querySelectorAll<HTMLElement>('.wow');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const reveal = (el: HTMLElement) => {
        el.style.visibility = 'visible';
        el.classList.add('animated');
      };

      if (still || !('IntersectionObserver' in window)) {
        for (const el of blocks) reveal(el);
      } else {
        const waiting = new Set<HTMLElement>(blocks);
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              reveal(el);
              waiting.delete(el);
              io.unobserve(el);
            }
          },
          // the theme fires a little before the block is fully on screen
          { rootMargin: '0px 0px -10% 0px', threshold: 0 }
        );
        for (const el of blocks) io.observe(el);

        /* A jump — an anchor link, a dot on the side nav, a restored scroll
           position — moves a block from below the viewport to above it without
           ever intersecting, and the observer never fires for it. WOW.js scans
           every box on every scroll and so never loses one; this sweep does the
           same for anything the observer has passed over, which is what keeps a
           section from being left parked at `visibility: hidden`. */
        let queued = false;
        const sweep = () => {
          queued = false;
          const edge = window.innerHeight * 0.9;
          for (const el of waiting) {
            if (el.getBoundingClientRect().top < edge) {
              reveal(el);
              waiting.delete(el);
              io.unobserve(el);
            }
          }
          if (!waiting.size) window.removeEventListener('scroll', onScroll);
        };
        const onScroll = () => {
          if (queued) return;
          queued = true;
          requestAnimationFrame(sweep);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
      }
    </script>
  </body>
</html>
