---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadVideo from '../components/LeadVideo.astro';
import GoogleTagManager from '../components/GoogleTagManager.astro';
import Attribution from '../components/Attribution.astro';
import PhoneTracking from '../components/PhoneTracking.astro';
import { images, site } from '../data/site';
import { organizationGraph } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
/* Social previews use the 1200x630 crop generated beside each master. */
const ogPath = image
  ? image.replace(/(-\d+x\d+)?\.(jpe?g|png|webp|avif)$/i, '-og.jpg')
  : '/images/evergreen-modern-commercial-cleaning-hero-og.jpg';
const ogImage = new URL(ogPath, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* As high in the head as possible, per Google's install instructions —
        only the two metas the browser needs before anything else precede it. */}
    <GoogleTagManager />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* A bare /favicon.ico request is made by every browser whether or not
        the document asks for one, and without a file it is a 404 in the
        console — which Lighthouse counts against Best Practices.

        The .ico carries THREE sizes — 16 for the tab, 32 for the bookmark
        bar, 48 for a Windows shortcut — so `sizes` lists all three. It
        claimed only 32x32 while the file held one image, and both halves of
        that were wrong once the icon was rebuilt from the real logo mark. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_CA" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />

    {/* The hero image — this page's LCP — is served from the image bucket,
        a different origin from the document. Without this the browser cannot
        even begin the DNS lookup and TLS handshake for it until it has
        parsed the markup that references it. One preconnect buys back that
        round trip on the single most important request on the page. */}
    <link rel="preconnect" href={images.host} />
    {/* The two faces the first screen uses, preloaded (2026-10-15), as the
        landing pages already do. Without it the H1 paints in the fallback
        and reflows when Raleway lands: measured CLS 0.139 on the mobile
        service page. Same origin, so no extra connection. */}
    <link rel="preload" href="/fonts/raleway.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/open-sans.woff2" as="font" type="font/woff2" crossorigin />
    {/*
      Weights chosen by measuring which faces actually compute on the original,
      not by reading its @font-face list. Raleway 800 carries the hero heading
      and every section title, and Open Sans italic carries the hero sub-line —
      without them the browser synthesises fake bold and fake oblique, which
      looks close in a computed-style dump and wrong on screen.
    */}

    {/* Section 2.4: the organisation graph, on every page. */}
    <script type="application/ld+json" set:html={JSON.stringify(organizationGraph())} is:inline />

    <Attribution />

    <slot name="head" />

  </head>
  <body>
    <GoogleTagManager noscript />

    {/* `#page` and `#content` are the original's ids: the skip link and the
        footer's back-to-top arrow both address them. */}
    <div id="page" class="site">
      <a class="skip-link screen-reader-text" href="#content">Skip to content</a>
      <Header />
      <div id="content" class="site-content">
        <main id="main" class="site-main">
          <slot />
        </main>
      </div>
      <Footer />
    </div>

    {/* The original loads this site-wide, as a third-party script. It renders
        nothing until the client's clip is in public/video/ — see the note in
        the component. */}
    <LeadVideo />


    <PhoneTracking />
  </body>
</html>
