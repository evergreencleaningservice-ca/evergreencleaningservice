---
import { getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
/* The italic face, for blockquotes: posts are the only pages that use it. */
import '../styles/fonts-italic.css';
import { articleSchema, breadcrumbSchema } from '../lib/schema';
import { responsiveSet } from '../lib/responsive-images.mjs';
import { intrinsic, thumbSet } from '../lib/thumb';
import { site } from '../data/site';

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, image, imageAlt, guide } = post.data;
if (!guide) throw new Error(`GuideLayout requires guide metadata: ${post.id}`);
const readingMinutes = Math.max(1, Math.ceil((post.body ?? '').replace(/<[^>]*>/g, ' ').split(/\s+/).length / 220));
const longDate = pubDate.toLocaleDateString('en-CA', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const featured = image ? responsiveSet(image) : null;
const sizes = '(min-width: 912px) 880px, calc(100vw - 32px)';
const related = await Promise.all(guide.related.map(async (item) => {
  const entry = await getEntry('blog', item.slug);
  if (!entry) throw new Error(`Unknown related article: ${item.slug}`);
  /* The card's picture: the related post's featured image at 480/720 (or
     768) in AVIF, WebP and JPEG (src/lib/thumb.ts), not the WordPress
     300x150 crop it drew until 6 Nov 2026. */
  const image = entry.data.image;
  return { ...item, entry, image, set: thumbSet(image), size: intrinsic(image) };
}));
/* Half of the 880px column less the 24px gap, two up from 561px, one up below. */
const relatedSizes = '(min-width: 912px) 428px, (min-width: 561px) calc(50vw - 28px), calc(100vw - 32px)';
---

<BaseLayout title={seoTitle ?? title} description={description} image={image} imageAlt={imageAlt}
  type="article" publishedTime={pubDate.toISOString()} modifiedTime={updatedDate?.toISOString()}>
  <script slot="head" type="application/ld+json" is:inline
    set:html={JSON.stringify(articleSchema({ title, description, pubDate, updatedDate, image, slug: post.id }))} />
  {/* The root is the site's name, as on every other page's BreadcrumbList.
      It said "Home" on the three guides only (SEO re-audit, 7 Nov 2026,
      schema N1/S10); the visible trail below still reads "Home". */}
  <script slot="head" type="application/ld+json" is:inline
    set:html={JSON.stringify(breadcrumbSchema([
      { name: site.name, url: '/' }, { name: 'Insights', url: '/insights/' }, { name: guide.breadcrumb },
    ]))} />

  <div class="guide section-padding">
    <div class="guide-column">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">→</span>
        <a href="/insights/">Insights</a> <span aria-hidden="true">→</span>
        <span aria-current="page">{guide.breadcrumb}</span>
      </nav>
      <article aria-labelledby="guide-title">
        <header class="guide-heading">
          <p class="guide-category">{guide.category}</p>
          <h1 id="guide-title">{title}</h1>
          <p class="guide-meta">Published <time datetime={pubDate.toISOString().slice(0, 10)}>{longDate}</time>
            <span aria-hidden="true"> · </span> {readingMinutes} min read
            <span aria-hidden="true"> · </span> By {site.name}</p>
          <p class="guide-intro">{guide.intro}</p>
        </header>
        {image && <figure class="guide-featured">
          <picture>
            {featured && <source type="image/avif" srcset={featured.avif} sizes={sizes} />}
            {featured && <source type="image/webp" srcset={featured.webp} sizes={sizes} />}
            <img src={image} srcset={featured?.jpg} sizes={featured ? sizes : undefined}
              alt={imageAlt ?? ''} width="1200" height="675" fetchpriority="high" decoding="async" />
          </picture>
        </figure>}
        {/* The label is a paragraph, not an H2 (SEO re-audit, 7 Nov 2026,
            item 14): as a heading it put "In this guide" first in every
            guide's outline, ahead of the sections it lists. The nav keeps
            its name through aria-labelledby, and the class keeps the look. */}
        <nav class="guide-toc" aria-labelledby="guide-toc-title">
          <p class="guide-toc-title" id="guide-toc-title">In this guide</p>
          <ol>{guide.contents.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ol>
        </nav>
        <div class="entry-content guide-body"><slot /></div>
        {guide.showCta && <section class="guide-cta" id="requesting-a-cleaning-quote" aria-labelledby="quote-heading">
          <h2 id="quote-heading">{guide.ctaHeading ?? 'Get a Cleaning Quote for Your Office'}</h2>
          <p>{guide.ctaText ?? 'Every building is different. Schedule a free on-site walkthrough and receive a written cleaning scope tailored to your needs.'}</p>
          <a class="btn btn-primary" href="/request-a-quote/">Request a Free Quote</a>
          <p class="guide-phone">Or call <a href="tel:+14168034880" data-call-location="content">+1 (416) 803-4880</a></p>
          {guide.ctaResponse && <p>{guide.ctaResponse}</p>}
        </section>}
      </article>
      <aside class="guide-related" aria-labelledby="related-heading">
        <h2 id="related-heading">Related articles</h2>
        <div class="guide-related-grid" data-reveal="stagger">{related.map(({ slug, label, image, set, size }) => (
          <a class="guide-related-card" href={`/${slug}/`}>
            {image && <picture>
              {set && <source type="image/avif" srcset={set.avif} sizes={relatedSizes} />}
              {set && <source type="image/webp" srcset={set.webp} sizes={relatedSizes} />}
              <img src={set?.src ?? image} srcset={set?.jpg} sizes={set ? relatedSizes : undefined}
                alt="" width={(set ?? size)?.width} height={(set ?? size)?.height} loading="lazy" decoding="async" />
            </picture>}
            <h3>{label}</h3>
          </a>
        ))}</div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .guide-column { width: min(880px, calc(100% - 32px)); margin-inline: auto; }
  .guide .breadcrumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px; }
  .guide-category { color: var(--brand-dark); font-weight: 700; margin-bottom: 10px; }
  .guide-heading h1 { font-size: clamp(2rem, 4.5vw, 3rem); line-height: 1.15; margin-bottom: 18px; }
  .guide-meta { color: var(--ink-muted); font-size: .875rem; margin-bottom: 20px; }
  .guide-intro { font-size: 1.125rem; line-height: 1.75; max-width: 72ch; margin-bottom: 28px; }
  .guide-featured { margin: 0 0 32px; }
  .guide-featured img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; border-radius: var(--radius); }
  .guide-featured figcaption, .guide-body :global(figcaption) { margin-top: 8px; color: var(--ink-muted); font-size: .8125rem; }
  .guide-toc { padding: 24px; border-left: 4px solid var(--brand); background: var(--surface-tint); margin-bottom: 40px; }
  /* The global h2 rule's face, weight, colour, line-height and balance,
     which the label had as an H2, then the size and gap it had here. */
  .guide-toc-title { font-family: var(--font-heading); color: var(--ink-heading); font-weight: 600; line-height: 1.2; text-wrap: balance; font-size: 1.25rem; margin: 0 0 12px; }
  .guide-toc ol { margin: 0; padding-left: 24px; }
  .guide-toc li { padding-block: 4px; }
  .guide a:focus-visible, .guide :global(summary:focus-visible), .guide :global([tabindex]:focus-visible) { outline: 3px solid var(--brand-dark); outline-offset: 4px; }
  .guide-body { font-size: 1rem; }
  .guide-body :global(p), .guide-body :global(li) { font-size: 1rem; line-height: 1.8; }
  .guide-body :global(h2) { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.3; margin-top: 44px; }
  .guide-body :global(h3) { line-height: 1.4; margin-top: 24px; }
  .guide-body :global([id]), .guide-cta { scroll-margin-top: 120px; }
  .guide-body :global(.guide-factors) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 24px 0; }
  .guide-body :global(.guide-factor) { padding: 22px; border: 1px solid var(--rule); border-radius: var(--radius); }
  .guide-body :global(.guide-factor h3) { margin-top: 0; font-size: 1.125rem; }
  .guide-body :global(.guide-factor p) { margin-bottom: 0; }
  .guide-body :global(.guide-icon) { color: var(--brand-dark); display: block; width: 28px; height: 28px; margin-bottom: 14px; }
  .guide-body :global(.guide-table) { overflow-x: auto; margin: 24px 0; }
  .guide-body :global(.guide-table table) { display: table; width: 100%; margin: 0; font-size: .9375rem; }
  .guide-body :global(caption) { text-align: left; margin-bottom: 12px; font-weight: 700; color: var(--ink-heading); }
  .guide-body :global(th) { background: var(--surface-tint); color: var(--ink-heading); }
  .guide-body :global(th), .guide-body :global(td) { vertical-align: top; padding: 12px 16px; }
  .guide-body :global(.guide-scope table) { min-width: 580px; }
  .guide-body :global(.guide-panel) { padding: 28px; margin: 24px 0; background: var(--surface-tint); border-left: 4px solid var(--brand); }
  .guide-body :global(.guide-example) { margin: 20px 0; }
  .guide-body :global(.guide-example div) { display: flex; justify-content: space-between; gap: 16px; padding-block: 10px; border-bottom: 1px solid var(--rule); }
  .guide-body :global(.guide-example dd) { margin: 0; font-weight: 700; text-align: right; color: var(--ink-heading); }
  .guide-body :global(figure) { margin: 30px 0; }
  .guide-body :global(figure img) { width: 100%; height: auto; margin: 0; border-radius: var(--radius); }
  .guide-body :global(details) { border-bottom: 1px solid var(--rule); padding-block: 18px; }
  .guide-body :global(summary) { cursor: pointer; font-weight: 700; color: var(--ink-heading); padding-block: 6px; font-size: 1rem; }
  .guide-body :global(summary h3) { display: inline; margin: 0; font-size: inherit; }
  .guide-body :global(details p) { margin: 14px 0 0; }
  .guide-cta { padding: clamp(24px, 5vw, 40px); border: 1px solid var(--brand); border-radius: var(--radius); margin: 44px 0; background: var(--surface-tint); }
  .guide-cta h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.3; }
  .guide-cta p { max-width: 65ch; }
  .guide-phone { margin: 18px 0 0; }
  .guide-related { margin-bottom: 48px; }
  .guide-related h2 { font-size: 1.5rem; }
  .guide-related-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  /* The same lift as `.card-hover` in global.css, written out here: the build
     test for these cards matches the anchor's exact class attribute. */
  .guide-related-card { display: block; border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; transition: border-color var(--motion-fast) ease, box-shadow var(--motion-base) var(--ease-out), transform var(--motion-base) var(--ease-out); }
  .guide-related-card:hover, .guide-related-card:focus-visible { border-color: var(--brand); }
  @media (hover: hover) { .guide-related-card:hover { transform: translateY(var(--lift)); box-shadow: var(--shadow-lift); } }
  .guide-related-card img { width: 100%; height: auto; aspect-ratio: 2 / 1; object-fit: cover; transition: transform 600ms var(--ease-out); }
  .guide-related-card h3 { font-size: 1.125rem; line-height: 1.5; margin: 0; padding: 20px; transition: color var(--motion-fast) ease; }
  .guide-related-card:hover, .guide-related-card:focus-visible { text-decoration: none; }
  .guide-related-card:hover h3, .guide-related-card:focus-visible h3 { color: var(--brand-dark); text-decoration: underline; }
  @media (hover: hover) { .guide-related-card:hover img { transform: scale(1.04); } }
  @media (max-width: 560px) {
    .guide-body :global(.guide-factors), .guide-related-grid { grid-template-columns: 1fr; }
    .guide-toc { padding: 20px; }
    .guide-body :global(.guide-panel) { padding: 20px; }
    .guide-body :global(.guide-example div) { flex-direction: column; gap: 2px; }
    .guide-body :global(.guide-example dd) { text-align: left; }
    .guide-cta .btn { width: 100%; white-space: normal; }
  }
</style>
