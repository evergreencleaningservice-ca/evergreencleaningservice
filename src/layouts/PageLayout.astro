---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import { site } from '../data/site';
import { pageTitle } from '../lib/title';
import { breadcrumbSchema } from '../lib/schema';
import { normalizeBody as normalizeShared } from '../lib/normalize-body';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  /**
   * Inner pages carry the original's sidebar; set false for a full-width page.
   */
  sidebar?: boolean;
  /**
   * Pre-rendered body HTML for this page, i.e. `entry.rendered.html` from the
   * matching `pages` collection entry. Passing it instead of rendering
   * `<Content />` into the slot lets the layout clean up the WordPress-era
   * markup in one place (see `normalizeBody`); the three pages that used to be
   * a WPForms embed pass an already-sliced string. Anything in the default slot
   * is rendered after it, so a page can add its own markup — a real form, say —
   * below the copy that came from the archive.
   */
  contentHtml?: string;
  /** The <title> text when it should say more than the H1 (the pages
      collection's `seoTitle`, 13 Nov 2026). The H1 and breadcrumb keep
      `title`. */
  seoTitle?: string;
  /** Shown as "Last updated" above the copy, only when set (13 Nov 2026,
      comparison with impact.ca: a dated page is easier to quote). */
  updatedDate?: Date;
}

const { title, description, image, imageAlt, contentHtml, seoTitle, updatedDate, sidebar = true } = Astro.props;
const longDate = (d: Date) =>
  d.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

/**
 * The page bodies are Markdown generated from the archived WordPress HTML, so
 * their links and images still carry WordPress habits. Five fixes, applied
 * before the HTML reaches the page:
 *
 *  1. `/wp-content/uploads/<year>/<month>/<file>` is the old media path; this
 *     build serves the same files from `/images/<file>`.
 *  2. `astro.config.mjs` sets `trailingSlash: 'always'`, so an internal page
 *     link written without its trailing slash would 404 rather than resolve.
 *  3. The archive writes `tel://` — the `//` turns the number into a URL
 *     authority, which some dialers refuse.
 *  4. Empty anchors (`[](/)` survives in the Markdown) are links with no
 *     accessible name, so assistive tech announces a link that leads nowhere.
 *  5. Dropping one of those anchors can leave the paragraph that held it empty
 *     — on green-clean-products it left three — and an empty paragraph still
 *     renders its margins, so it shows up as an unexplained gap in the copy.
 *  6. Every image in a page body sits below the page header, so they can all be
 *     lazy-loaded.
 */
function normalizeBody(html: string): string {
  return html
    .replace(/(href|src)="\/wp-content\/uploads\/[^"]*?\/([^"/]+)"/g, '$1="/images/$2"')
    .replace(/href="(\/[^"?#]*)"/g, (whole, path: string) =>
      path.endsWith('/') || /\.[a-z0-9]{2,5}$/i.test(path) ? whole : `href="${path}/"`,
    )
    .replace(/href="tel:\/\//g, 'href="tel:')
    .replace(/<a\b[^>]*>\s*<\/a>/g, '')
    .replace(/<p[^>]*>\s*<\/p>/g, '')
    .replace(/<img(?![^>]*\sloading=)\s/g, '<img loading="lazy" decoding="async" ');
}

/* Then the shared pass: image sizes and the responsive photo set. */
const body = contentHtml ? normalizeShared(normalizeBody(contentHtml)) : null;
---

<BaseLayout
  title={pageTitle(seoTitle ?? title)}
  description={description || undefined}
  image={image}
  imageAlt={imageAlt}
>
  <slot name="head" slot="head" />
  {/* The trail drawn below, in machine-readable form (SEO audit H12). */}
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema([{ name: site.name, url: '/' }, { name: title }]))}
    is:inline
  />
  <div class="page-header">
    <div class="container">
      <h1 class="entry-title">{title}</h1>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <span aria-current="page">{title}</span>
      </nav>
    </div>
  </div>

  <div class="section-padding">
    <div class={`container content-grid${sidebar ? '' : ' is-full'}`}>
      {/* The copy below the first screen fades in a block at a time as it is
          reached (lib/reveal.ts, "flow"); a form the page adds is one block. */}
      <article class="entry-content" data-reveal="flow">
        {updatedDate && (
          <p class="page-updated">
            Last updated <time datetime={updatedDate.toISOString().slice(0, 10)}>{longDate(updatedDate)}</time>
          </p>
        )}
        {body && <Fragment set:html={body} />}
        <slot />
      </article>
      {sidebar && <Sidebar />}
    </div>
  </div>
</BaseLayout>

<style>
  .page-updated {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .breadcrumbs a:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }
</style>
