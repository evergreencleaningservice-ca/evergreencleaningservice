---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Comments from '../components/Comments.astro';
import SubmissionRuntime from '../components/SubmissionRuntime.astro';
import { site } from '../data/site';
import { pageTitle } from '../lib/title';
import { articleSchema, breadcrumbSchema } from '../lib/schema';
import { tags as TAGS } from '../data/tags';

interface Props {
  post: CollectionEntry<'blog'>;
  /** The next post forward in time, if there is one. */
  newer?: CollectionEntry<'blog'>;
  /** The next post back in time, if there is one. */
  older?: CollectionEntry<'blog'>;
  /** Only the live-post template (src/pages/eg-live-post-shell.astro) sets this. */
  noindex?: boolean;
}

const { post, newer, older, noindex = false } = Astro.props;
const { title, description, pubDate, image, imageAlt } = post.data;
/* The post's own topics, linked to their archives. The sidebar cloud shows
   only topics with two or more posts (SEO audit L1-L4), so this is where a
   one-post topic's archive is linked from. */
const postTags = ((post.data as { tags?: string[] }).tags ?? [])
  .map((slug) => TAGS.find((t) => t.slug === slug))
  .filter((t): t is (typeof TAGS)[number] => Boolean(t));
/* Refreshed featured images ship as AVIF/WebP/JPEG siblings at 960x480. */
const modern = image && /-feature\.jpg$/.test(image);
const sibling = (ext: string) => image!.replace(/\.jpg$/, `.${ext}`);

---

<BaseLayout
  title={pageTitle(`${title}`)}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  publishedTime={pubDate.toISOString()}
  noindex={noindex}
>
<script
  slot="head"
  type="application/ld+json"
  set:html={JSON.stringify(articleSchema({ title, description, pubDate, image, slug: post.id }))}
  is:inline
/>
<script
  slot="head"
  type="application/ld+json"
  set:html={JSON.stringify(
    breadcrumbSchema([
      { name: site.name, url: '/' },
      { name: 'Insights', url: '/insights/' },
      { name: title },
    ])
  )}
  is:inline
/>

  <div class="section-padding">
    <div class="container post-container content-grid">
      <div class="post-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <a href="/insights/">Insights</a> &gt;{' '}
        <span aria-current="page">{title}</span>
      </nav>

      {/* The original printed no date on a post. Since 30 Oct 2026 the
          publish date is shown under the title (SEO audit, "blog stale,
          undated and unattributed"), so a reader can judge how current the
          advice is; it matches `article:published_time` and the JSON-LD. */}
      <header class="entry-header">
        <h1 class="entry-title">{title}</h1>
        <p class="post-date">
          Published <time datetime={pubDate.toISOString().slice(0, 10)}>{pubDate.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
          {' '}by {site.name}
        </p>
      </header>
      {
        image && (
          <div class="post-featured">
            <picture>
              {modern && <source type="image/avif" srcset={sibling('avif')} />}
              {modern && <source type="image/webp" srcset={sibling('webp')} />}
              <img
                src={image}
                alt={imageAlt ?? ''}
                width={modern ? 960 : 1200}
                height={modern ? 480 : 600}
                decoding="async"
              />
            </picture>
          </div>
        )
      }

      <article class="entry-content">
        <slot />
      </article>
      {
        postTags.length > 0 && (
          <p class="post-topics">
            Topics:{' '}
            {postTags.map((t, i) => (
              <Fragment>
                {i > 0 && ', '}
                <a href={`/tag/${t.slug}/`} rel="tag">{t.name}</a>
              </Fragment>
            ))}
          </p>
        )
      }

      {/* The original has no previous/next navigation on a post — the article
          runs straight into the comment form. A pair of links here was an
          addition, so it is gone; `newer` and `older` stay on the props in case
          the client wants it back. */}

      <Comments slug={post.id} />
      <SubmissionRuntime />
      </div>

      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .post-topics {
    margin: 0 0 30px;
    font-size: 0.875rem;
  }

  .post-topics a {
    display: inline-block;
    padding-block: 2px;
  }

  .post-date {
    margin: -6px 0 18px;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .entry-header .entry-title {
    font-family: var(--font-heading);
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2rem);
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink-heading);
    /* 8px left the title touching the photo below it. */
    margin: 0 0 1.25rem;
  }

  .breadcrumbs {
    margin-bottom: 14px;
  }

  .post-main {
    min-width: 0;
  }


  .post-container {
  }

  .post-featured {
    margin-bottom: 36px;
  }

  .post-featured img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }


  .post-back {
    margin: 40px 0 0;
    text-align: center;
  }
</style>
