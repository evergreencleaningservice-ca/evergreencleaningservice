---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Comments from '../components/Comments.astro';
import SubmissionRuntime from '../components/SubmissionRuntime.astro';
import { site } from '../data/site';
import { pageTitle } from '../lib/title';
import { articleSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  post: CollectionEntry<'blog'>;
  /** The next post forward in time, if there is one. */
  newer?: CollectionEntry<'blog'>;
  /** The next post back in time, if there is one. */
  older?: CollectionEntry<'blog'>;
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, image } = post.data;

---

<BaseLayout
  title={pageTitle(`${title}`)}
  description={description}
  image={image}
  type="article"
  publishedTime={pubDate.toISOString()}
>
<script
  slot="head"
  type="application/ld+json"
  set:html={JSON.stringify(articleSchema({ title, description, pubDate, image, slug: post.id }))}
  is:inline
/>
<script
  slot="head"
  type="application/ld+json"
  set:html={JSON.stringify(
    breadcrumbSchema([
      { name: site.name, url: '/' },
      { name: 'News', url: '/insights/' },
      { name: 'Blog', url: '/category/blog/' },
      { name: title },
    ])
  )}
  is:inline
/>

  <div class="section-padding">
    <div class="container post-container content-grid">
      <div class="post-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <a href="/insights/">News</a> &gt;
        <a href="/category/blog/">Blog</a> &gt; <span aria-current="page">{title}</span>
      </nav>

      {/* The original prints no date on a post — there is no `.entry-meta` on
          the page at all. The date stays in the head as `article:published_time`
          and in the JSON-LD, where the original also keeps it, but it is not
          shown. */}
      <header class="entry-header">
        <h1 class="entry-title">{title}</h1>
      </header>
      {
        image && (
          <div class="post-featured">
            <img src={image} alt="" width="1200" height="600" decoding="async" />
          </div>
        )
      }

      <article class="entry-content">
        <slot />
      </article>

      {/* The original has no previous/next navigation on a post — the article
          runs straight into the comment form. A pair of links here was an
          addition, so it is gone; `newer` and `older` stay on the props in case
          the client wants it back. */}

      <Comments slug={post.id} />
      <SubmissionRuntime />
      </div>

      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .entry-header .entry-title {
    font-family: var(--font-heading);
    font-size: 2rem;
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 0 0 0.5rem;
  }

  .breadcrumbs {
    margin-bottom: 14px;
  }

  .post-main {
    min-width: 0;
  }


  .post-container {
  }

  .post-featured {
    margin-bottom: 36px;
  }

  .post-featured img {
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface-alt);
  }


  .post-back {
    margin: 40px 0 0;
    text-align: center;
  }
</style>
