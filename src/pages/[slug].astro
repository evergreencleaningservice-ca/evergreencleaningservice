---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import PostLayout from '../layouts/PostLayout.astro';
import { normalizeBody } from '../lib/normalize-body';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newer: index > 0 ? posts[index - 1] : undefined,
      older: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, newer, older } = Astro.props as Props;

// `render()` is also what fills `post.rendered`, which is the HTML normalised
// below. Keep the call even though `Content` is only the fallback.
const { Content } = await render(post);


const body = post.rendered?.html ? normalizeBody(post.rendered.html) : null;
---

<PostLayout post={post} newer={newer} older={older}>
  {body ? <Fragment set:html={body} /> : <Content />}
</PostLayout>
