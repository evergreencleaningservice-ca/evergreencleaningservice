---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // The original news pages are /blog/, /blog/page/2/, ...
  return paginate(posts, { pageSize: 10 }).map((route) => ({
    ...route,
    params: { page: route.params.page ? `page/${route.params.page}` : undefined },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;

const base = '/blog/';
const hrefFor = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const pageNumbers = Array.from({ length: page.lastPage }, (_, i) => i + 1);
const pageSuffix = page.currentPage > 1 ? ` - Page ${page.currentPage} of ${page.lastPage}` : '';
---

<BaseLayout
  title={`News${pageSuffix} - ${site.legalName}`}
  description="Welcome to Evergreen Cleaning Services blog. Check in often for interesting articles and posts from our blog. We'd love to hear from you."
>
  <div class="page-header">
    <div class="container">
      <h1 class="entry-title">News</h1>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <span>News</span>
      </nav>
    </div>
  </div>

  <div class="section-padding">
    <div class="container">
      <div class="grid grid-2">
        {
          page.data.map((post, index) => (
            <PostCard post={post} loading={index < 2 ? 'eager' : 'lazy'} />
          ))
        }
      </div>

      {
        page.lastPage > 1 && (
          <nav class="pagination" aria-label="News pagination">
            {page.currentPage > 1 && (
              <a class="page-link page-arrow" href={hrefFor(page.currentPage - 1)} rel="prev">
                Newer posts
              </a>
            )}

            <ul class="page-numbers">
              {pageNumbers.map((n) => (
                <li>
                  {n === page.currentPage ? (
                    <span class="page-link is-current" aria-current="page">
                      <span class="screen-reader-text">Page </span>
                      {n}
                    </span>
                  ) : (
                    <a class="page-link" href={hrefFor(n)}>
                      <span class="screen-reader-text">Page </span>
                      {n}
                    </a>
                  )}
                </li>
              ))}
            </ul>

            {page.currentPage < page.lastPage && (
              <a class="page-link page-arrow" href={hrefFor(page.currentPage + 1)} rel="next">
                Older posts
              </a>
            )}
          </nav>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 48px;
  }

  .page-numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .page-link {
    display: inline-block;
    min-width: 40px;
    padding: 8px 14px;
    text-align: center;
    font-family: var(--font-heading);
    font-weight: 600;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--ink-heading);
    background: var(--surface);
  }

  a.page-link:hover,
  a.page-link:focus-visible {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
    text-decoration: none;
  }

  .page-link.is-current {
    background: var(--brand);
    border-color: var(--brand);
    color: #fff;
  }

  a.page-link:focus-visible {
    outline: 2px solid var(--brand-dark);
    outline-offset: 2px;
  }
</style>
