---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostList from '../../../components/PostList.astro';
import Sidebar from '../../../components/Sidebar.astro';
import { site } from '../../../data/site';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog')).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

  // The original archive pages are /category/blog/, /category/blog/page/2/, ...
  return paginate(posts, { pageSize: 10 }).map((route) => ({
    ...route,
    params: { page: route.params.page ? `page/${route.params.page}` : undefined },
  }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props as Props;

const base = '/category/blog/';
const hrefFor = (n: number) => (n === 1 ? base : `${base}page/${n}/`);

// Copied from the archived <title>s. The original is inconsistent on purpose or
// by accident, but it is what the source serves: page one ends "- Evergreen
// Office Cleaning", the paged archives end "- Evergreen Cleaning Service".
const archiveTitle =
  page.currentPage > 1
    ? `Blog Archives - Page ${page.currentPage} of ${page.lastPage} - ${site.name}`
    : `Blog Archives - ${site.name}`;
---

<BaseLayout
  title={archiveTitle}
  description="Visit our Evergreen Cleaning Service blog for industry updates and standards, interesting reads and new posts by our authors"
>
  {/*
    The original sends `follow, noindex` on every page of this archive: keep the
    posts crawlable through it, keep the archive itself out of the index.
    BaseLayout's `noindex` prop emits `noindex, nofollow`, which would also cut
    the crawl path to the posts, so the exact directive is set here instead.
  */}
  <meta slot="head" name="robots" content="follow, noindex" />
  <div class="page-header">
    <div class="container">
      <h1 class="page-title entry-title">Category: <span>Blog</span></h1>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <a href="/insights/">News</a> &gt;
        <span aria-current="page">Blog</span>
      </nav>
    </div>
  </div>

  <div class="section-padding">
    <div class="container content-grid">
      <div class="post-main">
        <PostList posts={page.data} eager={2} flush />

        {
          page.lastPage > 1 && (
            <nav class="posts-navigation" aria-label="Posts navigation">
              <h2 class="screen-reader-text">Posts navigation</h2>
              <div class="nav-links">
                {page.currentPage < page.lastPage && (
                  <div class="nav-previous">
                    <a href={hrefFor(page.currentPage + 1)} rel="next">
                      Older posts
                    </a>
                  </div>
                )}
                {page.currentPage > 1 && (
                  <div class="nav-next">
                    <a href={hrefFor(page.currentPage - 1)} rel="prev">
                      Newer posts
                    </a>
                  </div>
                )}
              </div>
            </nav>
          )
        }
      </div>

      <Sidebar />
    </div>
  </div>
</BaseLayout>

<style>
  .posts-navigation {
    margin-top: 30px;
  }

  .nav-links {
    display: flex;
    justify-content: space-between;
    gap: 16px;
  }

  .nav-next {
    margin-left: auto;
  }

  .nav-links a {
    color: var(--brand);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--brand-hover, #3f7523);
  }
</style>
