---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { site, serviceAreas } from '../data/site';

const entry = await getEntry('pages', 'contact-us');
if (!entry) throw new Error('Missing content entry: pages/contact-us');

/**
 * Everything from the "Phone:" heading onward in this entry is either a value
 * that `src/data/site.ts` already owns, or the old WPForms embed flattened into
 * prose — the form title, every field label and the whole 250-entry country
 * dropdown. So keep the archived heading and postal address, and take it from
 * there: phone, email and service areas come from site.ts, and the form is
 * rebuilt below as real HTML. That slicing is why this page reads
 * `entry.rendered.html` directly instead of rendering `<Content />`.
 */
const rawBody = entry.rendered?.html ?? '';
const phoneHeadingAt = rawBody.indexOf('>Phone:<');
const cutAt = phoneHeadingAt === -1 ? -1 : rawBody.lastIndexOf('<h', phoneHeadingAt);
if (cutAt === -1) {
  throw new Error(
    'contact-us: expected a "Phone:" heading in the page body to cut at. ' +
      'src/content/pages/contact-us.md has changed shape — check it before rendering it verbatim.',
  );
}
const addressHtml = rawBody.slice(0, cutAt);

/*
 * TODO — the submit endpoint is not wired up yet.
 *
 * The original page used the WPForms plugin (form id 1384), which posted back
 * to WordPress and ran a server-side arithmetic captcha plus reCAPTCHA v2.
 * Neither survives a static build, so the markup below is a plain HTML form
 * with `action="#"`: it validates in the browser and then goes nowhere.
 * Before launch, point `action` at a real handler, and re-add spam protection
 * there — the honeypot below is only half the job.
 */
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  contentHtml={addressHtml}
>
  <h4>Phone:</h4>
  <p><a href={site.phoneHref}>{site.phone}</a></p>

  <h4>Email:</h4>
  <p><a href={`mailto:${site.email}`}>{site.email}</a></p>

  <h4>Service areas:</h4>
  <p>{serviceAreas}</p>

  <section class="form-section" aria-labelledby="contact-form-heading">
    <h2 id="contact-form-heading">General Contact Form</h2>
    <p class="form-note">Fields marked <span class="req">*</span> are required.</p>

    {/* See the TODO in this file's frontmatter: action="#" is a placeholder. */}
    <form class="site-form" method="post" action="#">
      <fieldset class="form-group">
        <legend>Name <span class="req" aria-hidden="true">*</span></legend>
        <div class="form-row form-row-2">
          <div class="form-field">
            <label for="contact-first">First</label>
            <input
              type="text"
              id="contact-first"
              name="first-name"
              autocomplete="given-name"
              required
            />
          </div>
          <div class="form-field">
            <label for="contact-last">Last</label>
            <input
              type="text"
              id="contact-last"
              name="last-name"
              autocomplete="family-name"
              required
            />
          </div>
        </div>
      </fieldset>

      <div class="form-field">
        <label for="contact-business">
          Business name <span class="req" aria-hidden="true">*</span>
        </label>
        <input
          type="text"
          id="contact-business"
          name="business-name"
          autocomplete="organization"
          required
        />
      </div>

      <fieldset class="form-group">
        <legend>Address <span class="req" aria-hidden="true">*</span></legend>
        <div class="form-field">
          <label for="contact-address">Address line 1</label>
          <input
            type="text"
            id="contact-address"
            name="address"
            placeholder="Street address &amp; unit #"
            autocomplete="street-address"
            required
          />
        </div>
        <div class="form-row form-row-2">
          <div class="form-field">
            <label for="contact-city">City</label>
            <input
              type="text"
              id="contact-city"
              name="city"
              autocomplete="address-level2"
              required
            />
          </div>
          <div class="form-field">
            <label for="contact-province">Province / State / Region</label>
            <input
              type="text"
              id="contact-province"
              name="province"
              value="Ontario"
              autocomplete="address-level1"
              required
            />
          </div>
        </div>
        <div class="form-row form-row-2">
          <div class="form-field">
            <label for="contact-postal">Postal code</label>
            <input
              type="text"
              id="contact-postal"
              name="postal-code"
              autocomplete="postal-code"
              required
            />
          </div>
          <div class="form-field">
            <label for="contact-country">Country</label>
            <input
              type="text"
              id="contact-country"
              name="country"
              value="Canada"
              autocomplete="country-name"
              required
            />
          </div>
        </div>
      </fieldset>

      <div class="form-field">
        <label for="contact-phone">Phone <span class="req" aria-hidden="true">*</span></label>
        <input
          type="tel"
          id="contact-phone"
          name="phone"
          inputmode="tel"
          autocomplete="tel"
          required
        />
      </div>

      <div class="form-field">
        <label for="contact-email">Email <span class="req" aria-hidden="true">*</span></label>
        <input
          type="email"
          id="contact-email"
          name="email"
          inputmode="email"
          autocomplete="email"
          spellcheck="false"
          required
        />
      </div>

      <div class="form-field">
        <label for="contact-message">
          Comment or Message <span class="req" aria-hidden="true">*</span>
        </label>
        <textarea id="contact-message" name="message" rows="6" required></textarea>
      </div>

      {/* Honeypot, carried over from the original form. Real people never see it. */}
      <div class="form-hp" aria-hidden="true">
        <label for="contact-hp">Leave this field empty</label>
        <input type="text" id="contact-hp" name="company-website" tabindex="-1" autocomplete="off" />
      </div>

      <button class="btn btn-primary btn-lg" type="submit">Submit</button>
    </form>
  </section>
</PageLayout>

<style>
  .form-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  .form-note {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 1.8rem;
  }

  .req {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .site-form {
    max-width: 640px;
  }

  .form-group {
    /* Fieldsets default to min-width: min-content, which forces horizontal
       scroll on narrow screens. */
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .form-group legend,
  .form-field label {
    display: block;
    padding: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-heading);
    margin-bottom: 0.35rem;
  }

  .form-group legend {
    margin-bottom: 0.6rem;
  }

  .form-field {
    margin-bottom: 1.25rem;
  }

  .form-row {
    display: grid;
    gap: 0 1rem;
  }

  @media (min-width: 560px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  textarea {
    width: 100%;
    max-width: 100%;
    font: inherit;
    color: inherit;
    background: #fff;
    padding: 0.6rem 0.75rem;
    border: 1px solid #cdd2d7;
    border-radius: var(--radius);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .form-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  button[type='submit'] {
    margin-top: 0.5rem;
  }
</style>
