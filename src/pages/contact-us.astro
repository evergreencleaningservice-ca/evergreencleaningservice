---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { site, nap } from '../data/site';
import ContactForm from '../components/ContactForm.astro';

const entry = await getEntry('pages', 'contact-us');
if (!entry) throw new Error('Missing content entry: pages/contact-us');

/**
 * Everything from the "Phone:" heading onward in this entry is either a value
 * that `src/data/site.ts` already owns, or the old WPForms embed flattened into
 * prose — the form title, every field label and the whole 250-entry country
 * dropdown. So keep the archived heading and postal address, and take it from
 * there: phone and email come from site.ts, and the form is rebuilt below as
 * real HTML. That slicing is why this page reads `entry.rendered.html` directly
 * instead of rendering `<Content />`.
 *
 * The archived page carries Address, Phone and Email and nothing else — no
 * service-area list — so none is added here; the footer already lists them.
 */
const rawBody = entry.rendered?.html ?? '';
const phoneHeadingAt = rawBody.indexOf('>Phone:<');
const cutAt = phoneHeadingAt === -1 ? -1 : rawBody.lastIndexOf('<h', phoneHeadingAt);
if (cutAt === -1) {
  throw new Error(
    'contact-us: expected a "Phone:" heading in the page body to cut at. ' +
      'src/content/pages/contact-us.md has changed shape — check it before rendering it verbatim.',
  );
}
const addressHtml = rawBody.slice(0, cutAt);

/*
 * TODO — the submit endpoint is not wired up yet.
 *
 * The original page used the WPForms plugin (form id 1384), which posted back
 * to WordPress and ran a server-side arithmetic captcha plus reCAPTCHA v2.
 * Neither survives a static build, so the markup below is a plain HTML form
 * with `action="#"`: it validates in the browser and then goes nowhere.
 * Before launch, point `action` at a real handler, and re-add spam protection
 * there — the honeypot below is only half the job.
 */
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  contentHtml={addressHtml}
>
  <h4>Phone:</h4>
  <p><a href={nap.phoneHref}>+1 {nap.phoneDisplay}</a></p>

  <h4>Email:</h4>
  <p><a href={`mailto:${nap.email}`}>{nap.email}</a></p>

  <section class="form-section" aria-label="General Contact Form">
    <div class="wpforms-title">General Contact Form</div>

    {/* See the TODO in this file's frontmatter: action="#" is a placeholder. */}
    <ContactForm id="contact-page" />
  </section>
</PageLayout>

<style>
  .form-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }

  /* WPForms' own form title: 26px, 10px below. Not a heading on the original
     either — it is a plain div, so it stays out of the heading outline. */
  .wpforms-title {
    font-family: var(--font-heading);
    font-size: 26px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--ink-heading);
    margin: 0 0 10px;
  }

  .req {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .site-form {
    max-width: 640px;
  }

  .form-group {
    /* Fieldsets default to min-width: min-content, which forces horizontal
       scroll on narrow screens. */
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .form-group legend,
  .form-field label {
    display: block;
    padding: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-heading);
    margin-bottom: 0.35rem;
  }

  .form-group legend {
    margin-bottom: 0.6rem;
  }

  .form-field {
    margin-bottom: 1.25rem;
  }

  .form-row {
    display: grid;
    gap: 0 1rem;
  }

  @media (min-width: 560px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  textarea {
    width: 100%;
    max-width: 100%;
    font: inherit;
    color: inherit;
    background: #fff;
    padding: 0.6rem 0.75rem;
    border: 1px solid #cdd2d7;
    border-radius: var(--radius);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .form-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  button[type='submit'] {
    margin-top: 0.5rem;
  }
</style>
