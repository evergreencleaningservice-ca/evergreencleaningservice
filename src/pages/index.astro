---
/**
 * The homepage, restructured 2026-10-15 so the first scroll answers what
 * Evergreen does, where it works, who it serves, why to trust it and how to
 * ask for a quote — in that order. The original's theme sections that did
 * none of those (the rotating brandmark, the side dot-navigation, the
 * three-card service teaser, the long About essay) are replaced; the Google
 * reviews, the testimonials, the contact form and the latest posts are kept.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import WhoWeServe from '../components/home/WhoWeServe.astro';
import Reviews from '../components/home/Reviews.astro';
import WhyEvergreen from '../components/home/WhyEvergreen.astro';
import Areas from '../components/home/Areas.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Contact from '../components/home/Contact.astro';
import News from '../components/home/News.astro';

/* 30 Oct 2026 (SEO audit): the homepage was taking the "office cleaning
   services" queries from /services/office-cleaning/, at positions 7-12 with
   almost no clicks. The title now leads with the company and the year, and
   leaves "office cleaning services" to the service page; the description
   gives a reason to click (the reply promise the client confirmed). */
const title = 'Commercial Cleaning Company in Toronto Since 1989 | Evergreen';
const description =
  'Office and commercial cleaning across Toronto and the GTA since 1989: the same crew every visit, after hours, WSIB covered. We reply within 2 hours.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <ServicesOverview />
  <WhoWeServe />
  <Reviews />
  <WhyEvergreen />
  <Areas />
  <Testimonials />
  <Contact />
  <News />
</BaseLayout>
