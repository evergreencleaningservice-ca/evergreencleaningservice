---
/**
 * The homepage, restructured 2026-10-15 so the first scroll answers what
 * Evergreen does, where it works, who it serves, why to trust it and how to
 * ask for a quote — in that order. The original's theme sections that did
 * none of those (the rotating brandmark, the side dot-navigation, the
 * three-card service teaser, the long About essay) are replaced; the Google
 * reviews, the testimonials, the contact form and the latest posts are kept.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ServicesOverview from '../components/home/ServicesOverview.astro';
import WhoWeServe from '../components/home/WhoWeServe.astro';
import Reviews from '../components/home/Reviews.astro';
import WhyEvergreen from '../components/home/WhyEvergreen.astro';
import Areas from '../components/home/Areas.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Contact from '../components/home/Contact.astro';
import News from '../components/home/News.astro';

const title = 'Office & Commercial Cleaning in Toronto & GTA | Evergreen';
const description =
  'Office, commercial and industrial cleaning across Toronto and the GTA since 1989 — after hours, by a consistent crew, with a free on-site walkthrough.';
---

<BaseLayout title={title} description={description}>
  <Hero />
  <ServicesOverview />
  <WhoWeServe />
  <Reviews />
  <WhyEvergreen />
  <Areas />
  <Testimonials />
  <Contact />
  <News />
</BaseLayout>
