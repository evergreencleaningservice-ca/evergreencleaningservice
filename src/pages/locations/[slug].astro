---
/**
 * The GTA sub-location pages — Section 2.3 of the overhaul specification.
 *
 * Page anatomy, as specified:
 *   Dynamic H1   "[Service] in [City/Region]" — the brand suffix came off on
 *                2026-10-29 (SEO audit H9); it belongs in the <title>, not the H1
 *   Unique focus  each page's own service radius, from src/data/locations.ts
 *   Facility types served
 *   Google Maps embed centred on the municipal zone
 *   Reviews
 *
 * The spec also asks for "dedicated localized case studies" and "local client
 * testimonials". Neither exists in anything the client has supplied, and
 * writing them would mean inventing named clients and outcomes, so the section
 * is left out rather than filled with invented proof. The real Google reviews
 * are shown instead, unattributed to any city. Flagged in _research/gaps.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
import ProcessSteps from '../../components/blocks/ProcessSteps.astro';
import FaqList from '../../components/blocks/FaqList.astro';
import LinkCards from '../../components/blocks/LinkCards.astro';
import QuoteBand from '../../components/blocks/QuoteBand.astro';
import ReviewQuotes from '../../components/blocks/ReviewQuotes.astro';
import { locations } from '../../data/locations';
import { AREAS, COVERAGE_SENTENCE } from '../../data/coverage';
import { site, nap } from '../../data/site';
import { pageTitle } from '../../lib/title';
import { breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
/* Client-supplied copy wins where it exists; the generated H1 stays the
   fallback for the locations still on the template body. */
const h1 = location.detail?.h1 ?? `Commercial Cleaning in ${location.name}`;
/* THE MAP EMBED IS GONE (2026-10-15). A map centred on Mississauga beside
   a Toronto street address read as a Mississauga office, which this business
   does not have; it also loaded a Google Maps iframe on every location page.
   The page now says plainly where the crews come from. */
const isToronto = location.slug === 'toronto-downtown' || location.slug === 'etobicoke';
const baseNote = isToronto
  ? `Our office is at ${nap.streetAddress}, ${nap.addressLocality}.`
  : `We do not have an office in ${location.name}: crews travel from our Toronto base at ${nap.streetAddress} in Toronto.`;

const services = [
  { title: `Office cleaning`, href: '/services/office-cleaning/', text: 'Recurring after-hours janitorial service.' },
  { title: `Commercial cleaning`, href: '/services/commercial-cleaning/', text: 'Retail, institutional and mixed-use premises.' },
  { title: `Industrial & warehouse cleaning`, href: '/services/industrial-cleaning/', text: 'Plants, warehouses and distribution.' },
  { title: `Building maintenance & floor care`, href: '/services/building-maintenance/', text: 'Strip and wax, carpet extraction, high dusting.' },
  { title: `Post-construction cleaning`, href: '/services/post-construction-cleaning/', text: 'Clean-up before handover.' },
  { title: `Medical & dental clinics`, href: '/industries/medical-dental-clinics/', text: 'Clinic cleaning after hours.' },
];

const nearby = AREAS.filter((a) => a.href && a.href !== `/locations/${location.slug}/`).map((a) => ({
  title: a.name,
  href: a.href!,
}));

const faqs = [
  {
    q: `Do you have an office in ${location.name}?`,
    a: isToronto
      ? `Our office is at ${nap.addressLine}. Crews work across the city and the wider GTA.`
      : `No. Evergreen has one office, at ${nap.addressLine}, and crews travel to ${location.name} from there. Every client has an account executive as their direct contact.`,
  },
  {
    q: `What areas around ${location.name} do you cover?`,
    a: `We work across ${COVERAGE_SENTENCE}.`,
  },
  {
    q: 'How do I get a quote?',
    a: `Call ${nap.phoneDisplay} or send the quote form. We arrange a free on-site walkthrough and send a written proposal.`,
  },
  {
    q: 'Can cleaning be done after hours?',
    a: 'Yes. Most commercial cleaning is done in the evening, overnight or at weekends so it does not disrupt your staff or customers.',
  },
];

/* Per-page schema. The organisation graph is global (BaseLayout); this adds the
   service-in-place record that makes the page its own entity rather than a
   duplicate of the others. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Commercial Cleaning',
  provider: { '@id': `${site.url}/#organization` },
  areaServed: { '@type': 'City', name: location.name },
  name: `Commercial Cleaning in ${location.name}`,
  description: location.description,
  url: `${site.url}/locations/${location.slug}/`,
};
---

<BaseLayout
  title={location.title ?? pageTitle(`Commercial Cleaning in ${location.name}`)}
  description={location.description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema([
      { name: site.name, url: '/' },
      { name: 'Service Areas', url: '/locations/' },
      { name: location.name },
    ]))}
    is:inline
  />

  <div class="page-header">
    <div class="container">
      <h1 class="entry-title">{h1}</h1>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <a href="/locations/">Service Areas</a> &gt;{' '}
        <span aria-current="page">{location.name}</span>
      </nav>
    </div>
  </div>

  <div class="section-padding">
    <div class="container">
      <div class="loc-grid location-page">
        <div class="loc-main">
          {
            location.detail ? (
              <Fragment>
                <p class="lead loc-subtitle">{location.detail.subtitle}</p>
                {location.detail.intro.map((para) => (
                  <p class="loc-lead">{para}</p>
                ))}

                <hr />

                <h2>{location.detail.servicesTitle}</h2>
                <ul class="loc-detail">
                  {location.detail.services.map((s) => (
                    <li>
                      <strong>{s.label}:</strong> {s.body}
                    </li>
                  ))}
                </ul>

                <hr />

                <h2>{location.detail.reasonsTitle}</h2>
                <ul class="loc-detail">
                  {location.detail.reasons.map((r) => (
                    <li>
                      <strong>{r.label}:</strong> {r.body}
                    </li>
                  ))}
                </ul>

                <div class="cta-block">
                  <a class="btn btn-primary btn-lg" href="#offer-quote" data-quote-cta data-cta-location="content">
                    {location.detail.ctaLabel}
                  </a>
                  <p class="loc-direct">
                    Direct Phone: <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a>
                  </p>
                </div>
              </Fragment>
            ) : (
              <Fragment>
                <p class="loc-lead">
                  Evergreen Office Cleaning provides commercial and office cleaning in {location.region} as
                  part of its coverage across the Greater Toronto Area, which it has served since {site.since}.
                </p>

                <h2>What we clean in {location.name}</h2>
                <p>{location.focus}</p>

                <h3>Facility types served</h3>
                <ul class="loc-facilities">
                  {location.facilities.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>

                <h3>How we work</h3>
                <p>
                  Every contract starts with an on-site walkthrough, not a phone quote — the scope of a{' '}
                  {location.name} facility is what sets the schedule. You get a dedicated account
                  executive, after-hours cleaning where the space cannot be cleaned during business hours,
                  and a written scope.
                </p>
                <p>
                  We are bonded, insured and WSIB covered. Call{' '}
                  <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a> or{' '}
                  <a href="#offer-quote" data-quote-cta data-cta-location="content">request a walkthrough</a>.
                </p>
              </Fragment>
            )
          }
          {/* Under the text rather than under the form (2026-10-29): beside a
              tall quote form the text column ended a screen early, leaving a
              block of white; here it lengthens the short column instead. */}
          <div class="loc-nap">
            <h2 class="loc-nap-title">Where we work from</h2>
            <p>{baseNote}</p>
            <p>
              <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a><br />
              <a href={`mailto:${nap.email}`} data-cta-location="sidebar">{nap.email}</a>
            </p>
          </div>
        </div>

        <aside class="loc-aside" aria-label="Request a quote">
          <div class="loc-form-card">
            <QuickQuoteForm
              id="offer-quote"
              formId={`location-${location.slug}`}
              heading={`Get a quote in ${location.name}`}
              intro="A few details and we will arrange a walkthrough. No obligation."
            />
          </div>
        </aside>
      </div>
    </div>
  </div>

  <div class="container stack loc-after">
    <LinkCards heading={`Services in ${location.name}`} items={services} />
    <ProcessSteps heading="How it works" />
    <ReviewQuotes heading="What clients say" names={['Edward Sherman', 'Michael Katchen', 'Ping Lee']} />
    <FaqList faqs={faqs} />
    <LinkCards heading="Other service areas" items={nearby} />
    <QuoteBand location="content" />
  </div>
</BaseLayout>

<style>
  .loc-grid {
    display: grid;
    gap: 40px;
  }

  @media screen and (min-width: 941px) {
    .loc-grid {
      grid-template-columns: minmax(0, 1fr) 380px;
    }
  }

  .loc-lead {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  /* Fluid, and bold like the subtitle above it: a fixed 2rem in the light
     600 weight was the largest and thinnest heading on a phone. */
  .loc-main h2 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 30px 0 15px;
  }

  .loc-main h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 26px 0 12px;
  }

  .loc-subtitle {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink-heading);
    margin: 0 0 18px;
  }

  .loc-main hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 30px 0;
  }

  .loc-detail {
    margin: 0 0 22px;
    padding-left: 20px;
  }

  .loc-detail li {
    margin-bottom: 11px;
    line-height: 1.6;
  }

  .loc-detail strong {
    color: var(--ink-heading);
  }

  .loc-direct {
    margin-top: 16px;
    font-size: 0.9375rem;
  }

  .loc-facilities {
    margin: 0 0 18px;
    padding-left: 20px;
  }

  .loc-facilities li {
    margin-bottom: 7px;
  }

  .loc-form-card {
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 4px solid var(--brand);
    border-radius: 6px;
    padding: 20px;
  }

  .loc-nap a {
    color: var(--brand-dark);
  }

  .loc-main .loc-nap-title {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .loc-after {
    padding-bottom: 56px;
  }

  .loc-nap {
    margin-top: 30px;
    padding: 20px;
    background: var(--surface-alt);
    border-radius: var(--radius);
  }


  .loc-nap p {
    margin: 0 0 10px;
    line-height: 1.6;
  }
</style>
