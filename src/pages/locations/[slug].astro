---
/**
 * The GTA sub-location pages — Section 2.3 of the overhaul specification.
 *
 * Page anatomy, as specified:
 *   Dynamic H1   "[Service] in [City/Region]" — the brand suffix came off on
 *                2026-10-29 (SEO audit H9); it belongs in the <title>, not the H1
 *   Unique focus  each page's own service radius, from src/data/locations.ts
 *   Facility types served
 *   Google Maps embed centred on the municipal zone
 *   Reviews
 *
 * The spec also asks for "dedicated localized case studies" and "local client
 * testimonials". Neither exists in anything the client has supplied, and
 * writing them would mean inventing named clients and outcomes, so the section
 * is left out rather than filled with invented proof. The real Google reviews
 * are shown instead, unattributed to any city. Flagged in _research/gaps.md.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuickQuoteForm from '../../components/QuickQuoteForm.astro';
import FaqList from '../../components/blocks/FaqList.astro';
import LinkCards from '../../components/blocks/LinkCards.astro';
import QuoteBand from '../../components/blocks/QuoteBand.astro';
import ReviewQuotes from '../../components/blocks/ReviewQuotes.astro';
import { locations } from '../../data/locations';
import { LOCATION_LOCAL } from '../../data/location-local';
import PagePhoto from '../../components/blocks/PagePhoto.astro';
import { AREAS } from '../../data/coverage';
import { site, nap } from '../../data/site';
import { REPLY_PROMISE, REPLY_PROMISE_SHORT } from '../../data/landing';
import { pageTitle } from '../../lib/title';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema';
import { lastmodFor } from '../../lib/sitemap-lastmod.mjs';

export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}

const { location } = Astro.props;
/* What is local about this page: src/data/location-local.ts. */
const local = LOCATION_LOCAL[location.slug];
/* Client-supplied copy wins where it exists; the generated H1 stays the
   fallback for the locations still on the template body. */
const h1 = location.detail?.h1 ?? location.h1 ?? `Commercial Cleaning in ${location.name}`;
/* THE MAP EMBED IS GONE (2026-10-15). A map centred on Mississauga beside
   a Toronto street address read as a Mississauga office, which this business
   does not have; it also loaded a Google Maps iframe on every location page.
   The page now says plainly where the crews come from. */
const isToronto = ['toronto-downtown', 'etobicoke', 'north-york', 'scarborough'].includes(location.slug);
const baseNote = isToronto
  ? `Our office is at ${nap.streetAddress}, ${nap.addressLocality}.`
  : `We do not have an office in ${location.name}: crews travel from our Toronto base at ${nap.streetAddress} in Toronto.`;

const services = [
  { title: `Office cleaning`, href: '/office-cleaning/', text: 'Recurring after-hours janitorial service.' },
  { title: `Commercial cleaning`, href: '/commercial-cleaning/', text: 'Retail, institutional and mixed-use premises.' },
  { title: `Industrial & warehouse cleaning`, href: '/industrial-cleaning/', text: 'Plants, warehouses and distribution.' },
  { title: `Building maintenance & floor care`, href: '/building-maintenance/', text: 'Strip and wax, carpet extraction, high dusting.' },
  { title: `Post-construction cleaning`, href: '/post-construction-cleaning/', text: 'Clean-up before handover.' },
  { title: `Medical & dental clinics`, href: '/medical-dental-clinics/', text: 'Clinic cleaning after hours.' },
];

/* One card per page: Pickering, Ajax and Oshawa share the Durham page, so
   they are one card, "Pickering, Ajax & Oshawa", not three cards to the same
   address (7 Nov 2026, SEO re-audit). */
const nearbyByHref = new Map<string, string[]>();
for (const a of AREAS) {
  if (!a.href || a.href === `/locations/${location.slug}/`) continue;
  nearbyByHref.set(a.href, [...(nearbyByHref.get(a.href) ?? []), a.name]);
}
const joinNames = (names: string[]) =>
  names.length > 1 ? `${names.slice(0, -1).join(', ')} & ${names.at(-1)}` : names[0];
const nearby = [...nearbyByHref].map(([href, names]) => ({ title: joinNames(names), href }));

const faqs = [
  /* The local questions first: they are what this page answers that the
     other six do not. */
  ...(local?.faqs ?? []),
  {
    q: `Do you have an office in ${location.name}?`,
    /* Etobicoke answered "Yes" here because it is in the City of Toronto,
       which read as an Etobicoke office (SEO audit, 30 Oct 2026). Only the
       downtown page can say yes. */
    a:
      location.slug === 'toronto-downtown'
        ? `Yes: ${nap.addressLine}.`
        : isToronto
          ? `No. ${location.name} is in the City of Toronto, and crews come from our one office, at ${nap.streetAddress} downtown.`
          : `No. Crews come to ${location.name} from our one office, at ${nap.streetAddress} in Toronto.`,
  },
  /* "How do I get a quote?" and "Can cleaning be done after hours?" were the
     same on all seven pages; the quote form beside the text and the local
     scheduling notes answer both. */
];

/* Per-page schema. The organisation graph is global (BaseLayout); this adds the
   service-in-place record that makes the page its own entity rather than a
   duplicate of the others. */
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Commercial Cleaning',
  provider: { '@id': `${site.url}/#organization` },
  /* Durham Region is not a city: the page targets Pickering, Ajax and
     Oshawa, so those are the City nodes, each inside the region (7 Nov 2026,
     SEO re-audit schema N2). */
  areaServed: location.cities
    ? location.cities.map((name) => ({
        '@type': 'City',
        name,
        containedInPlace: { '@type': 'AdministrativeArea', name: location.name },
      }))
    : { '@type': 'City', name: location.name },
  name: `Commercial Cleaning in ${location.cities ? location.region : location.name}`,
  description: location.description,
  url: `${site.url}/locations/${location.slug}/`,
  '@id': `${site.url}/locations/${location.slug}/#service`,
};
const pageUrl = `${site.url}/locations/${location.slug}/`;
const webPage = webPageSchema({
  name: pageTitle(location.title ?? `Commercial Cleaning in ${location.name}`),
  url: pageUrl,
  description: location.description,
  image: local?.photo.src,
  dateModified: lastmodFor(pageUrl),
  mainEntityId: `${pageUrl}#service`,
});
---

<BaseLayout
  title={pageTitle(location.title ?? `Commercial Cleaning in ${location.name}`)}
  description={location.description}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(webPage)} is:inline />
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema([
      { name: site.name, url: '/' },
      { name: 'Service Areas', url: '/locations/' },
      { name: location.name },
    ]))}
    is:inline
  />

  <div class="page-header">
    <div class="container">
      {/* The trail above the H1, as on the service and industry pages (SEO
          audit M9), so it reads in the order it is announced. */}
      <nav class="breadcrumbs loc-crumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <a href="/locations/">Service Areas</a> &gt;{' '}
        <span aria-current="page">{location.name}</span>
      </nav>
      <h1 class="entry-title">{h1}</h1>
      {/* A next step in the first screen (SEO audit, location pages were the
          only template without one). On a phone the quote form is several
          screens down. */}
      <p class="loc-hero-actions">
        <a class="btn btn-primary" href="#offer-quote" data-quote-cta data-cta-location="hero">Get a free quote</a>
        <a class="btn btn-ghost" href={nap.phoneHref} data-call-location="hero">Call {nap.phoneDisplay}</a>
      </p>
      {/* The three facts the office-cleaning hero shows, in short form (SEO
          audit Phase 2): the location hero had no trust signal at all. Kept
          to a few words so it does not eat into each page's unique text. */}
      <ul class="loc-trust" aria-label="Why Evergreen">
        <li>Since 1989</li>
        <li>WSIB covered, bonded and insured</li>
        <li>We reply {REPLY_PROMISE_SHORT}</li>
      </ul>
    </div>
  </div>

  <div class="section-padding">
    <div class="container">
      <div class="loc-grid location-page">
        <div class="loc-main">
          {/* The page's first photo and its LCP element, so high priority
              (12 Nov 2026, SEO audit 11 Nov, performance P2). */}
          {local && <PagePhoto src={local.photo.src} alt={local.photo.alt} priority />}
          {
            location.detail ? (
              <Fragment>
                <p class="lead loc-subtitle">{location.detail.subtitle}</p>
                {location.detail.intro.map((para) => (
                  <p class="loc-lead">{para}</p>
                ))}

                <hr />

                <h2>{location.detail.servicesTitle}</h2>
                <ul class="loc-detail">
                  {location.detail.services.map((s) => (
                    <li>
                      <strong>{s.label}:</strong> {s.body}
                    </li>
                  ))}
                </ul>

                <hr />

                <h2>{location.detail.reasonsTitle}</h2>
                <ul class="loc-detail">
                  {location.detail.reasons.map((r) => (
                    <li>
                      <strong>{r.label}:</strong> {r.body}
                    </li>
                  ))}
                </ul>

                <div class="cta-block">
                  <a class="btn btn-primary btn-lg" href="#offer-quote" data-quote-cta data-cta-location="content">
                    {location.detail.ctaLabel}
                  </a>
                  <p class="loc-direct">
                    Direct Phone: <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a>
                  </p>
                </div>
              </Fragment>
            ) : (
              <Fragment>
                <p class="loc-lead">
                  Evergreen Office Cleaning provides commercial and office cleaning in {location.region} as
                  part of its coverage across the Greater Toronto Area, which it has served since {site.since}.
                </p>

                <h2>What we clean in {location.name}</h2>
                <p>{location.focus}</p>

                <h3>Facility types served</h3>
                <ul class="loc-facilities">
                  {location.facilities.map((f) => (
                    <li>{f}</li>
                  ))}
                </ul>

                {/* The generic "How we work" paragraph that used to sit here was the
                    same on five pages; scheduling is now covered locally in
                    "Working in …" below, and the process has its own page. */}
                <p>
                  We are bonded, insured and WSIB covered. Call{' '}
                  <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a> or{' '}
                  <a href="#offer-quote" data-quote-cta data-cta-location="content">request a walkthrough</a>.
                </p>
              </Fragment>
            )
          }
          {
            local?.office && (
              <section class="loc-office" aria-labelledby="loc-office-h">
                <hr />
                <h2 id="loc-office-h">Office cleaning in {location.name}</h2>
                {local.office.map((p) => (
                  <p set:html={p} />
                ))}
              </section>
            )
          }
          {
            local && (
              <section class="loc-local" aria-labelledby="loc-local-h">
                <hr />
                <h2 id="loc-local-h">Working in {location.name}</h2>
                <p>{local.areasIntro}</p>
                <ul class="loc-areas">
                  {local.areas.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
                <h3>The buildings, and what they need</h3>
                <ul class="loc-detail">
                  {local.buildings.map((b) => (
                    <li>
                      <strong>{b.title}.</strong> {b.body}
                    </li>
                  ))}
                </ul>
                <h3>Getting there and scheduling</h3>
                {local.access.map((p) => (
                  <p>{p}</p>
                ))}
              </section>
            )
          }
          {/* Under the text rather than under the form (2026-10-29): beside a
              tall quote form the text column ended a screen early, leaving a
              block of white; here it lengthens the short column instead. */}
          <div class="loc-nap">
            <h2 class="loc-nap-title">Where we work from</h2>
            <p>{baseNote}</p>
            <p>
              <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a><br />
              <a href={`mailto:${nap.email}`} data-cta-location="sidebar">{nap.email}</a>
            </p>
          </div>
        </div>

        <aside class="loc-aside" aria-label="Request a quote">
          <div class="loc-form-card">
            <QuickQuoteForm
              id="offer-quote"
              formId={`location-${location.slug}`}
              heading={`Get a quote in ${location.name}`}
              intro={`We reply ${REPLY_PROMISE}, then arrange a free walkthrough when it suits you. No obligation.`}
            />
          </div>
        </aside>
      </div>
    </div>
  </div>

  <div class="container stack loc-after">
    {/* Titles only: the same six descriptions on seven pages were repeated text. */}
    <LinkCards heading={`Services in ${location.name}`} items={services.map(({ title, href }) => ({ title, href }))} />
    {/* The five process steps were the same on all seven pages, the largest
        block of repeated text the audit's uniqueness check found. They live on
        /our-process/, and every location page links there instead. */}
    <p class="loc-process-link">
      Every contract starts with a free walkthrough and a written scope.{' '}
      <a href="/our-process/">See how we work, step by step&nbsp;→</a>
    </p>
    {/* At most one review per page, and never the same one on two location
        pages (location-local.ts). It is framed as one of our Google reviews,
        not as "what a client says" here: reviews.ts records no reviewer's
        location, and under that heading one review on three city pages read
        as a local client in each (7 Nov 2026, SEO re-audit C3). Pages with no
        review of their own link to the full list instead. */}
    {local?.review && <ReviewQuotes heading="From our Google reviews" names={[local.review]} />}
    <p class="loc-reviews-link">
      {local?.review ? 'More from our clients across the GTA: ' : 'What our clients across the GTA say: '}
      <a href="/reviews/">read our Google reviews&nbsp;→</a>
    </p>
    <FaqList faqs={faqs} />
    <LinkCards heading="Other service areas" items={nearby} />
    <QuoteBand location="content" />
  </div>
</BaseLayout>

<style>
  .loc-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px 14px;
    margin: 18px 0 0;
  }

  .loc-hero-actions .btn {
    margin: 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .btn-ghost {
    background: #fff;
    color: var(--brand-dark);
    border-color: var(--brand);
  }

  .btn-ghost:hover,
  .btn-ghost:focus-visible {
    background: var(--brand);
    color: #fff;
  }

  .loc-crumbs {
    margin: 0 0 8px;
  }

  .loc-grid {
    display: grid;
    gap: 40px;
  }

  @media screen and (min-width: 941px) {
    .loc-grid {
      grid-template-columns: minmax(0, 1fr) 380px;
    }
  }
  /* The form stays in view beside the long text column, but only where the
     whole form fits on screen: the card is about 840px, plus 78px once
     reCAPTCHA loads on the first focus, plus the 92px header. A pinned form
     taller than the window hid its submit button (Codex reviews, #64, #67). */
  @media screen and (min-width: 941px) and (min-height: 1080px) {
    .loc-aside {
      position: sticky;
      top: 92px;
      align-self: start;
      /* Never taller than the window: if the form grows after it is pinned
         (validation errors, a re-rendered CAPTCHA), it scrolls inside its
         own box rather than hiding the submit button (Codex review, #67). */
      max-height: calc(100vh - 108px);
      overflow-y: auto;
    }
  }

  /* A readable measure for the text column (30 Oct 2026). */
  .loc-main p,
  .loc-main ul {
    max-width: 80ch;
  }

  .loc-lead {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  /* Fluid, and bold like the subtitle above it: a fixed 2rem in the light
     600 weight was the largest and thinnest heading on a phone. */
  .loc-main h2 {
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 30px 0 15px;
  }

  .loc-main h3 {
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 26px 0 12px;
  }

  .loc-subtitle {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--ink-heading);
    margin: 0 0 18px;
  }

  .loc-main hr {
    border: 0;
    border-top: 1px solid var(--rule);
    margin: 30px 0;
  }

  .loc-areas {
    columns: 2 240px;
    column-gap: 30px;
    margin: 0 0 22px;
    padding-left: 20px;
  }

  .loc-areas li {
    break-inside: avoid;
    margin-bottom: 6px;
  }

  .loc-process-link,
  .loc-reviews-link {
    font-size: 1.0625rem;
  }

  .loc-detail {
    margin: 0 0 22px;
    padding-left: 20px;
  }

  .loc-detail li {
    margin-bottom: 11px;
    line-height: 1.6;
  }

  .loc-detail strong {
    color: var(--ink-heading);
  }

  .loc-direct {
    margin-top: 16px;
    font-size: 0.9375rem;
  }

  .loc-facilities {
    margin: 0 0 18px;
    padding-left: 20px;
  }

  .loc-facilities li {
    margin-bottom: 7px;
  }

  .loc-form-card {
    background: #fff;
    border: 1px solid var(--rule);
    border-top: 4px solid var(--brand);
    border-radius: 6px;
    padding: 20px;
  }

  .loc-nap a {
    color: var(--brand-dark);
  }

  .loc-main .loc-nap-title {
    font-size: 1.0625rem;
    font-weight: 700;
    margin: 0 0 10px;
  }

  .loc-after {
    padding-bottom: 56px;
  }

  .loc-nap {
    margin-top: 30px;
    padding: 20px;
    background: var(--surface-alt);
    border-radius: var(--radius);
  }


  .loc-nap p {
    margin: 0 0 10px;
    line-height: 1.6;
  }
  .loc-trust {
    list-style: none;
    margin: 14px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 0.9375rem;
    color: var(--ink);
  }
  .loc-trust li::before {
    content: '✓';
    color: var(--brand);
    font-weight: 700;
    margin-right: 6px;
  }
</style>
