---
/**
 * The /locations/ hub. Not in the spec's directory tree as a page of its own,
 * but the seven sub-location pages need a parent: without one their breadcrumb
 * points at a 404 and nothing on the site links to them, which would leave
 * seven orphan pages for a crawler to find on its own.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locations } from '../../data/locations';
import { AREAS, AREA_GROUPS, COVERAGE_SENTENCE } from '../../data/coverage';
import { site, nap } from '../../data/site';
import { pageTitle } from '../../lib/title';
import { breadcrumbSchema } from '../../lib/schema';

/* The coverage sentence with each area that has its own page linked to it
   (SEO audit M11). "Toronto" goes to the downtown page, the only Toronto
   page there is. */
const AREA_LINKS: Record<string, string> = {
  Toronto: '/locations/toronto-downtown/',
  ...Object.fromEntries(locations.filter((l) => l.slug !== 'toronto-downtown').map((l) => [l.name, `/locations/${l.slug}/`])),
  /* The three Durham towns share one page. East York and York have no page
     and stay plain text (7 Nov 2026, SEO re-audit content N4): linked, they
     pointed at the page that targets downtown Toronto. */
  Pickering: '/locations/durham-region/',
  Ajax: '/locations/durham-region/',
  Oshawa: '/locations/durham-region/',
};
const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const linkedCoverage = escape(COVERAGE_SENTENCE).replace(
  new RegExp(`\\b(${Object.keys(AREA_LINKS).join('|')})\\b`, 'g'),
  (name) => `<a href="${AREA_LINKS[name]}">${name}</a>`,
);

/* 185 characters until 7 Nov 2026 (SEO re-audit onpage N1): the regions
   rather than eleven place names. */
const description =
  'Office and commercial cleaning across the GTA from one Toronto office, with local pages for Toronto, Peel, Halton, York Region and Durham.';

/* The cards grouped by region (7 Nov 2026, SEO re-audit local N4), in the
   groups the homepage and service pages already use (src/data/coverage.ts).
   A location with no group stops the build rather than going missing. */
const groupOf = (slug: string) => {
  const area = AREAS.find((a) => a.href === `/locations/${slug}/`);
  if (!area) throw new Error(`locations/index.astro: /locations/${slug}/ has no group in src/data/coverage.ts`);
  return area.group;
};
const grouped = AREA_GROUPS.map((group) => ({
  group,
  id: `loc-group-${group.replace(/\W+/g, '-').toLowerCase()}`,
  items: locations.filter((l) => groupOf(l.slug) === group),
})).filter((g) => g.items.length > 0);
---

<BaseLayout title={pageTitle(`Service Areas Across the GTA`)} description={description}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema([{ name: site.name, url: '/' }, { name: 'Locations' }]))}
    is:inline
  />
  <div class="page-header">
    <div class="container">
      <h1 class="entry-title">Service Areas</h1>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <span aria-current="page">Locations</span>
      </nav>
    </div>
  </div>

  <div class="section-padding">
    <div class="container">
      <p class="loc-lead">
        Evergreen Office Cleaning works across the Greater Toronto Area from one office, at
        {' '}{nap.streetAddress}, {nap.addressLocality}: <Fragment set:html={linkedCoverage} />. The areas below have a page
        with local detail; East York and York are part of the City of Toronto and are named on the downtown page.
      </p>
      {/* Was "the rest are covered in exactly the same way", which read as a
          promise for every place without a page (7 Nov 2026, SEO re-audit
          local N4). Only the places in coverage.ts are claimed; for anywhere
          else the honest answer is "ask us". */}
      <p class="loc-ask">
        Somewhere not listed, such as Whitby, Newmarket, Aurora, Burlington or Milton? <a href="/contact-us/">Ask us</a> or
        call <a href={nap.phoneHref} data-call-location="content">{nap.phoneDisplay}</a>, and we will tell you plainly whether we
        can schedule your building.
      </p>

      {
        grouped.map(({ group, id, items }) => (
          <section class="loc-group" aria-labelledby={id}>
            <h2 class="loc-group-title" id={id}>{group}</h2>
            <ul class="loc-list" data-reveal="stagger">
              {items.map((location) => (
                <li>
                  <a class="card-hover" href={`/locations/${location.slug}/`}>
                    <h3>{location.name}</h3>
                    <p>{location.focus}</p>
                    <span class="loc-more">Commercial cleaning in {location.name}&nbsp;&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .loc-lead {
    font-size: 1.125rem;
    line-height: 1.6;
    max-width: 780px;
    margin: 0 0 16px;
  }

  .loc-ask {
    max-width: 780px;
    line-height: 1.6;
    margin: 0 0 36px;
  }

  .loc-group + .loc-group {
    margin-top: 40px;
  }

  .loc-group-title {
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    margin: 0 0 18px;
  }

  /* Flex rather than grid, so a last row that is not full is centred
     instead of leaving one card stranded at the left (seven items in rows of
     two or three). The item widths are the columns the grid had. */
  .loc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px;
  }
  .loc-list > li {
    flex: 0 0 100%;
    min-width: 0;
  }
  @media (min-width: 768px) {
    .loc-list > li {
      flex-basis: calc((100% - 1 * 24px) / 2);
    }
  }
  @media (min-width: 992px) {
    .loc-list > li {
      flex-basis: calc((100% - 2 * 24px) / 3);
    }
  }

  .loc-list a {
    display: block;
    height: 100%;
    padding: 24px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
  }

  /* The border, lift and shadow come from `.card-hover` in global.css, the
     same treatment as every other linked card on the site. */
  .loc-list a:hover,
  .loc-list a:focus-visible {
    text-decoration: none;
  }

  .loc-more {
    position: relative;
    left: 0;
    transition: left var(--motion-base) var(--ease-out);
  }

  @media (hover: hover) {
    .loc-list a:hover .loc-more {
      left: 4px;
    }
  }

  .loc-list h3 {
    font-size: 1.25rem;
    margin: 0 0 10px;
  }

  .loc-list p {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 14px;
  }

  /* Sentence case: in letter-spaced capitals "Commercial cleaning in
     Downtown Toronto" broke over two ragged lines in every card. */
  .loc-more {
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--brand);
  }
</style>
