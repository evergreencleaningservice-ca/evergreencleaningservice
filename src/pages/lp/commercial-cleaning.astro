---
/**
 * /lp/commercial-cleaning/ — Sections 3 and 4 of the overhaul specification.
 *
 * Laid out as the spec's wireframe: headline and trust badges on the left, the
 * proposal form on the right and above the fold, review proof beneath, then the
 * three-step process, then the sticky mobile bar.
 *
 * TWO CLAIMS FROM THE SPEC'S MOCKUP ARE NOT PRINTED HERE.
 *
 *   "4.9/5 Google Rating"  — there are four recovered Google reviews and no
 *                            verified rating or review count. A star rating is
 *                            a factual claim, and an invented one is also a
 *                            Google policy violation. The badge instead says
 *                            what can be shown: real reviews, quoted below.
 *   "20+ Years in Business" — the business has traded since 1989, which is 36
 *                            years. The spec understates it; the badge uses the
 *                            figure the site itself has always published.
 *
 * Put the real rating and review count in and the first badge can say it.
 */
import LandingLayout from '../../layouts/LandingLayout.astro';
import { nap, site } from '../../data/site';
import { reviews } from '../../data/reviews';

const year = new Date().getFullYear();
const yearsTrading = year - site.since;

const badges = [
  { label: 'Real Google reviews', detail: 'from Toronto businesses' },
  { label: `${yearsTrading}+ years in business`, detail: `Cleaning the GTA since ${site.since}` },
  { label: 'WSIB compliant & bonded', detail: 'Fully insured crews' },
];

const bullets = [
  'A dedicated account manager, not a call centre',
  'Flexible after-hours and weekend crews',
  'Written scope after an on-site walkthrough',
  'Bonded, insured and WSIB compliant',
];

const steps = [
  { n: 1, title: 'Walkthrough', body: 'We visit your facility and scope the work with you — not over the phone.' },
  { n: 2, title: 'Custom plan', body: 'A written schedule and scope, priced to your space and your hours.' },
  { n: 3, title: 'Pristine clean', body: 'Your own crew and account manager, with the standard held to the scope.' },
];

const sizes = [
  { value: 'under-5k', label: 'Under 5,000 sq. ft. (Small Office)' },
  { value: '5k-20k', label: '5,000 - 20,000 sq. ft. (Mid-size Commercial)' },
  { value: '20k-50k', label: '20,000 - 50,000 sq. ft. (Large Facility / Industrial)' },
  { value: '50k-plus', label: '50,000+ sq. ft. (Multi-tenant / Warehouse)' },
  { value: 'post-construction', label: 'Post-Construction Turnover' },
];
---

<LandingLayout
  title={`Commercial & Office Cleaning in Toronto — Free On-Site Proposal | ${nap.name}`}
  description="Top-rated commercial and office cleaning in Toronto and the GTA. Get a walkthrough estimate within 24 business hours. Bonded, insured and WSIB compliant."
>
  <section class="lp-hero">
    <div class="lp-wrap lp-hero-grid">
      <div class="lp-pitch">
        <h1>Top-Rated Commercial &amp; Office Cleaning in Toronto</h1>
        <p class="lp-sub">
          On-site walkthrough, written scope, and a crew that turns up. Serving Toronto and the
          GTA since {site.since}.
        </p>

        <ul class="lp-badges">
          {
            badges.map((b) => (
              <li>
                <strong>{b.label}</strong>
                <span>{b.detail}</span>
              </li>
            ))
          }
        </ul>

        <ul class="lp-bullets">
          {bullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>

      <div class="lp-form-col">
        <form id="ppc-lead-form" class="lp-form" novalidate>
          <h2>Request an On-Site Proposal</h2>
          <p class="lp-form-note">Receive a detailed proposal within 24 business hours.</p>

          <div class="lp-field">
            <label for="fullName">Full Name <span aria-hidden="true">*</span></label>
            <input type="text" id="fullName" name="fullName" required autocomplete="name" placeholder="Jane Doe" />
          </div>

          <div class="lp-field">
            <label for="workEmail">Business Email <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="workEmail"
              name="workEmail"
              required
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              placeholder="jane@company.com"
            />
          </div>

          <div class="lp-field">
            <label for="phone">Phone Number <span aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              autocomplete="tel"
              inputmode="tel"
              placeholder="(416) 555-0199"
            />
          </div>

          <div class="lp-field">
            <label for="facilitySize">Facility Size / Scope <span aria-hidden="true">*</span></label>
            <select id="facilitySize" name="facilitySize" required>
              <option value="" disabled selected>Select facility size</option>
              {sizes.map((s) => <option value={s.value}>{s.label}</option>)}
            </select>
          </div>

          {/* Honeypot, replacing the original's arithmetic captcha (Section 3.2).
              Hidden from everyone, including assistive technology; a bot fills it. */}
          <div class="lp-hp" aria-hidden="true">
            <label for="company_tax_id">Company tax ID</label>
            <input type="text" id="company_tax_id" name="company_tax_id" tabindex="-1" autocomplete="off" />
          </div>

          <p class="lp-error" id="lp-error" role="alert" hidden></p>

          <button type="submit" class="lp-submit">Get My Free Proposal &rarr;</button>
          <p class="lp-confidential">Information is kept strictly confidential.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="lp-proof">
    <div class="lp-wrap">
      <h2>What Toronto businesses say</h2>
      <ul class="lp-reviews">
        {
          reviews.slice(0, 4).map((r) => (
            <li>
              <p class="lp-review-body">{r.text}</p>
              <p class="lp-review-who">
                <strong>{r.name}</strong>
                <span>Google review</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lp-process">
    <div class="lp-wrap">
      <h2>How it works</h2>
      <ol class="lp-steps">
        {
          steps.map((s) => (
            <li>
              <span class="lp-step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Section 3.3 — sticky mobile action bar, under 768px only. */}
  <div class="lp-sticky" slot="sticky">
    <a class="lp-sticky-call" href={nap.phoneHref} data-call>{nap.phoneDisplay}</a>
    <a class="lp-sticky-quote" href="#ppc-lead-form">Instant Quote</a>
  </div>
</LandingLayout>

<script>
  /* Section 4.1 — the dataLayer pipeline.
     The form posts to /api/submit-lead and only redirects on a 200, so a
     failure surfaces to the visitor instead of pretending to have worked. */
  const leadForm = document.getElementById('ppc-lead-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('lp-error');

  const param = (name: string) => new URLSearchParams(location.search).get(name) ?? '';

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  if (leadForm) {
    leadForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (errorBox) errorBox.hidden = true;

      // Honeypot: a bot filled the hidden field. Stop, silently.
      const honeypot = leadForm.querySelector<HTMLInputElement>('input[name="company_tax_id"]');
      if (honeypot?.value) return;

      if (!leadForm.checkValidity()) {
        leadForm.reportValidity();
        return;
      }

      const submit = leadForm.querySelector<HTMLButtonElement>('button[type="submit"]');
      const facilitySize = (document.getElementById('facilitySize') as HTMLSelectElement).value;

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'lead_form_submission',
        form_id: 'ppc-lead-form',
        facility_size: facilitySize,
      });

      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending…';
      }

      try {
        const res = await fetch('/api/submit-lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            form_id: 'ppc-lead-form',
            name: (document.getElementById('fullName') as HTMLInputElement).value,
            email: (document.getElementById('workEmail') as HTMLInputElement).value,
            phone: (document.getElementById('phone') as HTMLInputElement).value,
            size: facilitySize,
            page_url: location.href,
            referrer: document.referrer,
            // what makes the lead attributable to a click
            gclid: param('gclid'),
            utm_source: param('utm_source'),
            utm_medium: param('utm_medium'),
            utm_campaign: param('utm_campaign'),
          }),
        });

        if (res.ok) {
          window.location.href = '/thank-you/';
          return;
        }
        showError(
          'Something went wrong sending that. Please call (416) 803-4880 and we will take the details directly.'
        );
      } catch {
        showError(
          'We could not reach the server. Please call (416) 803-4880 and we will take the details directly.'
        );
      }

      if (submit) {
        submit.disabled = false;
        submit.textContent = 'Get My Free Proposal →';
      }
    });
  }
</script>

<style>
  .lp-wrap {
    max-width: 1140px;
    margin: 0 auto;
    padding: 0 15px;
  }

  .lp-hero {
    padding: 44px 0 20px;
    background: linear-gradient(180deg, #f6f8f5 0%, #fff 100%);
  }

  .lp-hero-grid {
    display: grid;
    gap: 34px;
  }

  @media (min-width: 941px) {
    .lp-hero-grid {
      grid-template-columns: minmax(0, 1fr) 420px;
      align-items: start;
    }
  }

  .lp-pitch h1 {
    font-size: 2.25rem;
    line-height: 1.15;
    margin: 0 0 14px;
  }

  @media (min-width: 768px) {
    .lp-pitch h1 {
      font-size: 2.75rem;
    }
  }

  .lp-sub {
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 26px;
  }

  .lp-badges {
    list-style: none;
    margin: 0 0 26px;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  @media (min-width: 560px) {
    .lp-badges {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lp-badges li {
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
  }

  .lp-badges strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    color: var(--ink-heading);
  }

  .lp-badges span {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-soft);
    margin-top: 3px;
  }

  .lp-bullets {
    margin: 0;
    padding-left: 20px;
    line-height: 1.8;
  }

  /* --- the form --- */
  .lp-form {
    background: #fff;
    border: 1px solid #f1f5f9;
    border-radius: 12px;
    padding: 24px;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
  }

  .lp-form h2 {
    font-size: 1.375rem;
    margin: 0 0 4px;
  }

  .lp-form-note {
    font-size: 0.75rem;
    color: #4b5563;
    margin: 0 0 18px;
  }

  .lp-field {
    margin-bottom: 14px;
  }

  .lp-field label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: #374151;
    margin-bottom: 5px;
  }

  .lp-field label span {
    color: #dc2626;
  }

  .lp-field input,
  .lp-field select {
    width: 100%;
    font: inherit;
    font-size: 0.875rem;
    padding: 10px 12px;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    background: #fff;
    color: var(--ink-heading);
  }

  .lp-field input:focus,
  .lp-field select:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(77, 140, 43, 0.15);
  }

  /* Hidden from sighted users and from assistive technology alike. */
  .lp-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .lp-error {
    margin: 0 0 12px;
    padding: 10px 12px;
    border-radius: 6px;
    background: #fef2f2;
    border: 1px solid #fecaca;
    color: #991b1b;
    font-size: 0.8125rem;
  }

  .lp-submit {
    width: 100%;
    border: 0;
    border-radius: 6px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
    padding: 14px;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .lp-submit:hover:not(:disabled) {
    background: var(--brand-dark);
  }

  .lp-submit:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .lp-confidential {
    text-align: center;
    font-size: 0.75rem;
    color: #6b7280;
    margin: 10px 0 0;
  }

  /* --- proof --- */
  .lp-proof {
    padding: 48px 0 8px;
  }

  .lp-proof h2,
  .lp-process h2 {
    font-size: 1.75rem;
    text-align: center;
    margin: 0 0 28px;
  }

  .lp-reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }

  @media (min-width: 768px) {
    .lp-reviews {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .lp-reviews {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .lp-reviews li {
    background: #f8fafc;
    border-radius: 12px;
    padding: 20px;
  }

  .lp-review-body {
    font-size: 0.9375rem;
    line-height: 1.55;
    margin: 0 0 14px;
  }

  .lp-review-who strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.875rem;
  }

  .lp-review-who span {
    font-size: 0.75rem;
    color: var(--ink-soft);
  }

  /* --- process --- */
  .lp-process {
    padding: 44px 0 0;
  }

  .lp-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
    counter-reset: step;
  }

  @media (min-width: 768px) {
    .lp-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lp-steps li {
    text-align: center;
    padding: 0 12px;
  }

  .lp-step-n {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 800;
    margin-bottom: 12px;
  }

  .lp-steps h3 {
    font-size: 1.0625rem;
    margin: 0 0 6px;
  }

  .lp-steps p {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink);
    margin: 0;
  }

  /* --- sticky mobile bar, Section 3.3 --- */
  .lp-sticky {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    gap: 8px;
    padding: 8px;
    background: #fff;
    border-top: 1px solid #e5e7eb;
    box-shadow: 0 -4px 14px rgba(15, 23, 42, 0.1);
  }

  @media (min-width: 768px) {
    .lp-sticky {
      display: none;
    }
  }

  .lp-sticky a {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 13px 8px;
    border-radius: 8px;
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    color: #fff;
  }

  .lp-sticky-call {
    background: var(--brand);
  }

  .lp-sticky-quote {
    background: #0f172a;
  }
</style>
