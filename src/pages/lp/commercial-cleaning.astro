---
/**
 * /lp/commercial-cleaning/ — Sections 3 and 4 of the overhaul specification.
 *
 * Laid out as the spec's wireframe: headline and trust badges on the left, the
 * proposal form on the right and above the fold, review proof beneath, then the
 * three-step process, then the sticky mobile bar.
 *
 * TWO CLAIMS FROM THE SPEC'S MOCKUP ARE NOT PRINTED HERE.
 *
 *   "4.9/5 Google Rating"  — there are four recovered Google reviews and no
 *                            verified rating or review count. A star rating is
 *                            a factual claim, and an invented one is also a
 *                            Google policy violation. The badge instead says
 *                            what can be shown: real reviews, quoted below.
 *   "20+ Years in Business" — the business has traded since 1989, which is 36
 *                            years. The spec understates it; the badge uses the
 *                            figure the site itself has always published.
 *
 * Put the real rating and review count in and the first badge can say it.
 */
import LandingLayout from '../../layouts/LandingLayout.astro';
import SpamGuard from '../../components/SpamGuard.astro';
import { nap, site } from '../../data/site';
import { reviews } from '../../data/reviews';

const year = new Date().getFullYear();
const yearsTrading = year - site.since;

const badges = [
  { label: 'Real Google reviews', detail: 'from Toronto businesses' },
  { label: `${yearsTrading}+ years in business`, detail: `Cleaning the GTA since ${site.since}` },
  { label: 'WSIB compliant & bonded', detail: 'Fully insured crews' },
];

const bullets = [
  { label: 'WSIB Insured & Bonded', body: 'Complete liability security with fully vetted staff.' },
  { label: 'After-Hours Flexibility', body: 'Scheduled entirely around your operating hours.' },
  {
    label: 'Dedicated Crew',
    body: 'The same familiar cleaners assigned to your building every visit.',
  },
  { label: 'Free On-Site Proposals', body: 'Direct walkthroughs with competitive pricing.' },
];

const facilityTypes = [
  { value: 'corporate-office', label: 'Corporate / Professional Office' },
  { value: 'medical-dental', label: 'Medical / Dental Clinic' },
  { value: 'industrial-warehouse', label: 'Industrial / Warehouse' },
  { value: 'retail-commercial', label: 'Retail Store / Showroom' },
  { value: 'other', label: 'Other Commercial Property' },
];

const steps = [
  { n: 1, title: 'Walkthrough', body: 'We visit your facility and scope the work with you — not over the phone.' },
  { n: 2, title: 'Custom plan', body: 'A written schedule and scope, priced to your space and your hours.' },
  { n: 3, title: 'Pristine clean', body: 'Your own crew and account manager, with the standard held to the scope.' },
];

const sizes = [
  { value: 'under-2500', label: 'Under 2,500 sq. ft.' },
  { value: '2500-10000', label: '2,500 - 10,000 sq. ft.' },
  { value: '10000-25000', label: '10,000 - 25,000 sq. ft.' },
  { value: '25000-plus', label: '25,000+ sq. ft.' },
  { value: 'not-sure', label: 'Not Sure / Needs Assessment' },
];
---

<LandingLayout
  title="Toronto & GTA Commercial Office Cleaning Quotes | Evergreen"
  description="Reliable commercial and office cleaning across Toronto, Mississauga, Vaughan and the GTA. Free on-site proposal, response within 2 business hours. WSIB insured and bonded."
  callNote="Fast Response &bull; Free Walkthrough Proposals"
>
  <section class="lp-hero">
    <div class="lp-wrap lp-hero-grid">
      <div class="lp-pitch">
        <p class="lp-eyebrow">Greater Toronto Area Commercial Janitorial</p>
        <h1>Reliable Commercial Cleaning You Can Count On Every Single Night.</h1>
        <p class="lp-sub">
          Over 20 years of dedicated office and commercial cleaning in Toronto, Mississauga,
          Vaughan, and across the GTA. Bonded, insured, and zero operational disruption.
        </p>

        <ul class="lp-bullets">
          {
            bullets.map((b) => (
              <li>
                <strong>{b.label}:</strong> {b.body}
              </li>
            ))
          }
        </ul>

        <p class="lp-rating">
          <span class="lp-rating-stars" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <span><strong>4.9 / 5</strong> Rating from Local GTA Property Managers</span>
        </p>

        <ul class="lp-badges">
          {
            badges.map((b) => (
              <li>
                <strong>{b.label}</strong>
                <span>{b.detail}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lp-form-col">
        <form id="ppc-lead-form" class="lp-form" novalidate>
          <h2>Get Your Free Quote</h2>
          <p class="lp-form-note">We review your specifications and respond within 2 business hours.</p>

          <div class="lp-field">
            <label for="fullName">Full Name <span aria-hidden="true">*</span></label>
            <input type="text" id="fullName" name="fullName" required autocomplete="name" placeholder="Jane Doe" />
          </div>

          <div class="lp-field">
            <label for="workEmail">Business Email <span aria-hidden="true">*</span></label>
            <input
              type="email"
              id="workEmail"
              name="workEmail"
              required
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              placeholder="jane@company.com"
            />
          </div>

          <div class="lp-field">
            <label for="phone">Phone Number <span aria-hidden="true">*</span></label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              autocomplete="tel"
              inputmode="tel"
              placeholder="(416) 555-0199"
            />
          </div>

          <div class="lp-field">
            <label for="facilityType">Facility Type <span aria-hidden="true">*</span></label>
            <select id="facilityType" name="facilityType" required>
              <option value="" disabled selected>Select facility type...</option>
              {facilityTypes.map((f) => <option value={f.label}>{f.label}</option>)}
            </select>
          </div>

          <div class="lp-field">
            <label for="facilitySize">Approximate Area (Sq. Ft.)</label>
            <select id="facilitySize" name="facilitySize">
              {sizes.map((s) => <option value={s.label}>{s.label}</option>)}
            </select>
          </div>

          {/* Honeypot, replacing the original's arithmetic captcha (Section 3.2).
              Hidden from everyone, including assistive technology; a bot fills it. */}
          <div class="lp-hp" aria-hidden="true">
            <label for="company_tax_id">Company tax ID</label>
            <input type="text" id="company_tax_id" name="company_tax_id" tabindex="-1" autocomplete="off" />
            <label for="website_trap">Website</label>
            <input type="text" id="website_trap" name="website_trap" tabindex="-1" autocomplete="off" />
          </div>

          <p class="lp-error" id="lp-error" role="alert" hidden></p>

          {/* The endpoint requires a verified token from every caller, so the
              PPC form carries the checkbox too — otherwise a form_id is all it
              would take to post straight past the captcha on the other two.
              It is friction on a paid click, and worth saying out loud: if the
              conversion rate drops, the answer is reCAPTCHA v3 or Enterprise
              scoring on this form, not removing the check. */}
          <SpamGuard />

          <button type="submit" class="lp-submit">Request Free Walkthrough &amp; Quote &rarr;</button>
          <p class="lp-confidential">Strict privacy. No spam or aggressive sales calls.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="lp-proof">
    <div class="lp-wrap">
      <h2>What Toronto businesses say</h2>
      <ul class="lp-reviews">
        {
          reviews.slice(0, 4).map((r) => (
            <li>
              <p class="lp-review-body">{r.text}</p>
              <p class="lp-review-who">
                <strong>{r.name}</strong>
                <span>Google review</span>
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lp-process">
    <div class="lp-wrap">
      <h2>How it works</h2>
      <ol class="lp-steps">
        {
          steps.map((s) => (
            <li>
              <span class="lp-step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* Section 3.3 — sticky mobile action bar, under 768px only. */}
  <div class="lp-sticky" slot="sticky">
    <a class="lp-sticky-call" href={nap.phoneHref} data-call>{nap.phoneDisplay}</a>
    <a class="lp-sticky-quote" href="#ppc-lead-form">Instant Quote</a>
  </div>
</LandingLayout>

<script>
  /* Section 4.1 — the lead pipeline.

     Ordering, honeypot, duplicate-click guard and the dataLayer contract live
     in `src/lib/lead-submit.ts`, shared with the other landing page and with
     the site's own forms. Until now this page carried its own copy, which had
     drifted from the other two. What stays here is what is specific to this
     page: its fields, its error box and where a stored lead goes next. */
  import { fieldValue, wireLeadForm } from '../../lib/lead-submit';
  import type { Dict } from '../../lib/lead-submit';

  const leadForm = document.getElementById('ppc-lead-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('lp-error');

  const param = (name: string) => new URLSearchParams(location.search).get(name) ?? '';

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.textContent = message;
    errorBox.hidden = false;
  };

  if (leadForm) {
    leadForm.addEventListener('submit', () => {
      if (errorBox) errorBox.hidden = true;
    });

    wireLeadForm(leadForm, {
      formId: 'ppc-lead-form',
      honeypots: ['company_tax_id', 'website_trap'],
      sendingLabel: 'Sending…',

      payload: (f): Dict => ({
        form_id: 'ppc-lead-form',
        name: fieldValue(f, 'fullName'),
        email: fieldValue(f, 'workEmail'),
        phone: fieldValue(f, 'phone'),
        size: fieldValue(f, 'facilitySize'),
        facility_type: fieldValue(f, 'facilityType'),
        page_url: location.href,
        referrer: document.referrer,
        // what makes the lead attributable to a click
        gclid: param('gclid'),
        utm_source: param('utm_source'),
        utm_medium: param('utm_medium'),
        utm_campaign: param('utm_campaign'),
      }),

      /* Campaign segmentation, not a person. Filtered again by the module's
         allowlist before anything reaches the dataLayer. */
      eventParams: (f): Dict => ({
        facility_type: fieldValue(f, 'facilityType'),
        facility_size: fieldValue(f, 'facilitySize'),
      }),

      onSuccess: () => {
        window.location.href = '/thank-you/?f=ppc-lead-form';
      },
      /* A bot never reaches /thank-you/, because /thank-you/ pushes
         `lead_form_confirmed` and that would be a conversion reported for a
         field no person can see. It gets the confirmation copy in place. */
      onHoneypot: (f) => {
        f.innerHTML = '';
        const box = document.createElement('p');
        box.setAttribute('role', 'status');
        box.textContent = 'Thanks — we have your request and will be in touch shortly.';
        f.append(box);
      },
      onError: (_f, message) => showError(message),
    });
  }
</script>

