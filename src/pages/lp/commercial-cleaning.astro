    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 24px;
    font-size: 0.9375rem;
    color: var(--ink-heading);
  }

  .lp-rating-stars {
    color: #fbc02d;
    font-size: 1.15rem;
    letter-spacing: 1px;
  }

  .lp-pitch h1 {
      font-size: 2.75rem;
    }
  }

