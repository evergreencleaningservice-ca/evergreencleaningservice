---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';

const entry = await getEntry('pages', 'request-a-quote');
if (!entry) throw new Error('Missing content entry: pages/request-a-quote');

/**
 * This page has no prose in the archive. Its Markdown body is nothing but the
 * old WPForms embed (form id 1381) flattened into text — field labels, the
 * service checkboxes — so there is no `<Content />` to
 * render here. The title, description and the field list below are the page.
 */

/*
 * TODO — the submit endpoint is not wired up yet.
 *
 * The original form posted back to WordPress and was protected by a
 * server-side arithmetic captcha ("What is 7+2?") plus reCAPTCHA v2. Neither
 * survives a static build, so the markup below is a plain HTML form with
 * `action="#"`: it validates in the browser and then goes nowhere. Before
 * launch, point `action` at a real handler and re-add spam protection there —
 * the honeypot below is only half the job.
 */

const services = [
  'Commercial Cleaning',
  'Office Cleaning',
  'Janitorial Services',
  'Commercial Carpet Cleaning',
  'Floor Services / Finishing',
  'Reno Construction Clean-up',
  'Other',
];
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
>
  <QuoteForm id="quote" />
</PageLayout>

<style>
  .entry-content + :global(.quote-form) {
    margin-top: 30px;
  }
</style>
