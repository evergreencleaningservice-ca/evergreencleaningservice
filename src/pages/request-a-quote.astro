---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'request-a-quote');
if (!entry) throw new Error('Missing content entry: pages/request-a-quote');

/**
 * This page has no prose in the archive. Its Markdown body is nothing but the
 * old WPForms embed (form id 1381) flattened into text — field labels, the
 * service checkboxes, the arithmetic captcha — so there is no `<Content />` to
 * render here. The title, description and the field list below are the page.
 */

/*
 * TODO — the submit endpoint is not wired up yet.
 *
 * The original form posted back to WordPress and was protected by a
 * server-side arithmetic captcha ("What is 7+2?") plus reCAPTCHA v2. Neither
 * survives a static build, so the markup below is a plain HTML form with
 * `action="#"`: it validates in the browser and then goes nowhere. Before
 * launch, point `action` at a real handler and re-add spam protection there —
 * the honeypot below is only half the job.
 */

const services = [
  'Commercial Cleaning',
  'Office Cleaning',
  'Janitorial Services',
  'Commercial Carpet Cleaning',
  'Floor Services / Finishing',
  'Reno Construction Clean-up',
  'Other',
];
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
>
  <p class="form-note">Fields marked <span class="req">*</span> are required.</p>

  {/* See the TODO in this file's frontmatter: action="#" is a placeholder. */}
  <form class="site-form" method="post" action="#" aria-label="Request a quote">
    <fieldset class="form-group">
      <legend>Name <span class="req" aria-hidden="true">*</span></legend>
      <div class="form-row form-row-2">
        <div class="form-field">
          <label for="quote-first">First</label>
          <input type="text" id="quote-first" name="first-name" autocomplete="given-name" required />
        </div>
        <div class="form-field">
          <label for="quote-last">Last</label>
          <input type="text" id="quote-last" name="last-name" autocomplete="family-name" required />
        </div>
      </div>
    </fieldset>

    <div class="form-field">
      <label for="quote-business">
        Name of Business <span class="req" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="quote-business"
        name="business-name"
        autocomplete="organization"
        required
      />
    </div>

    <div class="form-field">
      <label for="quote-email">Email <span class="req" aria-hidden="true">*</span></label>
      <input
        type="email"
        id="quote-email"
        name="email"
        inputmode="email"
        autocomplete="email"
        spellcheck="false"
        required
      />
    </div>

    <div class="form-field">
      <label for="quote-phone">Phone <span class="req" aria-hidden="true">*</span></label>
      <input type="tel" id="quote-phone" name="phone" inputmode="tel" autocomplete="tel" required />
    </div>

    <fieldset class="form-group">
      <legend>I&rsquo;m interested a quote for these services</legend>
      <ul class="choice-list">
        {
          services.map((service, index) => (
            <li class="choice">
              <input
                type="checkbox"
                id={`quote-service-${index}`}
                name="services"
                value={service}
              />
              <label for={`quote-service-${index}`}>{service}</label>
            </li>
          ))
        }
      </ul>
    </fieldset>

    <div class="form-field">
      <label for="quote-comments">Additional comments</label>
      <textarea id="quote-comments" name="comments" rows="6"></textarea>
    </div>

    {/* Honeypot, carried over from the original form. Real people never see it. */}
    <div class="form-hp" aria-hidden="true">
      <label for="quote-hp">Leave this field empty</label>
      <input type="text" id="quote-hp" name="company-website" tabindex="-1" autocomplete="off" />
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Submit</button>
  </form>
</PageLayout>

<style>
  .form-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin-bottom: 1.8rem;
  }

  .req {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .site-form {
    max-width: 640px;
  }

  .form-group {
    /* Fieldsets default to min-width: min-content, which forces horizontal
       scroll on narrow screens. */
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .form-group legend,
  .form-field label {
    display: block;
    padding: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-heading);
    margin-bottom: 0.35rem;
  }

  .form-group legend {
    margin-bottom: 0.6rem;
  }

  .form-field {
    margin-bottom: 1.25rem;
  }

  .form-row {
    display: grid;
    gap: 0 1rem;
  }

  @media (min-width: 560px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  input[type='text'],
  input[type='tel'],
  input[type='email'],
  textarea {
    width: 100%;
    max-width: 100%;
    font: inherit;
    color: inherit;
    background: #fff;
    padding: 0.6rem 0.75rem;
    border: 1px solid #cdd2d7;
    border-radius: var(--radius);
  }

  textarea {
    resize: vertical;
    min-height: 9rem;
  }

  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .choice-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  @media (min-width: 560px) {
    .choice-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .choice {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin: 0;
  }

  .choice input {
    margin: 0.3rem 0 0;
    flex: none;
    width: 1rem;
    height: 1rem;
    accent-color: var(--brand);
  }

  .choice label {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: inherit;
    color: var(--ink);
    margin: 0;
  }

  .form-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  button[type='submit'] {
    margin-top: 0.5rem;
  }
</style>
