---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'reviews');
if (!entry) throw new Error('Missing content entry: pages/reviews');

/**
 * Like contact-us and request-a-quote, this entry ends with the old WPForms
 * embed (form id 1414) flattened into prose — every field label as its own
 * paragraph. The copy above it invites the visitor to "complete the form
 * below", so cut the body at the flattened block and rebuild the form as real
 * HTML underneath. That slicing is why this page reads `entry.rendered.html`
 * directly instead of rendering `<Content />`.
 */
const rawBody = entry.rendered?.html ?? '';
const fieldDumpAt = rawBody.indexOf('>Name *<');
const cutAt = fieldDumpAt === -1 ? -1 : rawBody.lastIndexOf('<p', fieldDumpAt);
if (cutAt === -1) {
  throw new Error(
    'reviews: expected the flattened WPForms block in the page body to cut at. ' +
      'src/content/pages/reviews.md has changed shape — check it before rendering it verbatim.',
  );
}
const introHtml = rawBody.slice(0, cutAt);

/*
 * TODO — the submit endpoint is not wired up yet.
 *
 * The original form posted back to WordPress and was protected by reCAPTCHA
 * v2, neither of which survives a static build, so the markup below is a plain
 * HTML form with `action="#"`: it validates in the browser and then goes
 * nowhere. Before launch, point `action` at a real handler and re-add spam
 * protection there — the honeypot below is only half the job. Submitted
 * testimonials were moderated before publication, so the handler needs to hold
 * them for review rather than post them straight to the site.
 */
---

<PageLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.image}
  contentHtml={introHtml}
>
  <p class="form-note">Fields marked <span class="req">*</span> are required.</p>

  {/* See the TODO in this file's frontmatter: action="#" is a placeholder. */}
  <form class="site-form" method="post" action="#" aria-label="Submit your testimonial">
    <fieldset class="form-group">
      <legend>Name <span class="req" aria-hidden="true">*</span></legend>
      <div class="form-row form-row-2">
        <div class="form-field">
          <label for="testimonial-first">First</label>
          <input
            type="text"
            id="testimonial-first"
            name="first-name"
            autocomplete="given-name"
            required
          />
        </div>
        <div class="form-field">
          <label for="testimonial-last">Last</label>
          <input
            type="text"
            id="testimonial-last"
            name="last-name"
            autocomplete="family-name"
            aria-describedby="testimonial-name-hint"
            required
          />
        </div>
      </div>
      <p class="form-hint" id="testimonial-name-hint">
        Feel free to just use an initial for your last name &hellip;
      </p>
    </fieldset>

    <div class="form-field">
      <label for="testimonial-business">Business / Title</label>
      <input
        type="text"
        id="testimonial-business"
        name="business-title"
        autocomplete="organization"
      />
    </div>

    <div class="form-field">
      <label for="testimonial-email">Email <span class="req" aria-hidden="true">*</span></label>
      <input
        type="email"
        id="testimonial-email"
        name="email"
        inputmode="email"
        autocomplete="email"
        spellcheck="false"
        aria-describedby="testimonial-email-hint"
        required
      />
      <p class="form-hint" id="testimonial-email-hint">Your email will not be published</p>
    </div>

    <div class="form-field">
      <label for="testimonial-review">
        Review / Testimonial <span class="req" aria-hidden="true">*</span>
      </label>
      <textarea id="testimonial-review" name="review" rows="7" required></textarea>
    </div>

    {/* Honeypot, carried over from the original form. Real people never see it. */}
    <div class="form-hp wpf-hp" aria-hidden="true">
      <label for="testimonial-hp">Leave this field empty</label>
      <input
        type="text"
        id="testimonial-hp"
        name="company-website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <button class="btn btn-primary btn-lg" type="submit">Submit</button>
  </form>
</PageLayout>

<style>
  .form-note {
    font-size: 0.9rem;
    color: var(--ink-soft);
    margin: 2rem 0 1.8rem;
  }

  .req {
    color: var(--brand-dark);
    font-weight: 700;
  }

  .site-form {
    max-width: 640px;
  }

  .form-group {
    /* Fieldsets default to min-width: min-content, which forces horizontal
       scroll on narrow screens. */
    min-width: 0;
    border: 0;
    padding: 0;
    margin: 0 0 1.25rem;
  }

  .form-group legend,
  .form-field label {
    display: block;
    padding: 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink-heading);
    margin-bottom: 0.35rem;
  }

  .form-group legend {
    margin-bottom: 0.6rem;
  }

  .form-field {
    margin-bottom: 1.25rem;
  }

  .form-hint {
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin: 0.35rem 0 0;
  }

  .form-row {
    display: grid;
    gap: 0 1rem;
  }

  @media (min-width: 560px) {
    .form-row-2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    max-width: 100%;
    font: inherit;
    color: inherit;
    background: #fff;
    padding: 0.6rem 0.75rem;
    border: 1px solid #cdd2d7;
    border-radius: var(--radius);
  }

  textarea {
    resize: vertical;
    min-height: 10rem;
  }

  input:focus-visible,
  textarea:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .form-hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  button[type='submit'] {
    margin-top: 0.5rem;
  }
</style>
