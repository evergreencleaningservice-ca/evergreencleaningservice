---
/**
 * /services/<slug>/ — every service page, through the shared OfferPage
 * template. A page whose front matter carries only the original fields
 * renders its Markdown inside the template; one with the structured fields
 * gets the full page. See src/components/OfferPage.astro.
 */
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import OfferPage from '../../components/OfferPage.astro';
import { normalizeBody } from '../../lib/normalize-body';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { service } = Astro.props as Props;

// `render()` is also what fills `service.rendered`, which is normalised below.
await render(service);
const body = service.rendered?.html ? normalizeBody(service.rendered.html) : null;
---

<OfferPage
  data={service.data}
  body={body}
  parent={{ name: 'Services', url: '/services/' }}
  formId={`service-${service.id}`}
/>
