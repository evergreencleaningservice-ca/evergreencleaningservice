---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { site, nav } from '../../data/site';
import { breadcrumbSchema } from '../../lib/schema';

/*
 * The original /services/ URL was an empty WordPress page archive (no content of
 * its own), so this landing page is assembled from the service pages themselves.
 * The heading and eyebrow are the ones the homepage uses over the same set of
 * services; the card order follows the Services menu in the site navigation.
 */
const navServices = nav.find((item) => item.label === 'Services')?.children ?? [];
const navOrder = navServices.map((child) =>
  (child.href ?? '').replace(/^\/services\//, '').replace(/\/$/, ''),
);

const rank = (id: string) => {
  const index = navOrder.indexOf(id);
  return index === -1 ? navOrder.length : index;
};

const services = (await getCollection('services')).sort(
  (a, b) => rank(a.id) - rank(b.id) || a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout
  title="All Cleaning Services | Evergreen Office Cleaning"
  description="Office, commercial, industrial, post-construction, disinfection and emergency cleaning, building maintenance, pressure washing and graffiti removal in the GTA."
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema([{ name: site.name, url: '/' }, { name: 'Services' }]))}
    is:inline
  />
  <div class="page-header">
    <div class="container">
      <p class="section-subtitle">{site.name}</p>
      <h1 class="entry-title">All Our Cleaning Services</h1>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">{site.name}</a> &gt; <span>Services</span>
      </nav>
    </div>
  </div>

  <div class="section-padding">
    <div class="container">
      <div class="svc-grid">
        {
          services.map((service, index) => (
            <ServiceCard service={service} loading={index < 3 ? 'eager' : 'lazy'} />
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page-header .section-subtitle {
    margin-bottom: 6px;
  }

  .page-header .entry-title {
    max-width: 900px;
    margin: 0 auto;
  }

  /* Nine cards: two across on a tablet left the ninth alone at the left.
     A centred flex row centres it. Column widths are the theme's. */
  .svc-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 30px;
  }

  .svc-grid > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
  }

  @media (min-width: 576px) {
    .svc-grid > :global(*) {
      flex-basis: calc((100% - 30px) / 2);
    }
  }

  @media (min-width: 992px) {
    .svc-grid > :global(*) {
      flex-basis: calc((100% - 2 * 30px) / 3);
    }
  }
</style>
