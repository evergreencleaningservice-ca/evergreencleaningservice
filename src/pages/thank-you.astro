---
/**
 * Where /api/submit-lead sends a visitor after a successful submission.
 *
 * Its own page rather than an in-place message because a distinct URL is what
 * a destination-based conversion in Google Ads and GA4 can fire on — belt and
 * braces alongside the dataLayer event, which is what the spec asks for.
 *
 * noindex: a thank-you page has nothing to offer a search result, and an
 * indexed one can be landed on directly, which fires the conversion for someone
 * who never submitted anything.
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import { nap } from '../data/site';

/* The two landing pages promise different response times — 24 business hours
   on /lp/commercial-cleaning/, 2 on /lp/commercial-cleaning-quote/ — and this
   page is shared, so the promise arrives with the redirect as `?t=2`.
   
   It CANNOT be read here. This is a static build: `Astro.url.searchParams` is
   evaluated once, at build time, against a URL that has no query string, so
   reading it here bakes one answer into the HTML and the redirect changes
   nothing. (It did exactly that, and the end-to-end test caught it: the form
   redirected to `?t=2` and the page said 24.)
   
   So both numbers are rendered and CSS picks one, switched by a class that a
   head script sets before first paint — no flicker, and no dependence on when
   a module script happens to run. Nothing from the query string is ever
   written into the page as text, so an editable `?t=` is not an injection
   surface; it only toggles a class. */
---

<LandingLayout
  title={`Thank you — we have your request | ${nap.name}`}
  description="Your quote request has been received. Our account executive will be in touch shortly."
>
  {/* Placed above the text it affects and synchronous, so it runs while the
      parser is still upstream of `.ty-lead` — the class is set before that
      paragraph is ever painted, and there is no flash of the wrong number. */}
  <script is:inline>
    if (new URLSearchParams(location.search).get('t') === '2') {
      document.documentElement.classList.add('ty-fast');
    }
  </script>

  <section class="ty">
    <div class="ty-inner">
      <div class="ty-tick" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20 6 9 17l-5-5"></path>
        </svg>
      </div>

      <h1>Thank you — we have your request</h1>
      <p class="ty-lead">
        Our account executive will contact you within
        {' '}<strong><span class="ty-slow">24</span><span class="ty-fast-n">2</span> business hours</strong>
        {' '}to arrange your on-site walkthrough.
      </p>
      <p>
        Need it sooner? Call us directly and someone will pick up — no queue, no call centre.
      </p>

      <a class="ty-call" href={nap.phoneHref}>Call {nap.phoneDisplay} now</a>
      <p class="ty-rush">For same-day and emergency requests, calling is always faster.</p>
    </div>
  </section>
  <script is:inline>
    /* CONVERSION HOOK.
     *
     * This is the dataLayer event, not a gtag call, and that is deliberate.
     * GTM-5PRC4HBV already carries Google Ads AW-16819334998 with its
     * conversion actions and a conversion linker. Firing
     * `gtag('event','conversion', …)` from here as well would report every
     * lead twice — once from the container, once from the page — and
     * double-counted conversions are worse than none, because Smart Bidding
     * learns from them.
     *
     * So the page announces the conversion and the container decides what to
     * do with it. For the agency: trigger on Custom Event
     * `lead_form_confirmed`, and use `form_id` to tell the two landing pages
     * apart. Destination-based conversions can fire on this URL directly.
     */
    var fast = new URLSearchParams(location.search).get('t') === '2';
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'lead_form_confirmed',
      form_id: fast ? 'lp-commercial-cleaning-quote' : 'ppc-lead-form',
      response_promise_hours: fast ? 2 : 24,
    });
  </script>
</LandingLayout>

<style>
  .ty {
    padding: 70px 15px 90px;
  }

  .ty-inner {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  .ty-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: rgba(77, 140, 43, 0.12);
    color: var(--brand);
    margin-bottom: 22px;
  }

  .ty-inner h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 14px;
  }

  .ty-lead {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .ty-call {
    display: inline-block;
    margin-top: 24px;
    padding: 14px 26px;
    border-radius: 6px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
  }

  .ty-call:hover {
    background: var(--brand-dark);
  }

  /* Default is the weaker promise; the head script opts into the stronger one
     only when the fast landing page sent the visitor here. */
  .ty-fast-n {
    display: none;
  }

  :global(html.ty-fast) .ty-slow {
    display: none;
  }

  :global(html.ty-fast) .ty-fast-n {
    display: inline;
  }

  .ty-rush {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    color: var(--ink);
  }
</style>
