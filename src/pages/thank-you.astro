---
/**
 * Where /api/submit-lead sends a visitor after a successful submission.
 *
 * Its own page rather than an in-place message because a distinct URL is what
 * a destination-based conversion in Google Ads and GA4 can fire on — belt and
 * braces alongside the dataLayer event, which is what the spec asks for.
 *
 * noindex: a thank-you page has nothing to offer a search result, and an
 * indexed one can be landed on directly, which fires the conversion for someone
 * who never submitted anything.
 */
import LandingLayout from '../layouts/LandingLayout.astro';
import { nap } from '../data/site';

/* Both landing pages now promise a response within 2 business hours, so the
   `?t=` switch that rendered one of two numbers is gone — one promise, stated
   once. What still arrives on the URL is `?f=<form_id>`, and it is used for
   the conversion event only, never written into the page as text.
   
   Worth keeping in mind if a third page ever needs a different promise: this
   is a static build, so `Astro.url.searchParams` resolves once at build time
   against a URL with no query string. Reading a param in frontmatter bakes
   one answer into the HTML. It has to be done in the browser. */
---

<LandingLayout
  title="Thank You | Evergreen Cleaning Service"
  description="Your quote request has been received. Our account executive will be in touch shortly."
>
  <section class="ty">
    <div class="ty-inner">
      <div class="ty-tick" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34">
          <path
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M20 6 9 17l-5-5"></path>
        </svg>
      </div>

      <h1>We Received Your Request</h1>
      <p class="ty-lead">
        Thank you for requesting a commercial cleaning proposal. An account representative is
        reviewing your details and will follow up within <strong>2 business hours</strong>.
      </p>

      <div class="ty-rush-box">
        <strong>Need immediate support?</strong><br />
        Call directly at <a href={nap.phoneHref}>{nap.phoneDisplay}</a>
      </div>

      <a class="ty-call" href={nap.phoneHref}>Call {nap.phoneDisplay} now</a>

      {/* The one link off this page, and it only exists after the conversion
          has already been recorded — so it costs nothing the isolation rules
          were protecting. */}
      <p class="ty-home"><a href="/">Return to Homepage</a></p>
    </div>
  </section>
  <script is:inline>
    /* CONVERSION HOOK.
     *
     * This is the dataLayer event, not a gtag call, and that is deliberate.
     * GTM-5PRC4HBV already carries Google Ads AW-16819334998 with its
     * conversion actions and a conversion linker. Firing
     * `gtag('event','conversion', …)` from here as well would report every
     * lead twice — once from the container, once from the page — and
     * double-counted conversions are worse than none, because Smart Bidding
     * learns from them.
     *
     * So the page announces the conversion and the container decides what to
     * do with it. For the agency: trigger on Custom Event
     * `lead_form_confirmed`, and use `form_id` to tell the two landing pages
     * apart. Destination-based conversions can fire on this URL directly.
     */
    /* Whitelisted: `?f=` is visitor-editable, so an unknown value reports as
       'unknown' rather than being passed through into the analytics stream. */
    var known = ['ppc-lead-form', 'lp-commercial-cleaning-quote'];
    var f = new URLSearchParams(location.search).get('f');
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: 'lead_form_confirmed',
      form_id: known.indexOf(f) === -1 ? 'unknown' : f,
      response_promise_hours: 2,
    });
  </script>
</LandingLayout>

<style>
  .ty {
    padding: 70px 15px 90px;
  }

  .ty-inner {
    max-width: 620px;
    margin: 0 auto;
    text-align: center;
  }

  .ty-tick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 66px;
    height: 66px;
    border-radius: 50%;
    background: rgba(77, 140, 43, 0.12);
    color: var(--brand);
    margin-bottom: 22px;
  }

  .ty-inner h1 {
    font-size: 2rem;
    line-height: 1.2;
    margin: 0 0 14px;
  }

  .ty-lead {
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .ty-call {
    display: inline-block;
    margin-top: 24px;
    padding: 14px 26px;
    border-radius: 6px;
    background: var(--brand);
    color: #fff;
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration: none;
  }

  .ty-call:hover {
    background: var(--brand-dark);
  }

  .ty-rush-box {
    margin: 26px 0 0;
    padding: 20px;
    border-radius: 6px;
    background: #f4f8f4;
    line-height: 1.6;
  }

  .ty-rush-box a {
    color: var(--brand);
    font-weight: 700;
  }

  .ty-home {
    margin: 22px 0 0;
    font-size: 0.9375rem;
  }

  .ty-home a {
    color: var(--brand);
    font-weight: 600;
  }
</style>
